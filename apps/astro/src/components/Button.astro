---
import { cn, variant as createVariant } from '@/styles'
import type { VariantProps } from '@hulla/style'
import type { HTMLAttributes } from 'astro/types'

const css = createVariant({
  name: 'variant',
  base: 'bg-red-500',
  classes: {
    primary: 'bg-blue-500',
    secondary: 'bg-green-500',
  },
  default: 'primary',
})

type Props = HTMLAttributes<'button'> & VariantProps<typeof css>
const { class: className, variant, ...props } = Astro.props as Props
---

<button {...props} class={cn(css.css(variant), className)}>
  <slot />
</button>
