---
import Badge from "@/ui/badge/badge.astro"
import CardTitle from "@/ui/card/card-title.astro"
import Card from "@/ui/card/card.astro"
import Avatar from "@/ui/avatar/avatar.astro"
import AvatarFallback from "@/ui/avatar/avatar-fallback.astro"
import AvatarImage from "@/ui/avatar/avatar-image.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const avatar = manifest.library.components.avatar
const avatarSizes = ["sm", "md", "lg"] as const
// Exercise the image error state without making a request to the dev server.
const unavailableAvatarSrc = "data:image/svg+xml,%3Csvg"
const teammates = [
  {
    description: "Design systems",
    initials: "SK",
    name: "Sora Kim",
    src: "/avatar-sora.svg",
  },
  {
    description: "Product design",
    initials: "LM",
    name: "Lea Müller",
    src: undefined,
  },
  {
    description: "Engineering",
    initials: "AO",
    name: "Amara Okafor",
    src: undefined,
  },
] as const
---

<ComponentPreview component="Avatar" hint="Non-interactive" requirePropsView={true}>
  <div slot="variants" class="grid gap-5">
    <Card aria-label="Team directory example">
      <div class="flex items-center justify-between border-b border-border px-4 py-3">
        <div>
          <p
            class="font-mono text-[0.6875rem] font-medium tracking-wider text-muted-foreground uppercase"
          >
            Project Atlas
          </p>
          <CardTitle>Core team</CardTitle>
        </div>
        <span class="font-mono text-xs text-muted-foreground">03 / 03</span>
      </div>

      <div>
        {
          teammates.map(({ description, initials, name, src }) => (
            <div class="flex items-center gap-3 border-t border-border px-4 py-3 first:border-t-0">
              <Avatar role="img" aria-label={name}>
                <AvatarFallback>{initials}</AvatarFallback>
                {src && <AvatarImage src={src} alt="" />}
              </Avatar>
              <span class="min-w-0 flex-1">
                <strong class="block truncate text-sm font-medium">{name}</strong>
                <small class="block truncate text-xs text-muted-foreground">{description}</small>
              </span>
              <Badge variant="success" size="sm">
                Available
              </Badge>
            </div>
          ))
        }
      </div>
    </Card>

    <div class="flex items-end justify-between gap-5 px-1">
      <span class="font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase">
        Scale
      </span>
      <div class="flex items-end gap-4">
        {
          avatarSizes.map((size) => (
            <span class="grid justify-items-center gap-2">
              <Avatar role="img" size={size} aria-label={`Sora Kim, ${size} avatar`}>
                <AvatarFallback>SK</AvatarFallback>
                <AvatarImage src="/avatar-sora.svg" alt="" />
              </Avatar>
              <Avatar role="img" size={size} aria-label={`Initials, ${size} avatar`}>
                <AvatarFallback>SK</AvatarFallback>
              </Avatar>
              <span class="font-mono text-[0.6875rem] text-muted-foreground">
                {size} · {size === "sm" ? 24 : size === "md" ? 32 : 40}px
              </span>
            </span>
          ))
        }
      </div>
    </div>

    <div class="flex items-center gap-3 rounded-md border border-dashed border-border p-3">
      <Avatar role="img" aria-label="Fallback example">
        <AvatarFallback>FX</AvatarFallback>
        <AvatarImage src={unavailableAvatarSrc} alt="" />
      </Avatar>
      <div>
        <strong class="block text-sm font-medium">Automatic fallback</strong>
        <small class="block text-xs text-muted-foreground">
          Shown when the image cannot be loaded
        </small>
      </div>
    </div>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control">
        <span class="label">Size</span>
        <select aria-label="Avatar size" data-avatar-prop-size>
          {
            avatarSizes.map((size) => (
              <option value={size} selected={size === "md"}>
                {size}
              </option>
            ))
          }
        </select>
      </label>

      <label class="prop-control">
        <span class="label">Image</span>
        <select aria-label="Avatar image state" data-avatar-prop-source>
          <option value="image">Loaded</option>
          <option value="fallback">Unavailable</option>
        </select>
      </label>

      <label class="prop-control prop-control--wide">
        <span class="label">Fallback</span>
        <input type="text" value="SK" maxlength="3" data-avatar-prop-fallback />
      </label>
    </div>

    <div class="playground-stage">
      {
        (["image", "fallback"] as const).flatMap((source) =>
          avatarSizes.map((size) => (
            <Avatar
              role="img"
              size={size}
              aria-label="Sora Kim"
              data-playground-avatar
              data-source={source}
              data-size={size}
              hidden={source !== "image" || size !== "md"}
            >
              <AvatarFallback data-playground-avatar-fallback>SK</AvatarFallback>
              <AvatarImage
                src={source === "image" ? "/avatar-sora.svg" : unavailableAvatarSrc}
                alt=""
              />
            </Avatar>
          ))
        )
      }
    </div>

    <code class="prop-readout" data-avatar-prop-readout aria-live="polite"
      >&lt;Avatar size="md"&gt;…&lt;/Avatar&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{avatar.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Native elements</dt>
      <dd>span · img · span</dd>
    </div>
    <div class="fact">
      <dt class="label">Custom props</dt>
      <dd>size · native image attributes</dd>
    </div>
  </dl>
</ComponentPreview>
