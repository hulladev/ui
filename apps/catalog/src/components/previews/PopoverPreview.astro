---
import AvatarFallback from "@/ui/avatar/avatar-fallback.astro"
import Avatar from "@/ui/avatar/avatar.astro"
import Button from "@/ui/button/button.astro"
import Kbd from "@/ui/kbd/kbd.astro"
import Popover from "@/ui/popover/popover.astro"
import Separator from "@/ui/separator/separator.astro"
import { ChevronDown } from "@lucide/astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const popover = manifest.library.components.popover
const popoverPlacements = [
  "top-start",
  "top",
  "top-end",
  "right-start",
  "right",
  "right-end",
  "bottom-start",
  "bottom",
  "bottom-end",
  "left-start",
  "left",
  "left-end",
] as const
---

<ComponentPreview component="Popover" hint="Light-dismiss or press Escape" requirePropsView={true}>
  <div
    slot="variants"
    class="relative grid min-h-72 place-items-center overflow-hidden rounded-lg bg-surface/65 after:pointer-events-none after:absolute after:size-80 after:rounded-full after:bg-primary/10 after:blur-3xl after:content-['']"
  >
    <div class="absolute top-5 left-5 grid max-w-80 gap-1">
      <span class="font-mono text-xs font-medium tracking-wider uppercase"
        >Platform-managed overlay</span
      >
      <strong class="tracking-tight">No portal. No position loop.</strong>
      <p class="m-0 text-xs leading-6 text-muted-foreground">
        The browser owns the top layer, focus relationship, dismissal, and collision fallback.
      </p>
    </div>

    <div class="relative z-1">
      <span
        class="pointer-events-none absolute -inset-10 animate-[spin_18s_linear_infinite] rounded-full border border-dashed border-primary/35 motion-reduce:animate-none before:absolute before:top-[-0.25rem] before:left-1/2 before:size-2 before:rounded-full before:bg-primary before:shadow-[0_0_1rem_color-mix(in_oklab,var(--color-primary)_55%,transparent)] before:content-['']"
        aria-hidden="true"></span>
      <Button
        variant="outline"
        popovertarget="catalog-account-popover"
        aria-label="Open account actions"
      >
        <Avatar class="size-6" aria-hidden="true">
          <AvatarFallback class="bg-primary/15 text-[0.58rem] text-primary">SH</AvatarFallback>
        </Avatar>
        Account
        <ChevronDown aria-hidden="true" class="size-3.5 shrink-0" />
      </Button>
    </div>

    <Popover
      id="catalog-account-popover"
      placement="bottom-end"
      aria-label="Account actions"
      class="w-68 p-1.5"
    >
      <div class="flex items-center gap-2.5 p-2.5">
        <Avatar aria-hidden="true">
          <AvatarFallback class="bg-primary/15 text-primary">SH</AvatarFallback>
        </Avatar>
        <span class="grid min-w-0">
          <strong class="text-sm">Samuel Hulla</strong>
          <small class="overflow-hidden text-xs text-ellipsis text-muted-foreground">
            samuel@hulla.dev
          </small>
        </span>
      </div>
      <Separator class="my-1" />
      <a
        class="flex w-full items-center justify-between rounded-sm px-2.5 py-2 text-left text-xs no-underline hover:bg-foreground/5"
        href="#popover"
      >
        View profile <Kbd class="border-0 bg-transparent px-0 shadow-none">⌘P</Kbd>
      </a>
      <a
        class="flex w-full items-center justify-between rounded-sm px-2.5 py-2 text-left text-xs no-underline hover:bg-foreground/5"
        href="#popover"
      >
        Workspace settings
        <Kbd class="border-0 bg-transparent px-0 shadow-none">⌘,</Kbd>
      </a>
      <Button
        variant="outline"
        size="sm"
        class="flex w-full items-center justify-between rounded-sm border-0 bg-transparent px-2.5 py-2 text-left text-xs text-foreground hover:bg-foreground/5"
        popovertarget="catalog-account-popover"
        popovertargetaction="hide"
      >
        Sign out
      </Button>
    </Popover>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control prop-control--wide">
        <span class="label">Placement</span>
        <select aria-label="Popover placement" data-popover-prop-placement>
          {
            popoverPlacements.map((placement) => (
              <option value={placement} selected={placement === "bottom"}>
                {placement}
              </option>
            ))
          }
        </select>
      </label>
    </div>

    <div class="playground-stage playground-stage--overlay">
      {
        popoverPlacements.map((placement) => {
          const id = `catalog-props-popover-${placement}`
          return (
            <div
              class="overlay-prop-case"
              data-popover-prop-case
              data-placement={placement}
              hidden={placement !== "bottom"}
            >
              <Button variant="outline" popovertarget={id}>
                Open {placement}
              </Button>
              <Popover id={id} placement={placement} class="w-68 p-1.5">
                <div class="flex items-center gap-2.5 p-2.5">
                  <Avatar aria-hidden="true">
                    <AvatarFallback class="bg-primary/15 text-primary">SH</AvatarFallback>
                  </Avatar>
                  <span class="grid min-w-0">
                    <strong class="text-sm">Anchored surface</strong>
                    <small class="text-xs text-muted-foreground">{placement}</small>
                  </span>
                </div>
                <Button
                  variant="outline"
                  size="sm"
                  class="flex w-full items-center justify-between rounded-sm border-0 bg-transparent px-2.5 py-2 text-left text-xs text-foreground hover:bg-foreground/5"
                  popovertarget={id}
                  popovertargetaction="hide"
                >
                  Close popover
                </Button>
              </Popover>
            </div>
          )
        })
      }
    </div>

    <code class="prop-readout" data-popover-prop-readout aria-live="polite"
      >&lt;Popover placement="bottom" /&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{popover.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Positioning</dt>
      <dd>12 logical placements + collision flips</dd>
    </div>
    <div class="fact">
      <dt class="label">Dismissal</dt>
      <dd>Outside press · Escape · invoker toggle</dd>
    </div>
    <div class="fact">
      <dt class="label">Runtime</dt>
      <dd>Zero component JavaScript</dd>
    </div>
  </dl>
</ComponentPreview>
