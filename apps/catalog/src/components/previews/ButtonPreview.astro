---
import Switch from "@/ui/switch/switch.astro"
import Button from "@/ui/button/button.astro"
import ButtonGroup from "@/ui/button/button-group.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const button = manifest.library.components.button
const buttonSizes = ["sm", "md", "lg"] as const
const buttonVariants = ["primary", "secondary", "outline", "ghost", "inverted", "danger"] as const
---

<ComponentPreview component="Button" hint="Depth · focus · press" requirePropsView={true}>
  <div slot="variants" class="grid gap-5">
    {
      buttonVariants.map((variant) => (
        <div class="grid grid-cols-[4.25rem_repeat(3,minmax(0,auto))] items-center justify-center gap-3 max-[760px]:grid-cols-3 max-[760px]:gap-2">
          <span class="font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase max-[760px]:col-span-full">
            {variant}
          </span>
          {buttonSizes.map((size) => (
            <span class="inline-flex flex-col items-start gap-2">
              <Button size={size} variant={variant}>
                {size === "sm" ? "Small" : size === "md" ? "Medium" : "Large"}
              </Button>
              <span class="font-mono text-[0.625rem] text-muted-foreground">
                {size === "sm" ? 28 : size === "md" ? 32 : 36}px
              </span>
            </span>
          ))}
        </div>
      ))
    }
    <div
      class="grid grid-cols-[4.25rem_minmax(0,auto)] items-center justify-center gap-3 border-t border-border pt-5 max-[760px]:grid-cols-1 max-[760px]:gap-2"
    >
      <span class="font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase"
        >Disabled</span
      >
      <div class="flex flex-wrap gap-3">
        {
          buttonVariants.map((variant) => (
            <Button variant={variant} disabled>
              {variant.charAt(0).toUpperCase() + variant.slice(1)}
            </Button>
          ))
        }
      </div>
    </div>
    <div
      class="grid grid-cols-[4.25rem_minmax(0,auto)] items-center justify-center gap-3 border-t border-border pt-5 max-[760px]:grid-cols-1 max-[760px]:gap-2"
    >
      <span class="font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase"
        >Group</span
      >
      <ButtonGroup aria-label="Document actions">
        <Button variant="outline">Cancel</Button>
        <Button variant="inverted">Preview</Button>
        <Button variant="danger">Delete</Button>
      </ButtonGroup>
    </div>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control">
        <span class="label">Variant</span>
        <select aria-label="Button variant" data-button-prop-variant>
          {
            buttonVariants.map((variant) => (
              <option value={variant}>{variant.charAt(0).toUpperCase() + variant.slice(1)}</option>
            ))
          }
        </select>
      </label>

      <label class="prop-control">
        <span class="label">Size</span>
        <select aria-label="Button size" data-button-prop-size>
          <option value="sm">Small</option>
          <option value="md" selected>Medium</option>
          <option value="lg">Large</option>
        </select>
      </label>

      <label class="prop-disabled">
        <Switch variant="subtle" data-button-prop-disabled />
        <span class="label">Disabled</span>
      </label>
    </div>

    <div class="playground-stage">
      {
        buttonVariants.map((variant) =>
          buttonSizes.map((size) => (
            <Button
              variant={variant}
              size={size}
              data-playground-button
              data-variant={variant}
              data-size={size}
              hidden={variant !== "primary" || size !== "md"}
            >
              Preview action
            </Button>
          ))
        )
      }
    </div>

    <code class="prop-readout" data-prop-readout aria-live="polite"
      >&lt;Button variant="primary" size="md" /&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{button.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Source mode</dt>
      <dd>CLI-owned code</dd>
    </div>
    <div class="fact">
      <dt class="label">Build contract</dt>
      <dd>Atomic + verified</dd>
    </div>
  </dl>
</ComponentPreview>
