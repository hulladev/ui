---
import FieldContent from "@/ui/field/field-content.astro"
import FieldHeader from "@/ui/field/field-header.astro"
import Card from "@/ui/card/card.astro"
import FieldDescription from "@/ui/field/field-description.astro"
import FieldLabel from "@/ui/field/field-label.astro"
import Field from "@/ui/field/field.astro"
import Switch from "@/ui/switch/switch.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const switchComponent = manifest.library.components.switch
const preferences = [
  {
    checked: true,
    description: "Receive a compact summary every Monday morning.",
    id: "weekly-digest",
    label: "Weekly digest",
  },
  {
    checked: false,
    description: "Surface desktop alerts when a teammate mentions you.",
    id: "desktop-alerts",
    label: "Desktop alerts",
  },
] as const
---

<ComponentPreview component="Switch" hint="Click or press Space" requirePropsView={true}>
  <div slot="variants" class="grid min-w-0 gap-4">
    <div class="flex flex-wrap items-center gap-5" aria-label="Switch variants">
      {
        (
          [
            { id: "variant-default", label: "Default", variant: "default" },
            { id: "variant-subtle", label: "Subtle", variant: "subtle" },
            {
              id: "variant-subtle-checked",
              label: "Subtle checked",
              variant: "subtle",
              checked: true,
            },
            {
              id: "variant-subtle-disabled",
              label: "Subtle disabled",
              variant: "subtle",
              disabled: true,
            },
            {
              id: "variant-subtle-disabled-checked",
              label: "Subtle checked · disabled",
              variant: "subtle",
              checked: true,
              disabled: true,
            },
            {
              id: "variant-subtle-invalid",
              label: "Subtle invalid",
              variant: "subtle",
              "aria-invalid": true,
            },
          ] as const
        ).map(({ label, ...props }) => (
          <div class="flex min-w-0 max-w-full items-center gap-2">
            <Switch {...props} />
            <FieldLabel for={props.id}>{label}</FieldLabel>
          </div>
        ))
      }
    </div>
    <Card aria-label="Notification preferences">
      {
        preferences.map(({ checked, description, id, label }) => (
          <Field>
            <FieldHeader>
              <FieldContent>
                <FieldLabel for={id}>{label}</FieldLabel>
                <FieldDescription id={`${id}-description`}>{description}</FieldDescription>
              </FieldContent>
              <Switch id={id} name={id} aria-describedby={`${id}-description`} checked={checked} />
            </FieldHeader>
          </Field>
        ))
      }
    </Card>

    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,14rem),1fr))] gap-3 border-t border-border pt-5"
      aria-label="Switch states"
    >
      <Field
        ><FieldHeader>
          <FieldLabel for="switch-unchecked">Unchecked</FieldLabel>
          <Switch id="switch-unchecked" />
        </FieldHeader></Field
      >
      <Field
        ><FieldHeader>
          <FieldLabel for="switch-checked">Checked</FieldLabel>
          <Switch id="switch-checked" checked />
        </FieldHeader></Field
      >
      <Field
        ><FieldHeader>
          <FieldLabel for="switch-disabled">Disabled</FieldLabel>
          <Switch id="switch-disabled" disabled />
        </FieldHeader></Field
      >
      <Field>
        <FieldHeader>
          <FieldLabel for="switch-disabled-checked">Checked · disabled</FieldLabel>
          <Switch id="switch-disabled-checked" checked disabled />
        </FieldHeader>
      </Field>
      <Field
        ><FieldHeader>
          <FieldLabel for="switch-invalid">Invalid</FieldLabel>
          <Switch id="switch-invalid" aria-invalid="true" />
        </FieldHeader></Field
      >
    </div>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control">
        <span class="label">Checked</span>
        <select aria-label="Switch checked state" data-switch-checked>
          <option value="true" selected>On</option>
          <option value="false">Off</option>
        </select>
      </label>

      <label class="prop-control">
        <span class="label">Availability</span>
        <select aria-label="Switch availability" data-switch-disabled>
          <option value="false" selected>Enabled</option>
          <option value="true">Disabled</option>
        </select>
      </label>
    </div>

    <div class="playground-stage">
      <Field class="w-full max-w-sm"
        ><FieldHeader>
          <div>
            <FieldLabel for="playground-switch">Sync activity</FieldLabel>
            <FieldDescription id="playground-switch-help">
              Keep this workspace current across devices.
            </FieldDescription>
          </div>
          <Switch
            id="playground-switch"
            aria-describedby="playground-switch-help"
            checked
            data-playground-switch
          />
        </FieldHeader></Field
      >
    </div>

    <code class="prop-readout" data-switch-readout aria-live="polite"
      >&lt;Switch defaultChecked aria-label="Sync activity" /&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{switchComponent.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Native element</dt>
      <dd>input[type=checkbox] · role=switch</dd>
    </div>
    <div class="fact">
      <dt class="label">Custom props</dt>
      <dd>variant: default · subtle</dd>
    </div>
  </dl>
</ComponentPreview>
