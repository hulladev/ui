---
import { Check, Copy, FileCode, Info } from "@lucide/astro"
import { tsx } from "@tanstack/highlight/languages/tsx"
import Button from "@/ui/button/button.astro"
import Code from "@/ui/code/code.astro"
import CodeBlock from "@/ui/code/code-block.astro"
import CodeBlockActions from "@/ui/code/code-block-actions.astro"
import CodeBlockBody from "@/ui/code/code-block-body.astro"
import CodeBlockContent from "@/ui/code/code-block-content.astro"
import CodeBlockDescription from "@/ui/code/code-block-description.astro"
import CodeBlockFooter from "@/ui/code/code-block-footer.astro"
import CodeBlockHeader from "@/ui/code/code-block-header.astro"
import CodeBlockPath from "@/ui/code/code-block-path.astro"
import CodeBlockTitle from "@/ui/code/code-block-title.astro"
import { createShikiCodeHighlighter } from "@/ui/code-highlighter-shiki/code-highlighter-shiki"
import { createTanStackCodeHighlighter } from "@/ui/code-highlighter-tanstack/code-highlighter-tanstack"
import TabsContent from "@/ui/tabs/tabs-content.astro"
import TabsList from "@/ui/tabs/tabs-list.astro"
import TabsTrigger from "@/ui/tabs/tabs-trigger.astro"
import Tabs from "@/ui/tabs/tabs.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const astroSource = `---
import Button from "@/ui/button/button.astro"

const release = "v1.4"
---

<Button variant="primary">
  Ship {release}
</Button>`

const reactSource = `import { Button } from "@/ui/button"

export function ReleaseButton() {
  const release = "v1.4"

  return (
    <Button variant="primary">
      Ship {release}
    </Button>
  )
}`

const shellSource = `bunx hulla ui add code code-highlighter-shiki
bunx hulla ui add tabs button`

const shiki = await createShikiCodeHighlighter({ languages: ["astro"] })
const tanstack = createTanStackCodeHighlighter({
  fallbackLanguage: "tsx",
  languages: [tsx],
})

const highlightedAstro = shiki.highlight(astroSource, { language: "astro" })
const highlightedReact = tanstack.highlight(reactSource, { language: "tsx" })
const highlightedShell = {
  code: shellSource,
  language: "shell",
  lines: shellSource.split("\n").map((line) => ({ tokens: [{ content: line }] })),
}
const codeComponent = manifest.library.components.code
---

<ComponentPreview component="Code" hint="Scrollable · selectable" requirePropsView={true}>
  <div slot="variants" class="grid gap-6">
    <p class="m-0 text-sm leading-7 text-muted-foreground">
      Install the primitives with <Code>bunx hulla ui add code</Code>, then choose either
      highlighting adapter—or both.
    </p>

    <Tabs defaultValue="astro" class="gap-0" data-code-tabs>
      <CodeBlock>
        <CodeBlockHeader>
          <TabsList aria-label="Implementation file">
            <TabsTrigger value="astro">
              <FileCode aria-hidden="true" class="size-3.5" />
              release-button.astro
            </TabsTrigger>
            <TabsTrigger value="react">
              <FileCode aria-hidden="true" class="size-3.5" />
              release-button.tsx
            </TabsTrigger>
          </TabsList>
        </CodeBlockHeader>

        <CodeBlockPath>
          <span class="min-w-0 truncate" data-code-path>src/components/release-button.astro</span>
          <span class="ml-auto shrink-0 text-foreground/60">hulla/ui</span>
        </CodeBlockPath>

        <CodeBlockBody>
          <TabsContent value="astro" class="rounded-none focus-visible:outline-offset-[-2px]">
            <CodeBlockContent
              highlighted={highlightedAstro}
              lineNumbers
              highlightedLines={[4]}
              insertedLines={[8, 9, 10]}
            />
          </TabsContent>
          <TabsContent value="react" class="rounded-none focus-visible:outline-offset-[-2px]">
            <CodeBlockContent
              highlighted={highlightedReact}
              lineNumbers
              focusedLines={[4, 5, 6, 7, 8, 9, 10]}
            />
          </TabsContent>

          <CodeBlockActions>
            <Button
              variant="outline"
              size="sm"
              class="size-8 rounded-none border-0 bg-transparent p-0 text-muted-foreground shadow-none hover:bg-transparent hover:text-foreground active:bg-transparent"
              aria-label="Copy active code"
              title="Copy active code"
              data-copy-code
            >
              <Copy aria-hidden="true" class="size-4" data-copy-icon />
              <span data-copied-icon hidden><Check aria-hidden="true" class="size-4" /></span>
            </Button>
          </CodeBlockActions>
        </CodeBlockBody>

        <CodeBlockFooter>
          <span class="inline-flex items-center gap-1.5">
            <Info aria-hidden="true" class="size-3.5" />
            Astro uses Shiki · React uses TanStack Highlight
          </span>
          <span class="ml-auto font-mono text-[0.6875rem]">UTF-8 · LF</span>
        </CodeBlockFooter>
      </CodeBlock>
    </Tabs>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls prop-controls--toggles">
      <label class="prop-disabled">
        <input type="checkbox" checked data-code-line-numbers />
        <span>Line numbers</span>
      </label>
      <label class="prop-disabled">
        <input type="checkbox" data-code-wrap />
        <span>Wrap long lines</span>
      </label>
    </div>

    <div class="playground-stage playground-stage--wide">
      <CodeBlock class="w-full">
        <CodeBlockHeader>
          <div class="min-w-0">
            <CodeBlockTitle>install.sh</CodeBlockTitle>
            <CodeBlockDescription
              >Choose only the integrations this project needs.</CodeBlockDescription
            >
          </div>
        </CodeBlockHeader>
        <CodeBlockPath>
          <span class="min-w-0 truncate">scripts/install.sh</span>
          <span class="ml-auto shrink-0">Shell</span>
        </CodeBlockPath>
        <CodeBlockBody>
          <CodeBlockContent
            highlighted={highlightedShell}
            lineNumbers
            highlightedLines={[1]}
            data-code-playground
          />
        </CodeBlockBody>
        <CodeBlockFooter>
          <span>2 commands</span>
          <span class="ml-auto">Shell</span>
        </CodeBlockFooter>
      </CodeBlock>
    </div>

    <code class="prop-readout" data-code-prop-readout aria-live="polite"
      >&lt;CodeBlockContent lineNumbers /&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{codeComponent.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Highlighting</dt>
      <dd>plain · Shiki · TanStack</dd>
    </div>
    <div class="fact">
      <dt class="label">Composition</dt>
      <dd>header · tabs · path · body · actions · footer</dd>
    </div>
  </dl>
</ComponentPreview>

<script>
  document.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-copy-code]")
    const tabs = button?.closest<HTMLElement>("[data-code-tabs]")
    if (!button || !tabs) return

    const panel = tabs.querySelector<HTMLElement>('[data-slot="tabs-content"]:not([hidden])')
    const code = panel?.querySelector<HTMLElement>('[data-slot="code-block-code"]')?.textContent
    if (!code) return

    await navigator.clipboard.writeText(code)
    const copyIcon = button.querySelector<HTMLElement>("[data-copy-icon]")
    const copiedIcon = button.querySelector<HTMLElement>("[data-copied-icon]")
    if (copyIcon) copyIcon.hidden = true
    if (copiedIcon) copiedIcon.hidden = false
    window.setTimeout(() => {
      if (copyIcon) copyIcon.hidden = false
      if (copiedIcon) copiedIcon.hidden = true
    }, 1400)
  })

  const syncCodePlayground = (preview: HTMLElement) => {
    const lineNumbers =
      preview.querySelector<HTMLInputElement>("[data-code-line-numbers]")?.checked ?? true
    const wrap = preview.querySelector<HTMLInputElement>("[data-code-wrap]")?.checked ?? false
    const content = preview.querySelector<HTMLElement>("[data-code-playground]")
    if (!content) return

    content.toggleAttribute("data-line-numbers", lineNumbers)
    content.toggleAttribute("data-wrap", wrap)
    content.classList.toggle("whitespace-pre", !wrap)
    content.classList.toggle("whitespace-pre-wrap", wrap)
    content.classList.toggle("break-words", wrap)

    const readout = preview.querySelector<HTMLElement>("[data-code-prop-readout]")
    if (readout) {
      readout.textContent = `<CodeBlockContent${lineNumbers ? " lineNumbers" : ""}${wrap ? " wrap" : ""} />`
    }
  }

  document.addEventListener("input", (event) => {
    const control = (event.target as HTMLElement).closest(
      "[data-code-line-numbers], [data-code-wrap]"
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="code-preview"]')
    if (preview) syncCodePlayground(preview)
  })

  document.addEventListener("hulla-tabs-value-change", (event) => {
    const tabs = event.target as HTMLElement
    if (!tabs.matches("[data-code-tabs]")) return

    const value = (event as CustomEvent<{ value: string }>).detail.value
    const path = tabs.querySelector<HTMLElement>("[data-code-path]")
    if (path)
      path.textContent = `src/components/release-button.${value === "react" ? "tsx" : "astro"}`
  })
</script>
