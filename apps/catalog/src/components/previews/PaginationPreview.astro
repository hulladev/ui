---
import PaginationItem from "@/ui/pagination/pagination-item.astro"
import Pagination from "@/ui/pagination/pagination.astro"
import { ChevronLeft, ChevronRight } from "@lucide/astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const pagination = manifest.library.components.pagination
---

<ComponentPreview
  component="Pagination"
  hint="Tab through pages"
  propsLabel="Native state"
  requirePropsView={true}
  variantsLabel="Contexts"
>
  <div slot="variants" class="grid gap-8">
    <section
      class="relative grid gap-7 overflow-hidden rounded-lg border border-border bg-surface-raised p-5 shadow-xs before:absolute before:top-0 before:left-5 before:h-0.5 before:w-14 before:bg-primary before:content-['']"
    >
      <div class="flex items-start justify-between gap-5">
        <div class="grid gap-1">
          <span class="font-mono text-[0.65rem] tracking-widest text-primary uppercase">
            Audit log
          </span>
          <h3 class="text-xl font-semibold tracking-[-0.03em]">184 events</h3>
        </div>
        <span class="font-mono text-xs text-muted-foreground">Page 7 / 24</span>
      </div>

      <Pagination aria-label="Audit log pages">
        <PaginationItem>
          <a href="#pagination" aria-label="Previous page">
            <ChevronLeft size={16} aria-hidden="true" focusable="false" />
            <span class="max-[580px]:sr-only">Previous</span>
          </a>
        </PaginationItem>
        <PaginationItem><a href="#pagination" aria-label="Page 1">1</a></PaginationItem>
        <PaginationItem class="max-[480px]:hidden">
          <span>
            <span aria-hidden="true">···</span>
            <span class="sr-only">More pages</span>
          </span>
        </PaginationItem>
        <PaginationItem class="max-[480px]:hidden">
          <a href="#pagination" aria-label="Page 6">6</a>
        </PaginationItem>
        <PaginationItem>
          <a href="#pagination" aria-label="Page 7" aria-current="page">7</a>
        </PaginationItem>
        <PaginationItem class="max-[480px]:hidden">
          <a href="#pagination" aria-label="Page 8">8</a>
        </PaginationItem>
        <PaginationItem class="max-[480px]:hidden">
          <span>
            <span aria-hidden="true">···</span>
            <span class="sr-only">More pages</span>
          </span>
        </PaginationItem>
        <PaginationItem><a href="#pagination" aria-label="Page 24">24</a></PaginationItem>
        <PaginationItem>
          <a href="#pagination" aria-label="Next page">
            <span class="max-[580px]:sr-only">Next</span>
            <ChevronRight size={16} aria-hidden="true" focusable="false" />
          </a>
        </PaginationItem>
      </Pagination>
    </section>

    <section class="grid gap-3">
      <div class="flex items-baseline justify-between gap-5">
        <span class="font-mono text-xs text-muted-foreground">Button-driven data view</span>
        <span class="text-xs text-muted-foreground">5 pages</span>
      </div>
      <Pagination aria-label="Result pages">
        <PaginationItem><button type="button" aria-label="Page 1">1</button></PaginationItem>
        <PaginationItem>
          <button type="button" aria-label="Page 2" aria-current="page">2</button>
        </PaginationItem>
        <PaginationItem><button type="button" aria-label="Page 3">3</button></PaginationItem>
        <PaginationItem><button type="button" aria-label="Page 4">4</button></PaginationItem>
        <PaginationItem><button type="button" aria-label="Page 5">5</button></PaginationItem>
        <PaginationItem>
          <button type="button" aria-label="Next page" disabled>
            <ChevronRight size={16} aria-hidden="true" focusable="false" />
          </button>
        </PaginationItem>
      </Pagination>
    </section>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control prop-control--wide">
        <span class="label">Current page</span>
        <select aria-label="Current pagination page" data-pagination-current>
          <option value="1">Page 1</option>
          <option value="2">Page 2</option>
          <option value="3" selected>Page 3</option>
          <option value="4">Page 4</option>
          <option value="5">Page 5</option>
        </select>
      </label>
    </div>

    <div class="playground-stage">
      <Pagination aria-label="Playground pages" data-playground-pagination>
        <PaginationItem>
          <a href="#pagination" aria-label="Page 1" data-playground-page="1">1</a>
        </PaginationItem>
        <PaginationItem>
          <a href="#pagination" aria-label="Page 2" data-playground-page="2">2</a>
        </PaginationItem>
        <PaginationItem>
          <a href="#pagination" aria-label="Page 3" aria-current="page" data-playground-page="3"
            >3</a
          >
        </PaginationItem>
        <PaginationItem>
          <a href="#pagination" aria-label="Page 4" data-playground-page="4">4</a>
        </PaginationItem>
        <PaginationItem>
          <a href="#pagination" aria-label="Page 5" data-playground-page="5">5</a>
        </PaginationItem>
      </Pagination>
    </div>

    <code class="prop-readout" data-pagination-readout aria-live="polite"
      >&lt;a aria-current="page"&gt;3&lt;/a&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{pagination.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Public parts</dt>
      <dd>Pagination · PaginationItem</dd>
    </div>
    <div class="fact">
      <dt class="label">State contract</dt>
      <dd>aria-current · disabled</dd>
    </div>
  </dl>
</ComponentPreview>
