---
import { FileCode2, FileText, Folder, FolderOpen, Layers, Palette } from "@lucide/astro"
import TreeGroup from "@/ui/tree-view/tree-group.astro"
import TreeItemLabel from "@/ui/tree-view/tree-item-label.astro"
import TreeItem from "@/ui/tree-view/tree-item.astro"
import TreeView from "@/ui/tree-view/tree-view.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const treeView = manifest.library.components["tree-view"]
---

<ComponentPreview
  component="TreeView"
  hint="Arrow keys · selection · disclosure"
  propsLabel="Selection model"
  requirePropsView={true}
>
  <div slot="variants" class="@container grid gap-4">
    <section
      class="grid grid-cols-1 overflow-hidden rounded-lg border border-border bg-surface-raised shadow-xs @min-[36rem]:grid-cols-[minmax(0,1fr)_minmax(13rem,0.65fr)]"
    >
      <div class="border-b border-border p-4 @min-[36rem]:border-r @min-[36rem]:border-b-0">
        <div class="mb-3 flex items-baseline justify-between gap-4 px-2">
          <div>
            <span class="font-mono text-[0.6875rem] tracking-wider text-primary uppercase"
              >Repository</span
            >
            <h3 class="m-0 mt-1 text-sm font-semibold">hulla/ui</h3>
          </div>
          <span class="font-mono text-[0.6875rem] text-muted-foreground">main</span>
        </div>

        <TreeView
          aria-label="Repository files"
          defaultValue="button.tsx"
          class="[&_[aria-expanded=true]>[data-slot=tree-item-label]>.tree-folder-closed]:hidden [&_[aria-expanded=false]>[data-slot=tree-item-label]>.tree-folder-open]:hidden"
        >
          <TreeItem value="apps" defaultExpanded>
            <TreeItemLabel
              ><Folder class="tree-folder-closed" aria-hidden="true" focusable="false" /><FolderOpen
                class="tree-folder-open"
                aria-hidden="true"
                focusable="false"
              /> apps</TreeItemLabel
            >
            <TreeGroup>
              <TreeItem value="catalog" defaultExpanded>
                <TreeItemLabel
                  ><Folder
                    class="tree-folder-closed"
                    aria-hidden="true"
                    focusable="false"
                  /><FolderOpen class="tree-folder-open" aria-hidden="true" focusable="false" /> catalog</TreeItemLabel
                >
                <TreeGroup>
                  <TreeItem value="index.astro">
                    <TreeItemLabel
                      ><FileCode2 aria-hidden="true" focusable="false" /> index.astro</TreeItemLabel
                    >
                  </TreeItem>
                </TreeGroup>
              </TreeItem>
            </TreeGroup>
          </TreeItem>
          <TreeItem value="packages" defaultExpanded>
            <TreeItemLabel
              ><Folder class="tree-folder-closed" aria-hidden="true" focusable="false" /><FolderOpen
                class="tree-folder-open"
                aria-hidden="true"
                focusable="false"
              /> packages</TreeItemLabel
            >
            <TreeGroup>
              <TreeItem value="components" defaultExpanded>
                <TreeItemLabel
                  ><Folder
                    class="tree-folder-closed"
                    aria-hidden="true"
                    focusable="false"
                  /><FolderOpen class="tree-folder-open" aria-hidden="true" focusable="false" /> components</TreeItemLabel
                >
                <TreeGroup>
                  <TreeItem value="button.tsx">
                    <TreeItemLabel>
                      <FileCode2 aria-hidden="true" focusable="false" /> button.tsx
                    </TreeItemLabel>
                  </TreeItem>
                  <TreeItem value="toggle.tsx">
                    <TreeItemLabel
                      ><FileCode2 aria-hidden="true" focusable="false" /> toggle.tsx</TreeItemLabel
                    >
                  </TreeItem>
                  <TreeItem value="tree-view.tsx" aria-disabled="true">
                    <TreeItemLabel
                      ><FileCode2 aria-hidden="true" focusable="false" /> tree-view.tsx</TreeItemLabel
                    >
                  </TreeItem>
                </TreeGroup>
              </TreeItem>
            </TreeGroup>
          </TreeItem>
          <TreeItem value="readme">
            <TreeItemLabel
              ><FileText aria-hidden="true" focusable="false" /> README.md</TreeItemLabel
            >
          </TreeItem>
        </TreeView>
      </div>

      <aside class="grid content-start gap-4 bg-foreground/[0.025] p-5" aria-label="Selected file">
        <div class="grid gap-1">
          <span class="font-mono text-[0.6875rem] tracking-wider text-muted-foreground uppercase"
            >Selected</span
          >
          <strong class="text-sm" data-tree-selection>button.tsx</strong>
        </div>
        <div class="grid gap-2 font-mono text-[0.6875rem] text-muted-foreground">
          <span>12.4 KB</span>
          <span>TypeScript React</span>
          <span>Modified 4m ago</span>
        </div>
      </aside>
    </section>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control">
        <span class="label">Selection</span>
        <select aria-label="Tree selection mode" data-tree-selection-mode>
          <option value="single" selected>Single</option>
          <option value="none">None</option>
        </select>
      </label>
    </div>

    <div class="playground-stage">
      <TreeView
        class="w-64 max-w-full"
        aria-label="Workspace tree"
        defaultValue="design"
        data-playground-tree
      >
        <TreeItem value="workspace" defaultExpanded>
          <TreeItemLabel><Folder aria-hidden="true" focusable="false" />Workspace</TreeItemLabel>
          <TreeGroup>
            <TreeItem value="design"
              ><TreeItemLabel><Palette aria-hidden="true" focusable="false" />Design</TreeItemLabel
              ></TreeItem
            >
            <TreeItem value="engineering"
              ><TreeItemLabel
                ><Layers aria-hidden="true" focusable="false" />Engineering</TreeItemLabel
              ></TreeItem
            >
          </TreeGroup>
        </TreeItem>
      </TreeView>
    </div>

    <code class="prop-readout" data-tree-readout aria-live="polite"
      >&lt;TreeView selectionMode="single" defaultValue="design"&gt;…&lt;/TreeView&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{treeView.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Native structure</dt>
      <dd>ul · li · nested lists</dd>
    </div>
    <div class="fact">
      <dt class="label">Keyboard model</dt>
      <dd>TreeView · APG tree keys</dd>
    </div>
  </dl>
</ComponentPreview>
