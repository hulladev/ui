---
import Badge from "@/ui/badge/badge.astro"
import TableBody from "@/ui/table/table-body.astro"
import TableCaption from "@/ui/table/table-caption.astro"
import TableCell from "@/ui/table/table-cell.astro"
import TableFooter from "@/ui/table/table-footer.astro"
import TableHead from "@/ui/table/table-head.astro"
import TableHeader from "@/ui/table/table-header.astro"
import TableRow from "@/ui/table/table-row.astro"
import Table from "@/ui/table/table.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const table = manifest.library.components.table
const tableVariants = ["plain", "divided", "striped"] as const

const releases = [
  { duration: "4m 12s", owner: "Mira Chen", release: "v2.8.0", status: "Ready" },
  { duration: "6m 48s", owner: "Owen Brooks", release: "v2.7.4", status: "Running" },
  { duration: "3m 51s", owner: "Nadia Park", release: "v2.7.3", status: "Blocked" },
] as const

const regions = [
  { change: "+8.4%", latency: "38 ms", region: "Europe", requests: "4.8m" },
  { change: "+3.1%", latency: "64 ms", region: "North America", requests: "3.2m" },
  { change: "+11.7%", latency: "81 ms", region: "Asia Pacific", requests: "2.6m" },
  { change: "−1.2%", latency: "72 ms", region: "South America", requests: "840k" },
] as const
---

<ComponentPreview
  component="Table"
  hint="Clear headers · row rhythm"
  requirePropsView={true}
  variantsLabel="Representations"
>
  <div slot="variants" class="grid gap-7">
    <section class="grid gap-2.5" aria-labelledby="table-divided-label">
      <div class="flex items-end justify-between gap-4 px-1">
        <div>
          <p class="font-mono text-[0.65rem] tracking-widest text-primary uppercase">
            Divided / Operations
          </p>
          <h3 id="table-divided-label" class="mt-1 text-base font-semibold">Release pipeline</h3>
        </div>
        <span class="text-xs text-muted-foreground">3 active</span>
      </div>
      <div class="overflow-x-auto rounded-md border border-border bg-surface">
        <Table variant="divided" class="min-w-[30rem]">
          <TableCaption>Active releases ordered by most recent deployment.</TableCaption>
          <TableHeader>
            <TableRow>
              <TableHead>Release</TableHead>
              <TableHead>Status</TableHead>
              <TableHead>Owner</TableHead>
              <TableHead class="text-right">Duration</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {
              releases.map((release) => (
                <TableRow>
                  <TableHead scope="row">{release.release}</TableHead>
                  <TableCell>
                    <Badge
                      size="sm"
                      variant={
                        release.status === "Ready"
                          ? "success"
                          : release.status === "Blocked"
                            ? "danger"
                            : "primary"
                      }
                    >
                      {release.status}
                    </Badge>
                  </TableCell>
                  <TableCell>{release.owner}</TableCell>
                  <TableCell class="text-right">{release.duration}</TableCell>
                </TableRow>
              ))
            }
          </TableBody>
        </Table>
      </div>
    </section>

    <section class="grid gap-2.5" aria-labelledby="table-striped-label">
      <div class="px-1">
        <p class="font-mono text-[0.65rem] tracking-widest text-primary uppercase">
          Striped / Comparison
        </p>
        <h3 id="table-striped-label" class="mt-1 text-base font-semibold">Regional traffic</h3>
      </div>
      <div class="overflow-x-auto">
        <Table variant="striped" class="min-w-[29rem]">
          <TableHeader>
            <TableRow>
              <TableHead>Region</TableHead>
              <TableHead class="text-right">Requests</TableHead>
              <TableHead class="text-right">Change</TableHead>
              <TableHead class="text-right">p95 latency</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {
              regions.map((region) => (
                <TableRow>
                  <TableHead scope="row">{region.region}</TableHead>
                  <TableCell class="text-right">{region.requests}</TableCell>
                  <TableCell class="text-right">{region.change}</TableCell>
                  <TableCell class="text-right">{region.latency}</TableCell>
                </TableRow>
              ))
            }
          </TableBody>
        </Table>
      </div>
    </section>

    <section class="grid gap-2.5" aria-labelledby="table-plain-label">
      <div class="px-1">
        <p class="font-mono text-[0.65rem] tracking-widest text-primary uppercase">
          Plain / Summary
        </p>
        <h3 id="table-plain-label" class="mt-1 text-base font-semibold">Storage allocation</h3>
      </div>
      <Table variant="plain">
        <TableBody>
          <TableRow>
            <TableHead scope="row">Build artifacts</TableHead>
            <TableCell class="text-right">84.2 GB</TableCell>
            <TableCell class="w-24 text-right">68%</TableCell>
          </TableRow>
          <TableRow>
            <TableHead scope="row">Source maps</TableHead>
            <TableCell class="text-right">31.8 GB</TableCell>
            <TableCell class="w-24 text-right">26%</TableCell>
          </TableRow>
        </TableBody>
        <TableFooter>
          <TableRow>
            <TableHead scope="row">Total used</TableHead>
            <TableCell class="text-right">116 GB</TableCell>
            <TableCell class="text-right">94%</TableCell>
          </TableRow>
        </TableFooter>
      </Table>
    </section>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control">
        <span class="label">Variant</span>
        <select aria-label="Table variant" data-table-prop-variant>
          {
            tableVariants.map((variant) => (
              <option value={variant} selected={variant === "divided"}>
                {variant}
              </option>
            ))
          }
        </select>
      </label>
    </div>

    <div class="playground-stage overflow-x-auto">
      {
        tableVariants.map((variant) => (
          <Table
            variant={variant}
            class="min-w-[28rem]"
            data-playground-table
            data-variant={variant}
            hidden={variant !== "divided"}
          >
            <TableHeader>
              <TableRow>
                <TableHead>Environment</TableHead>
                <TableHead>Status</TableHead>
                <TableHead class="text-right">Latency</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              <TableRow>
                <TableHead scope="row">Production</TableHead>
                <TableCell>Healthy</TableCell>
                <TableCell class="text-right">42 ms</TableCell>
              </TableRow>
              <TableRow>
                <TableHead scope="row">Preview</TableHead>
                <TableCell>Deploying</TableCell>
                <TableCell class="text-right">61 ms</TableCell>
              </TableRow>
            </TableBody>
          </Table>
        ))
      }
    </div>

    <code class="prop-readout" data-table-prop-readout aria-live="polite"
      >&lt;Table variant="divided"&gt;…&lt;/Table&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{table.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Variants</dt>
      <dd>plain · divided · striped</dd>
    </div>
    <div class="fact">
      <dt class="label">Compound parts</dt>
      <dd>8 native elements</dd>
    </div>
  </dl>
</ComponentPreview>
