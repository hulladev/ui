---
import StepperDescription from "@/ui/stepper/stepper-description.astro"
import StepperContent from "@/ui/stepper/stepper-content.astro"
import Button from "@/ui/button/button.astro"
import Field from "@/ui/field/field.astro"
import FieldLabel from "@/ui/field/field-label.astro"
import Input from "@/ui/input/input.astro"
import Stepper from "@/ui/stepper/stepper.astro"
import StepperItem from "@/ui/stepper/stepper-item.astro"
import StepperIndicator from "@/ui/stepper/stepper-indicator.astro"
import StepperButton from "@/ui/stepper/stepper-button.astro"
import StepperLink from "@/ui/stepper/stepper-link.astro"
import ComponentPreview from "../ComponentPreview.astro"
const steps = ["Project", "Team", "Review"]
const descriptions = ["The essentials", "Your collaborators", "One last look"]
---

<ComponentPreview requirePropsView={true} component="Stepper" hint="Native steps">
  <div slot="variants" class="grid gap-8">
    <div data-stepper-demo class="grid gap-6">
      <nav aria-label="Create project">
        <Stepper>
          {
            steps.map((label, index) => (
              <StepperItem state={index === 0 ? "current" : "upcoming"} data-step-index={index}>
                <StepperButton
                  disabled={index > 0}
                  aria-controls={`step-panel-${index}`}
                  aria-label={`${index + 1} ${label}`}
                >
                  <StepperIndicator>{String(index + 1).padStart(2, "0")}</StepperIndicator>
                  <StepperContent>
                    <>
                      <span>{label}</span>
                      <StepperDescription>{descriptions[index]}</StepperDescription>
                    </>
                  </StepperContent>
                </StepperButton>
              </StepperItem>
            ))
          }
        </Stepper>
      </nav>
      <section
        id="step-panel-0"
        data-step-panel="0"
        aria-labelledby="step-project-title"
        class="grid gap-4"
      >
        <div>
          <p class="mb-1 font-mono text-xs text-muted-foreground">01 / PROJECT</p><h3
            id="step-project-title"
            class="text-xl font-semibold tracking-tight"
          >
            Project details
          </h3>
        </div>
        <Field
          ><FieldLabel for="step-project">Project name</FieldLabel><Input
            id="step-project"
            value="Website refresh"
          /></Field
        >
      </section>
      <section
        id="step-panel-1"
        data-step-panel="1"
        aria-labelledby="step-team-title"
        class="grid gap-4"
        hidden
      >
        <div>
          <p class="mb-1 font-mono text-xs text-muted-foreground">02 / TEAM</p><h3
            id="step-team-title"
            class="text-xl font-semibold tracking-tight"
          >
            Who’s working on this?
          </h3>
        </div>
        <Field
          ><FieldLabel for="step-team">Team name</FieldLabel><Input
            id="step-team"
            value="Design studio"
          /></Field
        >
      </section>
      <section
        id="step-panel-2"
        data-step-panel="2"
        aria-labelledby="step-review-title"
        class="grid gap-4"
        hidden
      >
        <div>
          <p class="mb-1 font-mono text-xs text-muted-foreground">03 / REVIEW</p><h3
            id="step-review-title"
            class="text-xl font-semibold tracking-tight"
          >
            Review your setup
          </h3>
        </div>
        <p class="text-sm text-muted-foreground">Review your project and team before finishing.</p>
        <dl class="grid gap-2 text-sm">
          <div class="flex justify-between gap-3">
            <dt>Project</dt><dd data-review-project></dd>
          </div><div class="flex justify-between gap-3">
            <dt>Team</dt><dd data-review-team></dd>
          </div>
        </dl>
      </section>
      <div class="flex justify-between gap-3 border-t border-border pt-4">
        <Button data-step-back variant="outline" size="sm" disabled>Back</Button>
        <Button data-step-next size="sm">Continue</Button>
      </div>
      <p data-step-status role="status" class="text-xs text-muted-foreground">Step 1 of 3</p>
    </div>
    <nav aria-label="Release checklist" class="border-t border-border pt-6">
      <Stepper orientation="vertical">
        <StepperItem state="complete"
          ><StepperLink href="#stepper"
            ><StepperIndicator>01</StepperIndicator><span
              >Prepare assets <span class="block text-xs font-normal text-muted-foreground"
                >Complete</span
              ></span
            ></StepperLink
          ></StepperItem
        >
        <StepperItem state="current"
          ><StepperLink href="#stepper"
            ><StepperIndicator>02</StepperIndicator><span
              >Review changes <span class="block text-xs font-normal text-muted-foreground"
                >In progress</span
              ></span
            ></StepperLink
          ></StepperItem
        >
        <StepperItem
          ><span class="flex items-center gap-2.5 py-2 text-sm"
            ><StepperIndicator>03</StepperIndicator><span>Publish release</span></span
          ></StepperItem
        >
      </Stepper>
    </nav>
  </div>

  <div slot="props" class="prop-playground" data-stepper-props>
    <div class="prop-controls">
      <label class="prop-control"
        ><span class="label">Orientation</span><select data-stepper-orientation
          ><option value="horizontal">Horizontal</option><option value="vertical">Vertical</option
          ></select
        ></label
      >
      <label class="prop-control"
        ><span class="label">Current step</span><select data-stepper-current
          ><option value="0">Project</option><option value="1">Team</option><option value="2"
            >Review</option
          ></select
        ></label
      >
    </div>
    <div class="playground-stage">
      <Stepper aria-label="Stepper playground" data-stepper-control>
        {
          steps.map((label, index) => (
            <StepperItem state={index === 0 ? "current" : "upcoming"}>
              <span class="flex flex-col items-start gap-3 pr-3 text-sm group-data-[orientation=vertical]/stepper:flex-row group-data-[orientation=vertical]/stepper:items-center">
                <StepperIndicator>{String(index + 1).padStart(2, "0")}</StepperIndicator>
                {label}
              </span>
            </StepperItem>
          ))
        }
      </Stepper>
    </div>
  </div>
  <dl slot="facts" class="facts">
    <div class="fact"><dt class="label">Semantics</dt><dd>Ordered list</dd></div>
    <div class="fact"><dt class="label">Current step</dt><dd>aria-current</dd></div>
    <div class="fact"><dt class="label">Flow state</dt><dd>Application-owned</dd></div>
  </dl>
</ComponentPreview>

<script>
  document.querySelectorAll<HTMLElement>("[data-stepper-demo]").forEach((demo) => {
    let current = 0
    let furthest = 0
    const items = Array.from(demo.querySelectorAll<HTMLElement>("[data-step-index]"))
    const back = demo.querySelector<HTMLButtonElement>("[data-step-back]")!
    const next = demo.querySelector<HTMLButtonElement>("[data-step-next]")!
    const status = demo.querySelector<HTMLElement>("[data-step-status]")!
    const update = () => {
      items.forEach((item, index) => {
        item.dataset.state =
          index === current ? "current" : index < current ? "complete" : "upcoming"
        if (index === current) item.setAttribute("aria-current", "step")
        else item.removeAttribute("aria-current")
        item.querySelector<HTMLButtonElement>("button")!.disabled = index > furthest
      })
      demo.querySelectorAll<HTMLElement>("[data-step-panel]").forEach((panel) => {
        panel.hidden = Number(panel.dataset.stepPanel) !== current
      })
      back.disabled = current === 0
      next.textContent = current === 2 ? "Finish" : "Continue"
      status.textContent = `Step ${current + 1} of 3`
      demo.querySelector<HTMLElement>("[data-review-project]")!.textContent =
        demo.querySelector<HTMLInputElement>("#step-project")!.value
      demo.querySelector<HTMLElement>("[data-review-team]")!.textContent =
        demo.querySelector<HTMLInputElement>("#step-team")!.value
    }
    const navigate = (index: number) => {
      current = index
      furthest = Math.max(current, furthest)
      update()
      items[current]!.querySelector<HTMLButtonElement>("button")!.focus()
    }
    items.forEach((item, index) =>
      item.querySelector("button")!.addEventListener("click", () => navigate(index))
    )
    back.addEventListener("click", () => navigate(Math.max(0, current - 1)))
    next.addEventListener("click", () => {
      if (current < 2) navigate(current + 1)
      else status.textContent = "Project setup complete. This demo has not created a project."
    })
  })

  document.querySelectorAll<HTMLElement>("[data-stepper-props]").forEach((root) => {
    const control = root.querySelector<HTMLElement>("[data-stepper-control]")!
    root.addEventListener("change", () => {
      control.dataset.orientation = root.querySelector<HTMLSelectElement>(
        "[data-stepper-orientation]"
      )!.value
      const current = Number(root.querySelector<HTMLSelectElement>("[data-stepper-current]")!.value)
      control.querySelectorAll<HTMLElement>("[data-slot=stepper-item]").forEach((item, index) => {
        item.dataset.state =
          index === current ? "current" : index < current ? "complete" : "upcoming"
        if (index === current) item.setAttribute("aria-current", "step")
        else item.removeAttribute("aria-current")
      })
    })
  })
</script>
