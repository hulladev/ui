---
import Switch from "@/ui/switch/switch.astro"
import Input from "@/ui/input/input.astro"
import DatePicker from "@/ui/date-picker/date-picker.astro"
import DateTimePicker from "@/ui/date-picker/date-time-picker.astro"
import FieldDescription from "@/ui/field/field-description.astro"
import FieldLabel from "@/ui/field/field-label.astro"
import Field from "@/ui/field/field.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const datePicker = manifest.library.components["date-picker"]
const unavailableDates = [{ start: "2026-07-20", end: "2026-07-22" }, "2026-07-26"] as const
---

<ComponentPreview
  component="Date Picker"
  hint="Enter · arrows · Escape"
  requirePropsView={true}
  variantsLabel="Picker compositions"
>
  <div slot="variants" class="grid gap-6">
    <Field>
      <FieldLabel for="picker-input-reference">Text input</FieldLabel>
      <Input id="picker-input-reference" value="Project kickoff" />
      <FieldDescription>Shared input styling, shown alongside the picker controls.</FieldDescription
      >
    </Field>
    <Field>
      <FieldLabel for="catalog-departure-date-trigger">Departure date</FieldLabel>
      <DatePicker
        id="catalog-departure-date"
        defaultValue="2026-07-30"
        form="catalog-trip-form"
        name="departureDate"
        disabledDates={unavailableDates}
        today="2026-07-30"
        class="w-full"
      />
      <FieldDescription>A localized label backed by an ISO date value.</FieldDescription>
    </Field>

    <Field>
      <FieldLabel for="catalog-travel-dates-trigger">Travel dates</FieldLabel>
      <DatePicker
        id="catalog-travel-dates"
        selectionMode="range"
        defaultValue={{ start: "2026-07-30", end: "2026-08-04" }}
        form="catalog-trip-form"
        startName="travelStart"
        endName="travelEnd"
        disabledDates={unavailableDates}
        today="2026-07-30"
        class="w-full"
      />
      <FieldDescription
        >Separate start and end inputs preserve native form submission.</FieldDescription
      >
    </Field>

    <Field>
      <FieldLabel for="catalog-meeting-time-trigger">Meeting date and time</FieldLabel>
      <DateTimePicker
        id="catalog-meeting-time"
        defaultValue="2026-07-30T09:30"
        form="catalog-trip-form"
        name="meetingAt"
        min="2026-07-20T08:00"
        max="2026-08-12T18:00"
        today="2026-07-30"
        class="w-full"
      />
      <FieldDescription>Calendar and TimePicker composed around one local value.</FieldDescription>
    </Field>

    <Field>
      <FieldLabel for="catalog-unavailable-date-trigger">Unavailable date</FieldLabel>
      <DatePicker
        id="catalog-unavailable-date"
        defaultValue="2026-08-12"
        form="catalog-trip-form"
        name="unavailableDate"
        disabled
        class="w-full"
      />
      <FieldDescription>Disabled custom fields are omitted from native submission.</FieldDescription
      >
    </Field>

    <form id="catalog-trip-form" data-picker-contract-form></form>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control">
        <span class="label">Value</span>
        <select aria-label="Date picker value" data-date-picker-value>
          <option value="2026-07-30" selected>30 July</option>
          <option value="2026-08-04">4 August</option>
          <option value="">Empty</option>
        </select>
      </label>
    </div>

    <div class="prop-controls prop-controls--toggles">
      <label class="prop-disabled">
        <Switch variant="subtle" data-date-picker-disabled />
        <span class="label">Disabled</span>
      </label>
    </div>

    <div class="playground-stage block">
      <DatePicker
        defaultValue="2026-07-30"
        today="2026-07-30"
        data-playground-date-picker
        class="mx-auto"
      />
    </div>

    <code class="prop-readout" data-date-picker-readout aria-live="polite"
      >&lt;DatePicker value="2026-07-30" /&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{datePicker.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Composition</dt>
      <dd>Button · Popover · Calendar</dd>
    </div>
    <div class="fact">
      <dt class="label">Form values</dt>
      <dd>date · start + end · local date-time</dd>
    </div>
    <div class="fact">
      <dt class="label">Date-time</dt>
      <dd>Calendar + TimePicker</dd>
    </div>
  </dl>
</ComponentPreview>
