---
import Code from "@/ui/code/code.astro"
import Switch from "@/ui/switch/switch.astro"
import Accordion from "@/ui/accordion/accordion.astro"
import AccordionContent from "@/ui/accordion/accordion-content.astro"
import AccordionItem from "@/ui/accordion/accordion-item.astro"
import AccordionTrigger from "@/ui/accordion/accordion-trigger.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const accordion = manifest.library.components.accordion
---

<ComponentPreview
  component="Accordion"
  hint="Expand and collapse · immediate content motion"
  requirePropsView={true}
  variantsLabel="Compositions"
>
  <div slot="variants" class="grid gap-8">
    <div
      class="grid grid-cols-[minmax(0,0.68fr)_minmax(18rem,1.32fr)] gap-10 max-[760px]:grid-cols-1 max-[760px]:gap-5"
    >
      <div class="grid content-start gap-3">
        <span class="font-mono text-xs font-medium tracking-wider text-primary uppercase">
          Release handbook / 04
        </span>
        <h3 class="m-0 text-2xl leading-7 font-semibold tracking-[-0.04em]">Before you ship</h3>
        <p class="m-0 max-w-sm text-sm leading-6 text-muted-foreground">
          A compact checklist for the last quiet hour before production.
        </p>
      </div>

      <Accordion aria-label="Release handbook">
        <AccordionItem name="catalog-release-handbook" open>
          <AccordionTrigger>
            <span
              class="mt-0.5 font-mono text-[0.65rem] font-medium tracking-wider text-primary uppercase"
              aria-hidden="true">01</span
            >
            Confirm the migration path
          </AccordionTrigger>
          <AccordionContent>
            <p>
              Run the migration against a current production snapshot and record the rollback
              command beside the release.
            </p>
          </AccordionContent>
        </AccordionItem>

        <AccordionItem name="catalog-release-handbook">
          <AccordionTrigger>
            <span
              class="mt-0.5 font-mono text-[0.65rem] font-medium tracking-wider text-primary uppercase"
              aria-hidden="true">02</span
            >
            Review the observable signals
          </AccordionTrigger>
          <AccordionContent>
            <p>
              Choose the latency, error-rate, and queue-depth signals that decide whether the
              rollout continues.
            </p>
          </AccordionContent>
        </AccordionItem>

        <AccordionItem name="catalog-release-handbook">
          <AccordionTrigger>
            <span
              class="mt-0.5 font-mono text-[0.65rem] font-medium tracking-wider text-primary uppercase"
              aria-hidden="true">03</span
            >
            Name the release owner
          </AccordionTrigger>
          <AccordionContent>
            <p>
              Assign one person to make the final call and keep the escalation channel visible for
              the duration of the rollout.
            </p>
          </AccordionContent>
        </AccordionItem>
      </Accordion>
    </div>

    <div class="grid gap-2">
      <span class="font-mono text-xs text-muted-foreground">Independent items</span>
      <Accordion aria-label="Workspace questions">
        <AccordionItem>
          <AccordionTrigger>Can several answers stay open?</AccordionTrigger>
          <AccordionContent>
            Yes. Omit the native <Code>name</Code> attribute and every item keeps its own open state.
          </AccordionContent>
        </AccordionItem>
        <AccordionItem>
          <AccordionTrigger>Can the content contain links and rich text?</AccordionTrigger>
          <AccordionContent>
            Yes. Content stays ordinary markup, including
            <a href="#accordion">links back to this section</a>.
          </AccordionContent>
        </AccordionItem>
      </Accordion>
    </div>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls prop-controls--toggles">
      <label class="prop-control prop-control--wide">
        <span class="label">Expansion</span>
        <select aria-label="Accordion expansion mode" data-accordion-prop-mode>
          <option value="exclusive">One item</option>
          <option value="independent">Independent</option>
        </select>
      </label>

      <label class="prop-disabled">
        <Switch variant="subtle" checked data-accordion-prop-open />
        <span class="label">First item open</span>
      </label>
    </div>

    <div class="playground-stage block">
      <Accordion data-playground-accordion aria-label="Example questions">
        <AccordionItem name="catalog-accordion-playground" open>
          <AccordionTrigger>What is included?</AccordionTrigger>
          <AccordionContent>
            Native state, keyboard interaction, focus treatment, and composable content.
          </AccordionContent>
        </AccordionItem>
        <AccordionItem name="catalog-accordion-playground">
          <AccordionTrigger>Is JavaScript required?</AccordionTrigger>
          <AccordionContent>
            No. Disclosure and exclusive grouping are provided by the platform.
          </AccordionContent>
        </AccordionItem>
      </Accordion>
    </div>

    <code class="prop-readout" data-accordion-prop-readout aria-live="polite"
      >&lt;AccordionItem name="faq" open&gt;…&lt;/AccordionItem&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{accordion.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Native elements</dt>
      <dd>details · summary</dd>
    </div>
    <div class="fact">
      <dt class="label">Custom props</dt>
      <dd>none · open + name are native</dd>
    </div>
  </dl>
</ComponentPreview>
