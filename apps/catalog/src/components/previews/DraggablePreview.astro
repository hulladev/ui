---
import Button from "@/ui/button/button.astro"
import CardDescription from "@/ui/card/card-description.astro"
import CardHeader from "@/ui/card/card-header.astro"
import CardTitle from "@/ui/card/card-title.astro"
import Card from "@/ui/card/card.astro"
import DragHandle from "@/ui/draggable/drag-handle.astro"
import Draggable from "@/ui/draggable/draggable.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const draggable = manifest.library.components.draggable
const axes = ["both", "x", "y"] as const
---

<ComponentPreview
  component="Draggable"
  hint="Pointer · arrows · Shift"
  requirePropsView={true}
  variantsLabel="Contained"
>
  <div slot="variants" class="spatial-stage draggable-stage" data-draggable-stage>
    <span class="spatial-origin" aria-hidden="true"></span>

    <Draggable boundaryPadding={12} class="draggable-panel">
      <Card variant="elevated" class="w-72 max-w-full">
        <CardHeader>
          <DragHandle aria-label="Move signal inspector">
            <span class="flex items-center gap-2">
              <span class="spatial-grip" aria-hidden="true">
                <i></i><i></i><i></i><i></i><i></i><i></i>
              </span>
              <span class="font-mono text-[0.6875rem] tracking-wider uppercase">
                Signal / Live
              </span>
            </span>
            <span class="spatial-coordinate" data-drag-position>x 0 · y 0</span>
          </DragHandle>
          <CardTitle>Move the inspector</CardTitle>
          <CardDescription>
            Parent bounds are the default. This card keeps a 12 px inset from every edge.
          </CardDescription>
        </CardHeader>
      </Card>
    </Draggable>

    <Button size="sm" variant="outline" class="absolute right-3 bottom-3 z-10" data-drag-reset>
      Reset
    </Button>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control prop-control--wide">
        <span class="label">Axis</span>
        <select aria-label="Draggable axis" data-draggable-prop-axis>
          {axes.map((axis) => <option value={axis}>{axis}</option>)}
        </select>
      </label>
    </div>

    <div class="playground-stage spatial-playground">
      {
        axes.map((axis) => (
          <Draggable
            axis={axis}
            boundaryPadding={8}
            data-playground-draggable
            data-playground-axis={axis}
            hidden={axis !== "both"}
          >
            <Card variant="elevated" class="w-40">
              <DragHandle aria-label={`Move card on ${axis} axis`}>Move me</DragHandle>
              <CardDescription>{axis} axis</CardDescription>
            </Card>
          </Draggable>
        ))
      }
    </div>

    <code class="prop-readout" data-draggable-prop-readout aria-live="polite"
      >&lt;Draggable axis="both" boundary="parent" boundaryPadding={8}&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{draggable.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Default bounds</dt>
      <dd>Parent content box</dd>
    </div>
    <div class="fact">
      <dt class="label">Options</dt>
      <dd>parent · viewport · selector · none</dd>
    </div>
  </dl>
</ComponentPreview>
