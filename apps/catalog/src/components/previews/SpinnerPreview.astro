---
import Button from "@/ui/button/button.astro"
import Spinner from "@/ui/spinner/spinner.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const spinner = manifest.library.components.spinner
---

<ComponentPreview component="Spinner" hint="Decorative SVG · motion aware" requirePropsView={true}>
  <div slot="variants" class="grid gap-4">
    <section
      class="relative overflow-hidden rounded-lg border border-border bg-surface-raised p-5 shadow-xs"
      aria-labelledby="spinner-preview-title"
    >
      <div
        class="absolute top-0 right-0 h-full w-24 bg-[radial-gradient(circle_at_100%_0%,color-mix(in_oklab,var(--color-primary)_18%,transparent),transparent_70%)]"
        aria-hidden="true"
      >
      </div>
      <div class="relative flex items-start justify-between gap-6">
        <div class="grid gap-1">
          <span class="font-mono text-[0.6875rem] tracking-wider text-primary uppercase"
            >Background task</span
          >
          <h3 id="spinner-preview-title" class="m-0 text-sm font-semibold">Indexing workspace</h3>
          <p class="m-0 max-w-sm text-xs leading-relaxed text-muted-foreground">
            Search remains available while the index catches up.
          </p>
        </div>
        <div role="status" class="flex items-center gap-2 text-xs text-muted-foreground">
          <Spinner />
          <span>Working</span>
        </div>
      </div>
    </section>

    <div class="flex flex-wrap items-center gap-3">
      <Button aria-busy="true" disabled>
        <Spinner />
        Publishing…
      </Button>
      <Button variant="outline" aria-busy="true" disabled>
        <Spinner />
        Checking
      </Button>
      <span role="status" class="ml-auto inline-flex items-center gap-2 text-xs text-success">
        <Spinner />
        Connecting securely
      </span>
    </div>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control">
        <span class="label">Status label</span>
        <input type="text" value="Working" data-spinner-label />
      </label>
    </div>
    <div class="playground-stage">
      <span role="status" class="inline-flex items-center gap-2">
        <Spinner data-playground-spinner />
        <span data-spinner-status>Working</span>
      </span>
    </div>
    <code class="prop-readout" data-spinner-readout aria-live="polite">&lt;Spinner /&gt;</code>
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{spinner.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Native element</dt>
      <dd>svg · aria-hidden by default</dd>
    </div>
    <div class="fact">
      <dt class="label">Custom props</dt>
      <dd>none · native SVG attributes</dd>
    </div>
  </dl>
</ComponentPreview>
