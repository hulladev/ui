---
import StepperIndicator from "@/ui/stepper/stepper-indicator.astro"
import StepperItem from "@/ui/stepper/stepper-item.astro"
import Stepper from "@/ui/stepper/stepper.astro"
import Code from "@/ui/code/code.astro"
import AlertDescription from "@/ui/alert/alert-description.astro"
import Alert from "@/ui/alert/alert.astro"
import SidebarMenuLink from "@/ui/sidebar/sidebar-menu-link.astro"
import SidebarMenuItem from "@/ui/sidebar/sidebar-menu-item.astro"
import SidebarMenu from "@/ui/sidebar/sidebar-menu.astro"
import SidebarGroupLabel from "@/ui/sidebar/sidebar-group-label.astro"
import SidebarGroup from "@/ui/sidebar/sidebar-group.astro"
import SidebarContent from "@/ui/sidebar/sidebar-content.astro"
import Sidebar from "@/ui/sidebar/sidebar.astro"
import CardContent from "@/ui/card/card-content.astro"
import CardDescription from "@/ui/card/card-description.astro"
import CardTitle from "@/ui/card/card-title.astro"
import CardHeader from "@/ui/card/card-header.astro"
import Card from "@/ui/card/card.astro"
import Badge from "@/ui/badge/badge.astro"
import Button from "@/ui/button/button.astro"
import DialogDescription from "@/ui/dialog/dialog-description.astro"
import DialogFooter from "@/ui/dialog/dialog-footer.astro"
import DialogHeader from "@/ui/dialog/dialog-header.astro"
import DialogTitle from "@/ui/dialog/dialog-title.astro"
import Dialog from "@/ui/dialog/dialog.astro"
import TableBody from "@/ui/table/table-body.astro"
import TableCell from "@/ui/table/table-cell.astro"
import TableHead from "@/ui/table/table-head.astro"
import TableHeader from "@/ui/table/table-header.astro"
import TableRow from "@/ui/table/table-row.astro"
import Table from "@/ui/table/table.astro"
---

<Dialog
  id="catalog-dialog"
  hidden
  aria-labelledby="catalog-dialog-title"
  aria-describedby="catalog-dialog-description"
>
  <DialogHeader>
    <div
      class="flex items-center justify-between gap-4 font-mono text-xs tracking-wider text-muted-foreground uppercase"
    >
      <span>Layer</span>
      <Code data-catalog-layer-order>pending</Code>
    </div>
    <DialogTitle id="catalog-dialog-title">Archive this release?</DialogTitle>
    <DialogDescription id="catalog-dialog-description">
      The release will leave the active channel and remain available in history. This example
      intentionally leaves state ownership in the catalog.
    </DialogDescription>
  </DialogHeader>

  <Alert
    ><AlertDescription>
      Dialog owns the dialog semantics, visual surface, focus management, and dismissal behavior.
    </AlertDescription></Alert
  >

  <DialogFooter>
    <Button variant="outline" data-close-catalog-dialog>Cancel</Button>
    <Button variant="secondary" data-open-catalog-nested>Inspect nested layer</Button>
    <Button data-close-catalog-dialog>Archive release</Button>
  </DialogFooter>
</Dialog>

<Dialog
  id="catalog-workspace-dialog"
  variant="workspace"
  hidden
  aria-labelledby="catalog-workspace-title"
  aria-describedby="catalog-workspace-description"
>
  <DialogHeader>
    <div
      class="flex items-start justify-between gap-6 max-[760px]:flex-col max-[760px]:items-stretch"
    >
      <div class="grid gap-1">
        <span class="font-mono text-xs font-medium tracking-wider uppercase"
          >Release workspace / 04</span
        >
        <DialogTitle id="catalog-workspace-title">Channel operations</DialogTitle>
        <DialogDescription id="catalog-workspace-description">
          Coordinate active releases without losing the catalog underneath.
        </DialogDescription>
      </div>
      <Button class="max-[760px]:w-full" variant="outline" data-close-workspace-dialog>
        Close workspace
      </Button>
    </div>
  </DialogHeader>

  <div
    class="grid min-h-0 grid-cols-[13.5rem_minmax(0,1fr)] overflow-hidden max-[760px]:grid-cols-1"
  >
    <Sidebar class="w-full h-auto">
      <SidebarContent aria-label="Release workspace navigation">
        <SidebarGroup
          ><SidebarGroupLabel>Operations</SidebarGroupLabel>
          <SidebarMenu
            ><SidebarMenuItem
              ><SidebarMenuLink href="#active" aria-current="page"
                ><span>Active channel</span><Badge size="sm">08</Badge></SidebarMenuLink
              ></SidebarMenuItem
            >
            <SidebarMenuItem
              ><SidebarMenuLink href="#approvals"
                ><span>Approvals</span><Badge size="sm">03</Badge></SidebarMenuLink
              ></SidebarMenuItem
            >
            <SidebarMenuItem
              ><SidebarMenuLink href="#history"
                ><span>Release history</span><Badge size="sm">24</Badge></SidebarMenuLink
              ></SidebarMenuItem
            >
            <SidebarMenuItem
              ><SidebarMenuLink href="#settings"
                ><span>Policy</span><Badge size="sm">↗</Badge></SidebarMenuLink
              ></SidebarMenuItem
            ></SidebarMenu
          >
        </SidebarGroup>
      </SidebarContent>
    </Sidebar>

    <section
      class="grid content-start gap-6 overflow-auto p-6"
      id="active"
      aria-labelledby="workspace-active-title"
    >
      <div
        class="flex items-end justify-between gap-4 max-[760px]:flex-col max-[760px]:items-stretch"
      >
        <div>
          <span class="font-mono text-xs font-medium tracking-wider uppercase">Active channel</span>
          <h3 class="mt-1 mb-0 text-xl tracking-tight" id="workspace-active-title">
            Eight releases in motion
          </h3>
        </div>
        <Button class="max-[760px]:w-full">New release</Button>
      </div>

      <div class="grid grid-cols-3 gap-3 max-[760px]:grid-cols-1">
        <Card
          ><CardHeader
            ><CardDescription>Healthy</CardDescription><CardTitle>06</CardTitle></CardHeader
          ><CardContent>on schedule</CardContent></Card
        >
        <Card
          ><CardHeader
            ><CardDescription>Review</CardDescription><CardTitle>02</CardTitle></CardHeader
          ><CardContent>need attention</CardContent></Card
        >
        <Card
          ><CardHeader
            ><CardDescription>Median cycle</CardDescription><CardTitle>4.2d</CardTitle></CardHeader
          ><CardContent>−0.8 this month</CardContent></Card
        >
      </div>

      <div class="overflow-x-auto rounded-md border border-border">
        <Table variant="divided" class="min-w-168" aria-label="Active releases">
          <TableHeader>
            <TableRow>
              <TableHead>Release</TableHead>
              <TableHead>Owner</TableHead>
              <TableHead>Status</TableHead>
              <TableHead>Window</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            <TableRow>
              <TableHead scope="row">Aurora 2.4</TableHead>
              <TableCell>Maya Chen</TableCell>
              <TableCell><Badge variant="success" size="sm">Ready</Badge></TableCell>
              <TableCell>Today · 16:00</TableCell>
            </TableRow>
            <TableRow>
              <TableHead scope="row">Atlas mobile</TableHead>
              <TableCell>Jules Kim</TableCell>
              <TableCell><Badge variant="warning" size="sm">Review</Badge></TableCell>
              <TableCell>Mon · 09:30</TableCell>
            </TableRow>
            <TableRow>
              <TableHead scope="row">Signal API</TableHead>
              <TableCell>Omar Patel</TableCell>
              <TableCell><Badge variant="success" size="sm">Ready</Badge></TableCell>
              <TableCell>Tue · 11:00</TableCell>
            </TableRow>
            <TableRow>
              <TableHead scope="row">Console 8.1</TableHead>
              <TableCell>Ana Rios</TableCell>
              <TableCell><Badge variant="warning" size="sm">Review</Badge></TableCell>
              <TableCell>Wed · 18:00</TableCell>
            </TableRow>
          </TableBody>
        </Table>
      </div>
    </section>
  </div>

  <DialogFooter>
    <span class="mr-auto text-xs text-muted-foreground max-[760px]:hidden">
      Workspace chrome is supplied by the dialog variant.
    </span>
    <Button variant="outline" data-close-workspace-dialog>Return to catalog</Button>
  </DialogFooter>
</Dialog>

<Dialog
  id="catalog-fullscreen-dialog"
  variant="fullscreen"
  hidden
  aria-labelledby="catalog-fullscreen-title"
  aria-describedby="catalog-fullscreen-description"
>
  <DialogHeader>
    <div
      class="flex items-start justify-between gap-6 max-[760px]:flex-col max-[760px]:items-stretch"
    >
      <div class="grid gap-1">
        <span class="font-mono text-xs font-medium tracking-wider uppercase"
          >Guided release / Step 02 of 04</span
        >
        <DialogTitle id="catalog-fullscreen-title">Define the rollout sequence</DialogTitle>
        <DialogDescription id="catalog-fullscreen-description">
          A page-like workflow presented without abandoning the current application context.
        </DialogDescription>
      </div>
      <Button class="max-[760px]:w-full" variant="outline" data-close-fullscreen-dialog>
        Save and exit
      </Button>
    </div>
  </DialogHeader>

  <div class="grid min-h-0 grid-cols-[14rem_minmax(0,1fr)] overflow-hidden max-[760px]:grid-cols-1">
    <nav
      class="border-r border-border bg-background/45 p-5 max-[760px]:border-r-0 max-[760px]:border-b max-[760px]:p-4"
      aria-label="Release setup progress"
    >
      <span class="font-mono text-xs font-medium tracking-wider uppercase max-[760px]:hidden"
        >Release setup</span
      >
      {
        (["horizontal", "vertical"] as const).map((orientation) => (
          <div
            class={
              orientation === "horizontal"
                ? "overflow-x-auto min-[761px]:hidden"
                : "mt-4 hidden min-[761px]:block"
            }
          >
            <div class={orientation === "horizontal" ? "min-w-128" : ""}>
              <Stepper orientation={orientation}>
                {(
                  [
                    { title: "Scope", description: "12 changes selected", state: "complete" },
                    { title: "Sequence", description: "Order the rollout", state: "current" },
                    { title: "Safeguards", description: "Limits and checks", state: "upcoming" },
                    { title: "Review", description: "Confirm and schedule", state: "upcoming" },
                  ] as const
                ).map(({ title, description, state }, index) => (
                  <StepperItem state={state}>
                    <div class="flex gap-3">
                      <StepperIndicator>{String(index + 1).padStart(2, "0")}</StepperIndicator>
                      <div class="grid gap-1">
                        <strong>{title}</strong>
                        {orientation === "vertical" && <span class="text-xs">{description}</span>}
                      </div>
                    </div>
                  </StepperItem>
                ))}
              </Stepper>
            </div>
          </div>
        ))
      }
    </nav>

    <section
      class="grid content-start gap-6 overflow-auto p-8 max-[760px]:p-6"
      aria-labelledby="sequence-title"
    >
      <div
        class="flex items-end justify-between gap-4 max-[760px]:flex-col max-[760px]:items-stretch"
      >
        <div>
          <span class="font-mono text-xs font-medium tracking-wider uppercase">Sequence</span>
          <h3 class="mt-1 mb-0 text-xl tracking-tight" id="sequence-title">
            Move from low risk to broad exposure.
          </h3>
        </div>
        <span class="font-mono text-xs text-muted-foreground"> Estimated duration · 42 min </span>
      </div>

      <div class="grid gap-3">
        <Card
          ><CardHeader
            ><div class="flex items-center justify-between gap-3">
              <span>01</span><Badge>5%</Badge>
            </div><CardTitle>Internal cohort</CardTitle><CardDescription
              >Team accounts and synthetic traffic.</CardDescription
            ></CardHeader
          ></Card
        >
        <Card
          ><CardHeader
            ><div class="flex items-center justify-between gap-3">
              <span>02</span><Badge>20%</Badge>
            </div><CardTitle>Early access</CardTitle><CardDescription
              >Opted-in workspaces with live monitoring.</CardDescription
            ></CardHeader
          ></Card
        >
        <Card
          ><CardHeader
            ><div class="flex items-center justify-between gap-3">
              <span>03</span><Badge>75%</Badge>
            </div><CardTitle>General rollout</CardTitle><CardDescription
              >Remaining accounts across all regions.</CardDescription
            ></CardHeader
          ></Card
        >
      </div>
    </section>
  </div>

  <DialogFooter>
    <Button variant="outline" data-close-fullscreen-dialog>Cancel</Button>
    <Button variant="secondary">Save draft</Button>
    <Button>Continue to safeguards</Button>
  </DialogFooter>
</Dialog>

<Dialog
  id="catalog-nested-dialog"
  hidden
  aria-labelledby="catalog-nested-title"
  aria-describedby="catalog-nested-description"
>
  <DialogHeader>
    <div
      class="flex items-center justify-between gap-4 font-mono text-xs tracking-wider text-muted-foreground uppercase"
    >
      <span>Top layer</span>
      <Code data-catalog-nested-order>pending</Code>
    </div>
    <DialogTitle id="catalog-nested-title">Ordering is structural.</DialogTitle>
    <DialogDescription id="catalog-nested-description">
      This layer registered second, so it receives Escape and focus before the dialog underneath it.
    </DialogDescription>
  </DialogHeader>

  <DialogFooter>
    <Button autofocus data-close-catalog-nested>Return to dialog</Button>
  </DialogFooter>
</Dialog>

<script>
  import { onDialogDismiss } from "@/ui/lib/dialog"

  const catalogDialog = document.querySelector<HTMLElement>("#catalog-dialog")
  const catalogWorkspaceDialog = document.querySelector<HTMLElement>("#catalog-workspace-dialog")
  const catalogFullscreenDialog = document.querySelector<HTMLElement>("#catalog-fullscreen-dialog")
  const catalogNestedDialog = document.querySelector<HTMLElement>("#catalog-nested-dialog")
  const layerCount = document.querySelector<HTMLElement>("[data-overlay-layer-count]")
  const catalogLayerOrder = document.querySelector<HTMLElement>("[data-catalog-layer-order]")
  const catalogNestedOrder = document.querySelector<HTMLElement>("[data-catalog-nested-order]")
  const dialogPropsPreview = document.querySelector<HTMLElement>(
    '[data-preview-component="dialog-preview"]'
  )

  const getPropsDialog = () => {
    const variant =
      dialogPropsPreview?.querySelector<HTMLSelectElement>("[data-dialog-prop-variant]")?.value ??
      "compact"
    const dialog =
      variant === "workspace"
        ? catalogWorkspaceDialog
        : variant === "fullscreen"
          ? catalogFullscreenDialog
          : catalogDialog
    return { dialog, variant }
  }

  const syncDialogProps = () => {
    if (!dialogPropsPreview) return
    const { variant } = getPropsDialog()
    const dismissible =
      dialogPropsPreview.querySelector<HTMLInputElement>("[data-dialog-prop-dismissible]")
        ?.checked ?? true
    const summary = dialogPropsPreview.querySelector<HTMLElement>("[data-dialog-prop-summary]")
    const readout = dialogPropsPreview.querySelector<HTMLElement>("[data-dialog-prop-readout]")
    if (summary) summary.textContent = `${variant} · ${dismissible ? "dismissible" : "locked"}`
    if (readout) {
      readout.textContent = `<Dialog variant="${variant}" dismissible={${dismissible}} />`
    }
  }

  const syncLayerLedger = () => {
    const count = document.querySelectorAll("[data-slot='dialog-overlay']:not([hidden])").length
    if (layerCount) layerCount.textContent = `${count} active layer${count === 1 ? "" : "s"}`

    const dialogOrder = catalogDialog?.dataset.layerOrder
    const nestedOrder = catalogNestedDialog?.dataset.layerOrder
    if (catalogLayerOrder) {
      catalogLayerOrder.textContent = dialogOrder === undefined ? "pending" : `order ${dialogOrder}`
    }
    if (catalogNestedOrder) {
      catalogNestedOrder.textContent =
        nestedOrder === undefined ? "pending" : `order ${nestedOrder}`
    }
  }

  const closeCatalogNested = () => {
    if (catalogNestedDialog) catalogNestedDialog.hidden = true
  }

  const closeCatalogDialog = () => {
    closeCatalogNested()
    if (catalogDialog) catalogDialog.hidden = true
  }

  const closeWorkspaceDialog = () => {
    if (catalogWorkspaceDialog) catalogWorkspaceDialog.hidden = true
  }

  const closeFullscreenDialog = () => {
    if (catalogFullscreenDialog) catalogFullscreenDialog.hidden = true
  }

  document.querySelector("[data-open-catalog-dialog]")?.addEventListener("click", () => {
    if (catalogDialog) catalogDialog.hidden = false
  })
  document.querySelector("[data-open-workspace-dialog]")?.addEventListener("click", () => {
    if (catalogWorkspaceDialog) catalogWorkspaceDialog.hidden = false
  })
  document.querySelector("[data-open-fullscreen-dialog]")?.addEventListener("click", () => {
    if (catalogFullscreenDialog) catalogFullscreenDialog.hidden = false
  })
  document.querySelector("[data-open-catalog-nested]")?.addEventListener("click", () => {
    if (catalogNestedDialog) catalogNestedDialog.hidden = false
  })
  document.querySelector("[data-open-props-dialog]")?.addEventListener("click", () => {
    const { dialog } = getPropsDialog()
    const dismissible =
      dialogPropsPreview?.querySelector<HTMLInputElement>("[data-dialog-prop-dismissible]")
        ?.checked ?? true
    if (dialog) {
      dialog.dataset.dismissible = String(dismissible)
      dialog.hidden = false
    }
  })
  dialogPropsPreview?.addEventListener("input", (event) => {
    if (
      (event.target as HTMLElement).matches(
        "[data-dialog-prop-variant], [data-dialog-prop-dismissible]"
      )
    ) {
      syncDialogProps()
    }
  })
  document.querySelectorAll("[data-close-catalog-dialog]").forEach((button) => {
    button.addEventListener("click", closeCatalogDialog)
  })
  document.querySelectorAll("[data-close-workspace-dialog]").forEach((button) => {
    button.addEventListener("click", closeWorkspaceDialog)
  })
  document.querySelectorAll("[data-close-fullscreen-dialog]").forEach((button) => {
    button.addEventListener("click", closeFullscreenDialog)
  })
  document
    .querySelector("[data-close-catalog-nested]")
    ?.addEventListener("click", closeCatalogNested)

  if (catalogDialog) onDialogDismiss(catalogDialog, closeCatalogDialog)
  if (catalogWorkspaceDialog) onDialogDismiss(catalogWorkspaceDialog, closeWorkspaceDialog)
  if (catalogFullscreenDialog) onDialogDismiss(catalogFullscreenDialog, closeFullscreenDialog)
  if (catalogNestedDialog) onDialogDismiss(catalogNestedDialog, closeCatalogNested)

  const layerObserver = new MutationObserver(syncLayerLedger)
  ;[catalogDialog, catalogWorkspaceDialog, catalogFullscreenDialog, catalogNestedDialog].forEach(
    (dialog) => {
      if (!dialog) return
      layerObserver.observe(dialog, {
        attributeFilter: ["data-layer-order", "hidden"],
      })
    }
  )
  syncDialogProps()
  syncLayerLedger()
</script>
