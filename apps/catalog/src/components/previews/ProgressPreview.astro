---
import FieldLabel from "@/ui/field/field-label.astro"
import Progress from "@/ui/progress/progress.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const progress = manifest.library.components.progress
---

<ComponentPreview
  component="Progress"
  hint="progress · determinate or indeterminate"
  propsLabel="Native state"
  requirePropsView={true}
>
  <div slot="variants" class="grid w-full gap-6">
    <div class="grid gap-2">
      <FieldLabel for="progress-default">Determinate · 68%</FieldLabel>
      <Progress id="progress-default" value={68} max={100}>68%</Progress>
    </div>
    <div class="grid gap-2">
      <FieldLabel for="progress-complete">Complete · 100%</FieldLabel>
      <Progress id="progress-complete" value={100} max={100}>100%</Progress>
    </div>
    <div class="grid gap-2">
      <FieldLabel for="progress-indeterminate">Indeterminate</FieldLabel>
      <Progress id="progress-indeterminate">In progress</Progress>
    </div>
    <p class="text-xs text-muted-foreground">
      Default appearance. State comes from native value and max attributes; there are no color
      variants.
    </p>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control">
        <span class="label">State</span>
        <select aria-label="Progress state" data-progress-state>
          <option value="determinate">Determinate</option>
          <option value="indeterminate">Indeterminate</option>
        </select>
      </label>

      <label class="prop-control">
        <span class="label">Value</span>
        <input
          type="range"
          min="0"
          max="100"
          value="68"
          aria-label="Progress value"
          data-progress-value
        />
      </label>
    </div>
    <div class="playground-stage">
      <div class="w-64 max-w-full">
        <Progress value={68} max={100} aria-label="Example progress" data-playground-progress
          >68%</Progress
        >
      </div>
    </div>

    <code class="prop-readout" data-progress-readout aria-live="polite"
      >&lt;Progress value=&#123;68&#125; max=&#123;100&#125; /&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{progress.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Native element</dt>
      <dd>progress · implicit progressbar role</dd>
    </div>
    <div class="fact">
      <dt class="label">Indeterminate</dt>
      <dd>omit the value attribute</dd>
    </div>
  </dl>
</ComponentPreview>
