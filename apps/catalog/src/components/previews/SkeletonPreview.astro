---
import Skeleton from "@/ui/skeleton/skeleton.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"

const skeleton = manifest.library.components.skeleton
const skeletonIterations = ["repeat", "once"] as const
const skeletonShapes = [
  { className: "h-4 w-48", value: "line" },
  { className: "size-16 rounded-full", value: "avatar" },
  { className: "aspect-video w-64 max-w-full", value: "media" },
] as const
const skeletonVariants = ["pulse", "shimmer"] as const
---

<ComponentPreview
  component="Skeleton"
  hint="Decorative · aria-hidden"
  propsLabel="Composition"
  requirePropsView={true}
>
  <div
    slot="variants"
    class="grid grid-cols-[minmax(0,1.35fr)_minmax(13rem,0.65fr)] gap-4 max-[760px]:grid-cols-1"
  >
    <section
      aria-busy="true"
      aria-label="Loading feature article"
      class="grid gap-5 rounded-lg border border-border bg-surface-raised p-5 shadow-xs"
    >
      <div class="flex items-center gap-3">
        <Skeleton class="size-10 shrink-0 rounded-full" />
        <div class="grid flex-1 gap-2">
          <Skeleton class="h-3 w-32 max-w-full" />
          <Skeleton class="h-2.5 w-20 max-w-full" />
        </div>
        <Skeleton class="h-6 w-14 rounded-full" />
      </div>

      <Skeleton variant="shimmer" class="aspect-[16/7] w-full [--skeleton-iteration-count:1]" />

      <div class="grid gap-2.5">
        <Skeleton class="h-4 w-[68%]" />
        <Skeleton class="h-3 w-full" />
        <Skeleton class="h-3 w-[88%]" />
        <Skeleton class="h-3 w-[54%]" />
      </div>
    </section>

    <section
      aria-busy="true"
      aria-label="Loading recent activity"
      class="grid content-start gap-4 rounded-lg border border-border bg-surface/80 p-4"
    >
      <div class="flex items-center justify-between gap-4">
        <Skeleton class="h-3 w-24" />
        <Skeleton class="size-5 rounded-sm" />
      </div>
      {
        Array.from({ length: 4 }, (_, index) => (
          <div class="flex items-center gap-3">
            <Skeleton class="size-8 shrink-0 rounded-full" />
            <div class="grid flex-1 gap-2">
              <Skeleton class={`h-2.5 ${index % 2 === 0 ? "w-[82%]" : "w-[68%]"}`} />
              <Skeleton class="h-2 w-16" />
            </div>
          </div>
        ))
      }
    </section>
  </div>

  <div slot="props" class="prop-playground">
    <div class="prop-controls">
      <label class="prop-control">
        <span class="label">Shape</span>
        <select aria-label="Skeleton shape" data-skeleton-shape>
          <option value="line" selected>Text line</option>
          <option value="avatar">Avatar</option>
          <option value="media">Media</option>
        </select>
      </label>

      <label class="prop-control">
        <span class="label">Variant</span>
        <select aria-label="Skeleton variant" data-skeleton-variant>
          <option value="pulse" selected>Pulse</option>
          <option value="shimmer">Shimmer</option>
        </select>
      </label>

      <label class="prop-control">
        <span class="label">Iteration</span>
        <select aria-label="Skeleton iteration" data-skeleton-iteration>
          <option value="repeat" selected>Repeat</option>
          <option value="once">Once</option>
        </select>
      </label>
    </div>

    <div class="playground-stage">
      {
        skeletonShapes.map(({ className, value: shape }) =>
          skeletonVariants.map((variant) =>
            skeletonIterations.map((iteration) => (
              <Skeleton
                variant={variant}
                class={`${className} ${
                  iteration === "once" ? "[--skeleton-iteration-count:1]" : ""
                }`}
                data-playground-skeleton
                data-shape={shape}
                data-variant={variant}
                data-iteration={iteration}
                hidden={shape !== "line" || variant !== "pulse" || iteration !== "repeat"}
              />
            ))
          )
        )
      }
    </div>

    <code class="prop-readout" data-skeleton-readout aria-live="polite"
      >&lt;Skeleton className="h-4 w-48" /&gt;</code
    >
  </div>

  <dl slot="facts" class="facts">
    <div class="fact">
      <dt class="label">Available in</dt>
      <dd>{skeleton.frameworks.join(" · ")}</dd>
    </div>
    <div class="fact">
      <dt class="label">Motion variants</dt>
      <dd>pulse (default) · shimmer</dd>
    </div>
    <div class="fact">
      <dt class="label">Run once</dt>
      <dd>[--skeleton-iteration-count:1]</dd>
    </div>
  </dl>
</ComponentPreview>
