---
type Props = {
  component: string
  hint?: string
  propsLabel?: string
  requirePropsView: true
  variantsLabel?: string
}

const {
  component,
  hint = "Tab focus",
  propsLabel = "Props",
  requirePropsView,
  variantsLabel = "Examples",
} = Astro.props
const previewId = `${component.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}-preview`
const hasProps = Astro.slots.has("props")

if (requirePropsView && !hasProps) {
  throw new Error(`ComponentPreview for "${component}" requires an interactive slot="props" view.`)
}
---

<div class="preview-pane" data-component-preview data-preview-component={previewId}>
  <header class="bench-bar label">
    <div class="preview-heading">
      <span>Live canvas</span>
      {
        hasProps && (
          <div class="preview-tabs" role="tablist" aria-label={`${component} preview mode`}>
            <button
              id={`${previewId}-variants-tab`}
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls={`${previewId}-variants`}
              tabindex="0"
              data-preview-tab="variants"
            >
              {variantsLabel}
            </button>
            <button
              id={`${previewId}-props-tab`}
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls={`${previewId}-props`}
              tabindex="-1"
              data-preview-tab="props"
            >
              {propsLabel}
            </button>
          </div>
        )
      }
    </div>

    <div class="bench-actions">
      <label class="canvas-background-control">
        <span>Canvas</span>
        <select aria-label="Canvas background" data-canvas-background-select>
          <option value="grid" selected>Grid</option>
          <option value="plain">Plain</option>
        </select>
      </label>
      <span class="bench-hint">{hint}</span>
    </div>
  </header>

  <div class="canvas" data-preview-canvas data-background="grid">
    <div
      class="preview-panel"
      id={`${previewId}-variants`}
      role={hasProps ? "tabpanel" : undefined}
      aria-labelledby={hasProps ? `${previewId}-variants-tab` : undefined}
      data-preview-panel="variants"
    >
      <slot name="variants" />
    </div>

    {
      hasProps && (
        <div
          class="preview-panel"
          id={`${previewId}-props`}
          role="tabpanel"
          aria-labelledby={`${previewId}-props-tab`}
          data-preview-panel="props"
          hidden
        >
          <slot name="props" />
        </div>
      )
    }
  </div>

  <slot name="facts" />
</div>

<script>
  type CanvasBackground = "grid" | "plain"

  const setCanvasBackground = (value: CanvasBackground) => {
    document.querySelectorAll<HTMLElement>("[data-preview-canvas]").forEach((canvas) => {
      canvas.dataset.background = value
    })
    document
      .querySelectorAll<HTMLSelectElement>("[data-canvas-background-select]")
      .forEach((select) => {
        select.value = value
      })
    try {
      window.localStorage.setItem("hulla-catalog-canvas-background", value)
    } catch {
      // The synchronized setting still works when storage is unavailable.
    }
  }

  document.addEventListener("change", (event) => {
    const select = (event.target as HTMLElement).closest<HTMLSelectElement>(
      "[data-canvas-background-select]"
    )
    if (select?.value === "grid" || select?.value === "plain") {
      setCanvasBackground(select.value)
    }
  })

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement
    const tab = target.closest<HTMLButtonElement>("[data-preview-tab]")
    if (!tab) return

    const preview = tab.closest<HTMLElement>("[data-component-preview]")
    const mode = tab.dataset.previewTab
    if (!mode || !preview) return

    preview.querySelectorAll<HTMLButtonElement>("[data-preview-tab]").forEach((item) => {
      item.setAttribute("aria-selected", String(item === tab))
      item.tabIndex = item === tab ? 0 : -1
    })
    preview.querySelectorAll<HTMLElement>("[data-preview-panel]").forEach((panel) => {
      panel.hidden = panel.dataset.previewPanel !== mode
    })
    preview.dispatchEvent(new CustomEvent("previewmodechange", { bubbles: true, detail: { mode } }))
  })

  document.addEventListener("keydown", (event) => {
    const tab = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-preview-tab]")
    if (!tab || !["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return

    const tablist = tab.closest<HTMLElement>('[role="tablist"]')
    const tabs = Array.from(
      tablist?.querySelectorAll<HTMLButtonElement>("[data-preview-tab]") ?? []
    )
    const currentIndex = tabs.indexOf(tab)
    if (currentIndex < 0) return

    event.preventDefault()
    const nextIndex =
      event.key === "Home"
        ? 0
        : event.key === "End"
          ? tabs.length - 1
          : event.key === "ArrowRight"
            ? (currentIndex + 1) % tabs.length
            : (currentIndex - 1 + tabs.length) % tabs.length
    tabs[nextIndex]?.click()
    tabs[nextIndex]?.focus()
  })

  let initialBackground: CanvasBackground = "grid"
  try {
    if (window.localStorage.getItem("hulla-catalog-canvas-background") === "plain") {
      initialBackground = "plain"
    }
  } catch {
    // Use the default grid background.
  }
  setCanvasBackground(initialBackground)
</script>
