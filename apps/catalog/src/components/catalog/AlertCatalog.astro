---
import astroAlertSource from "../../../../../generated/astro/alert/alert.astro?raw"
import reactAlertSource from "../../../../../generated/react/alert/alert.tsx?raw"
import ComponentSource from "../ComponentSource.astro"
import AlertPreview from "../previews/AlertPreview.astro"
import { alertPreviewSources } from "../../data/catalogPreviewSources"

const alertSources = [
  {
    code: astroAlertSource,
    filename: "generated/astro/alert/alert.astro",
    framework: "Astro · Alert",
    language: "astro" as const,
  },
  {
    code: reactAlertSource,
    filename: "generated/react/alert/alert.tsx",
    framework: "React · Alert",
    language: "tsx" as const,
  },
]

const usageSources = [
  {
    code: `---
import Alert from "@/ui/alert/alert.astro"
import AlertDescription from "@/ui/alert/alert-description.astro"
import AlertIcon from "@/ui/alert/alert-icon.astro"
import AlertTitle from "@/ui/alert/alert-title.astro"
import { TriangleAlert } from "@lucide/astro"
---

<Alert variant="warning">
  <AlertIcon><TriangleAlert /></AlertIcon>
  <AlertTitle>Token expires soon.</AlertTitle>
  <AlertDescription>
    Rotate the deployment token before Friday to avoid interrupted builds.
  </AlertDescription>
</Alert>`,
    filename: "src/components/deployment-warning.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { TriangleAlert } from "lucide-react"
import { Alert, AlertDescription, AlertIcon, AlertTitle } from "@/ui/alert"

export function DeploymentWarning() {
  return (
    <Alert variant="warning">
      <AlertIcon><TriangleAlert /></AlertIcon>
      <AlertTitle>Token expires soon.</AlertTitle>
      <AlertDescription>
        Rotate the deployment token before Friday to avoid interrupted builds.
      </AlertDescription>
    </Alert>
  )
}`,
    filename: "src/components/deployment-warning.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="alert" aria-labelledby="alert-section-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Feedback</p>
      <h2 id="alert-section-title">Alert</h2>
    </div>
    <span class="status">Semantic by default</span>
  </div>

  <article class="bench glass-panel" aria-label="Alert component preview">
    <div class="workbench workbench--alert">
      <AlertPreview />

      <ComponentSource
        component="Alert"
        generatedFamilies={["alert"]}
        previewSources={alertPreviewSources}
        sources={alertSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncAlertPlayground = (preview: HTMLElement) => {
    const variant =
      preview.querySelector<HTMLSelectElement>("[data-alert-prop-variant]")?.value ?? "note"
    const role = preview.querySelector<HTMLSelectElement>("[data-alert-prop-role]")?.value ?? "note"
    const message =
      preview.querySelector<HTMLInputElement>("[data-alert-prop-content]")?.value.trim() ||
      "Alert message"

    preview.querySelectorAll<HTMLElement>("[data-playground-alert]").forEach((alert) => {
      alert.hidden = alert.dataset.variant !== variant
      alert.setAttribute("role", role)
      const title = alert.querySelector("strong")
      const body = alert.querySelector<HTMLElement>("[data-alert-prop-message]")
      if (title) title.textContent = variant
      if (body) body.textContent = message
    })

    const readout = preview.querySelector<HTMLElement>("[data-alert-prop-readout]")
    if (readout) {
      readout.textContent = `<Alert variant="${variant}" role="${role}">${message}</Alert>`
    }
  }

  document.addEventListener("input", (event) => {
    const control = (event.target as HTMLElement).closest(
      "[data-alert-prop-variant], [data-alert-prop-role], [data-alert-prop-content]"
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="alert-preview"]')
    if (preview) syncAlertPlayground(preview)
  })
</script>
