---
import astroPopoverSource from "../../../../../generated/astro/popover/popover.astro?raw"
import reactPopoverSource from "../../../../../generated/react/popover/popover.tsx?raw"
import ComponentSource from "../ComponentSource.astro"
import PopoverPreview from "../previews/PopoverPreview.astro"
import { popoverPreviewSources } from "../../data/catalogPreviewSources"

const popoverSources = [
  {
    code: astroPopoverSource,
    filename: "generated/astro/popover/popover.astro",
    framework: "Astro · Popover",
    language: "astro" as const,
  },
  {
    code: reactPopoverSource,
    filename: "generated/react/popover/popover.tsx",
    framework: "React · Popover",
    language: "tsx" as const,
  },
]

const astroUsage = `---
import PopoverLink from "@/ui/popover/popover-link.astro"
import PopoverDescription from "@/ui/popover/popover-description.astro"
import PopoverTitle from "@/ui/popover/popover-title.astro"
import PopoverHeader from "@/ui/popover/popover-header.astro"
import Button from "@/ui/button/button.astro"
import Popover from "@/ui/popover/popover.astro"
---

<Button popovertarget="account-actions">Account</Button>

<Popover id="account-actions" placement="bottom-end" aria-label="Account actions">
  <PopoverHeader
    ><div>
      <PopoverTitle>Samuel Hulla</PopoverTitle><PopoverDescription
        >samuel@hulla.dev</PopoverDescription
      >
    </div></PopoverHeader
  >
  <PopoverLink href="/profile">View profile</PopoverLink>
  <Button variant="outline" popovertarget="account-actions" popovertargetaction="hide">
    Close
  </Button>
</Popover>`

const reactUsage = `import { PopoverLink, PopoverDescription, PopoverTitle, PopoverHeader, Popover } from "@/ui/popover"
import { Button } from "@/ui/button"

export function AccountActions() {
  return (
    <>
      <Button popoverTarget="account-actions">Account</Button>

      <Popover id="account-actions" placement="bottom-end" aria-label="Account actions">
        <PopoverHeader>
          <div>
            <PopoverTitle>Samuel Hulla</PopoverTitle>
            <PopoverDescription>samuel@hulla.dev</PopoverDescription>
          </div>
        </PopoverHeader>
        <PopoverLink href="/profile">View profile</PopoverLink>
        <Button variant="outline" popoverTarget="account-actions" popoverTargetAction="hide">
          Close
        </Button>
      </Popover>
    </>
  )
}`

const usageSources = [
  {
    code: astroUsage,
    filename: "src/components/account-actions.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactUsage,
    filename: "src/components/account-actions.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="popover" aria-labelledby="popover-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Overlay</p>
      <h2 id="popover-title">Popover</h2>
    </div>
    <span class="status">Native anchored</span>
  </div>

  <article class="bench glass-panel" aria-label="Popover component preview">
    <div class="workbench workbench--popover">
      <PopoverPreview />

      <ComponentSource
        component="Popover"
        generatedFamilies={["popover"]}
        previewSources={popoverPreviewSources}
        sources={popoverSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>

<script>
  document.addEventListener("input", (event) => {
    const control = (event.target as HTMLElement).closest<HTMLSelectElement>(
      "[data-popover-prop-placement]"
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="popover-preview"]')
    if (!control || !preview) return

    preview.querySelectorAll<HTMLElement>("[data-popover-prop-case]").forEach((item) => {
      const popover = item.querySelector<HTMLElement>("[popover]")
      if (item.dataset.placement !== control.value && popover?.matches(":popover-open")) {
        popover.hidePopover()
      }
      item.hidden = item.dataset.placement !== control.value
    })

    const readout = preview.querySelector<HTMLElement>("[data-popover-prop-readout]")
    if (readout) readout.textContent = `<Popover placement="${control.value}" />`
  })
</script>
