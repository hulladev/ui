---
import { fileUploadPreviewSources } from "../../data/catalogPreviewSources"
import ComponentSource from "../ComponentSource.astro"
import FileUploadPreview from "../previews/FileUploadPreview.astro"
const usageSources = [
  {
    code: `---
import FileDropzoneIcon from "@/ui/file-upload/file-dropzone-icon.astro"
import FileDropzoneDescription from "@/ui/file-upload/file-dropzone-description.astro"
import FileDropzoneTitle from "@/ui/file-upload/file-dropzone-title.astro"
import FileUpload from "@/ui/file-upload/file-upload.astro"
import FileDropzone from "@/ui/file-upload/file-dropzone.astro"
---

<FileDropzone>
  <FileDropzoneIcon aria-hidden="true"
    ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
      ><path d="M12 16V4m-5 5 5-5 5 5M4 16v4h16v-4"></path></svg
    ></FileDropzoneIcon
  >
  <FileDropzoneTitle>Drop your files here</FileDropzoneTitle>
  <FileDropzoneDescription>or click to browse your device</FileDropzoneDescription>
  <FileUpload name="attachments" aria-label="Attachments" multiple />
</FileDropzone>`,
    filename: "src/components/file-upload.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import {
  FileDropzoneIcon,
  FileDropzoneDescription,
  FileDropzoneTitle,
  FileDropzone,
  FileUpload,
} from "@/ui/file-upload"

export function Attachments() {
  return (
    <FileDropzone>
      <FileDropzoneIcon aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M12 16V4m-5 5 5-5 5 5M4 16v4h16v-4" />
        </svg>
      </FileDropzoneIcon>
      <FileDropzoneTitle>Drop your files here</FileDropzoneTitle>
      <FileDropzoneDescription>or click to browse your device</FileDropzoneDescription>
      <FileUpload name="attachments" aria-label="Attachments" multiple />
    </FileDropzone>
  )
}`,
    filename: "src/components/file-upload.tsx",
    framework: "React",
    language: "tsx" as const,
  },
  {
    code: `import {
  FileDropzoneIcon,
  FileDropzoneDescription,
  FileDropzoneTitle,
  FileDropzone,
  FileUpload,
} from "@/ui/file-upload"

export function Attachments() {
  return (
    <FileDropzone>
      <FileDropzoneIcon aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M12 16V4m-5 5 5-5 5 5M4 16v4h16v-4" />
        </svg>
      </FileDropzoneIcon>
      <FileDropzoneTitle>Drop your files here</FileDropzoneTitle>
      <FileDropzoneDescription>or click to browse your device</FileDropzoneDescription>
      <FileUpload name="attachments" aria-label="Attachments" multiple />
    </FileDropzone>
  )
}`,
    filename: "src/components/file-upload.tsx",
    framework: "Solid",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="file-upload" aria-labelledby="file-upload-title">
  <div class="section-head">
    <div><p class="eyebrow">Primitive / Forms</p><h2 id="file-upload-title">File Upload</h2></div>
    <span class="status">Native file selection</span>
  </div>
  <article class="bench glass-panel" aria-label="FileUpload component preview">
    <div class="workbench">
      <FileUploadPreview />
      <ComponentSource
        component="FileUpload"
        generatedFamilies={["file-upload"]}
        previewSources={fileUploadPreviewSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>
