---
import AvatarFallback from "../../../../../generated/astro/avatar/avatar-fallback.astro"
import Avatar from "../../../../../generated/astro/avatar/avatar.astro"
import Button from "../../../../../generated/astro/button/button.astro"
import HoverCard from "../../../../../generated/astro/hover-card/hover-card.astro"
import Tooltip from "../../../../../generated/astro/tooltip/tooltip.astro"
import astroHoverCardSource from "../../../../../generated/astro/hover-card/hover-card.astro?raw"
import astroTooltipSource from "../../../../../generated/astro/tooltip/tooltip.astro?raw"
import reactHoverCardSource from "../../../../../generated/react/hover-card/hover-card.tsx?raw"
import reactTooltipSource from "../../../../../generated/react/tooltip/tooltip.tsx?raw"
import manifest from "../../../../../generated/ui.manifest.json"
import { floatingPreviewSources } from "../../data/catalogPreviewSources"
import ComponentPreview from "../ComponentPreview.astro"
import ComponentSource from "../ComponentSource.astro"

const tooltip = manifest.library.components.tooltip
const hoverCard = manifest.library.components["hover-card"]
const placements = ["top", "right", "bottom", "left"] as const

const componentSources = [
  {
    code: astroTooltipSource,
    filename: "generated/astro/tooltip/tooltip.astro",
    framework: "Astro · Tooltip",
    language: "astro" as const,
  },
  {
    code: reactTooltipSource,
    filename: "generated/react/tooltip/tooltip.tsx",
    framework: "React · Tooltip",
    language: "tsx" as const,
  },
  {
    code: astroHoverCardSource,
    filename: "generated/astro/hover-card/hover-card.astro",
    framework: "Astro · HoverCard",
    language: "astro" as const,
  },
  {
    code: reactHoverCardSource,
    filename: "generated/react/hover-card/hover-card.tsx",
    framework: "React · HoverCard",
    language: "tsx" as const,
  },
]

const astroUsage = `---
import Button from "@/ui/button/button.astro"
import HoverCard from "@/ui/hover-card/hover-card.astro"
import Tooltip from "@/ui/tooltip/tooltip.astro"
---

<Button id="archive-trigger" aria-describedby="archive-tooltip">
  Archive
</Button>
<Tooltip id="archive-tooltip" triggerId="archive-trigger">
  Move this release to the archive
</Tooltip>

<a id="author-trigger" href="/people/sora" aria-details="author-card">
  Sora Kim
</a>
<HoverCard id="author-card" triggerId="author-trigger">
  <strong>Sora Kim</strong>
  <p>Design systems engineer · Prague</p>
</HoverCard>`

const reactUsage = `import { Button } from "@/ui/button"
import { HoverCard } from "@/ui/hover-card"
import { Tooltip } from "@/ui/tooltip"

export function ReleaseMeta() {
  return (
    <>
      <Button id="archive-trigger" aria-describedby="archive-tooltip">
        Archive
      </Button>
      <Tooltip id="archive-tooltip" triggerId="archive-trigger">
        Move this release to the archive
      </Tooltip>

      <a id="author-trigger" href="/people/sora" aria-details="author-card">
        Sora Kim
      </a>
      <HoverCard id="author-card" triggerId="author-trigger">
        <strong>Sora Kim</strong>
        <p>Design systems engineer · Prague</p>
      </HoverCard>
    </>
  )
}`

const usageSources = [
  {
    code: astroUsage,
    filename: "src/components/release-meta.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactUsage,
    filename: "src/components/release-meta.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="floating" aria-labelledby="floating-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Transient overlay</p>
      <h2 id="floating-title">Tooltip + HoverCard</h2>
    </div>
    <span class="status">Native layer · JS position</span>
  </div>

  <article class="bench glass-panel" aria-label="Tooltip and HoverCard component preview">
    <div class="workbench">
      <ComponentPreview
        component="Floating"
        hint="Hover, focus, or press Escape"
        requirePropsView={true}
        propsLabel="Placement"
      >
        <div
          slot="variants"
          class="grid min-h-80 place-items-center overflow-hidden rounded-lg bg-surface/65 p-8"
        >
          <div class="grid w-full max-w-2xl gap-8 md:grid-cols-2">
            <section
              class="grid content-between gap-8 rounded-lg border border-border bg-surface-raised/75 p-5"
            >
              <div class="grid gap-2">
                <span class="font-mono text-xs tracking-wider text-primary uppercase"
                  >Fast annotation</span
                >
                <strong class="text-lg tracking-tight">Tooltip</strong>
                <p class="m-0 text-xs leading-6 text-muted-foreground">
                  Descriptive text linked explicitly with <code>aria-describedby</code>.
                </p>
              </div>

              <div class="flex items-center gap-3">
                <Button
                  id="catalog-tooltip-trigger"
                  variant="outline"
                  aria-describedby="catalog-tooltip"
                >
                  Queue release
                </Button>
                <Tooltip id="catalog-tooltip" triggerId="catalog-tooltip-trigger" placement="top">
                  Adds this build to the next release train
                </Tooltip>
                <span class="font-mono text-[0.65rem] text-muted-foreground">180 ms</span>
              </div>
            </section>

            <section
              class="grid content-between gap-8 rounded-lg border border-border bg-surface-raised/75 p-5"
            >
              <div class="grid gap-2">
                <span class="font-mono text-xs tracking-wider text-primary uppercase"
                  >Rich preview</span
                >
                <strong class="text-lg tracking-tight">HoverCard</strong>
                <p class="m-0 text-xs leading-6 text-muted-foreground">
                  Supplementary content that remains open when the pointer or focus moves inside.
                </p>
              </div>

              <div class="flex items-center gap-3">
                <Avatar aria-hidden="true">
                  <AvatarFallback class="bg-primary/15 text-primary">SK</AvatarFallback>
                </Avatar>
                <a
                  id="catalog-hover-card-trigger"
                  class="font-medium text-foreground underline decoration-primary/45 underline-offset-4"
                  href="#floating"
                  aria-details="catalog-hover-card"
                >
                  Sora Kim
                </a>
                <HoverCard
                  id="catalog-hover-card"
                  triggerId="catalog-hover-card-trigger"
                  aria-label="About Sora Kim"
                >
                  <div class="grid gap-4">
                    <div class="flex items-start gap-3">
                      <Avatar size="lg" aria-hidden="true">
                        <AvatarFallback class="bg-primary/15 text-primary">SK</AvatarFallback>
                      </Avatar>
                      <div class="grid gap-0.5">
                        <strong class="text-base">Sora Kim</strong>
                        <span class="text-xs text-muted-foreground">@sora · Prague</span>
                      </div>
                    </div>
                    <p class="m-0 text-xs leading-6 text-muted-foreground">
                      Design systems engineer making complex product surfaces feel inevitable.
                    </p>
                    <div class="flex gap-5 border-t border-border pt-3 text-xs">
                      <span><strong>42</strong> components</span>
                      <span><strong>1.8k</strong> followers</span>
                    </div>
                    <Button size="sm" variant="outline">View profile</Button>
                  </div>
                </HoverCard>
              </div>
            </section>
          </div>
        </div>

        <div slot="props" class="prop-playground">
          <div class="prop-controls">
            <label class="prop-control prop-control--wide">
              <span class="label">Tooltip placement</span>
              <select aria-label="Tooltip placement" data-floating-placement>
                {
                  placements.map((placement) => (
                    <option value={placement} selected={placement === "top"}>
                      {placement}
                    </option>
                  ))
                }
              </select>
            </label>
          </div>

          <div class="playground-stage playground-stage--overlay">
            {
              placements.map((placement) => {
                const triggerId = `catalog-floating-${placement}-trigger`
                const tooltipId = `catalog-floating-${placement}`
                return (
                  <div data-floating-case data-placement={placement} hidden={placement !== "top"}>
                    <Button id={triggerId} variant="outline" aria-describedby={tooltipId}>
                      Hover or focus
                    </Button>
                    <Tooltip
                      id={tooltipId}
                      triggerId={triggerId}
                      placement={placement}
                      openDelay={150}
                    >
                      Floating UI resolved: {placement}
                    </Tooltip>
                  </div>
                )
              })
            }
          </div>

          <code class="prop-readout" data-floating-readout aria-live="polite"
            >&lt;Tooltip placement="top" /&gt;</code
          >
        </div>

        <dl slot="facts" class="facts">
          <div class="fact">
            <dt class="label">Available in</dt>
            <dd>{tooltip.frameworks.join(" · ")} · {hoverCard.frameworks.join(" · ")}</dd>
          </div>
          <div class="fact">
            <dt class="label">Layering</dt>
            <dd>Native Popover top layer</dd>
          </div>
          <div class="fact">
            <dt class="label">Positioning</dt>
            <dd>Floating UI flip · shift · auto-update</dd>
          </div>
          <div class="fact">
            <dt class="label">Input</dt>
            <dd>Pointer hover · keyboard focus · Escape</dd>
          </div>
        </dl>
      </ComponentPreview>

      <ComponentSource
        component="Tooltip + HoverCard"
        generatedFamilies={["tooltip", "hover-card"]}
        previewSources={floatingPreviewSources}
        sources={componentSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>

<script>
  document.addEventListener("input", (event) => {
    const control = (event.target as HTMLElement).closest<HTMLSelectElement>(
      "[data-floating-placement]"
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="floating-preview"]')
    if (!control || !preview) return

    preview.querySelectorAll<HTMLElement>("[data-floating-case]").forEach((item) => {
      const surface = item.querySelector<HTMLElement>("[popover]")
      if (item.dataset.placement !== control.value && surface?.matches(":popover-open")) {
        surface.hidePopover()
      }
      item.hidden = item.dataset.placement !== control.value
    })

    const readout = preview.querySelector<HTMLElement>("[data-floating-readout]")
    if (readout) readout.textContent = `<Tooltip placement="${control.value}" />`
  })
</script>
