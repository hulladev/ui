---
import { Search } from "@lucide/astro"
import Button from "@/ui/button/button.astro"
import Kbd from "@/ui/kbd/kbd.astro"
---

<header class="masthead">
  <div>
    <p class="eyebrow">Component development environment</p>
    <h1>Component foundry.</h1>
    <p class="lede">
      Inspect generated components under real framework compilation, switch contrast, and exercise
      keyboard states before anything reaches the CLI source registry.
    </p>
  </div>

  <Button
    class="catalog-command-trigger justify-between gap-5"
    variant="outline"
    aria-controls="catalog-navigation-dialog"
    aria-haspopup="dialog"
    aria-keyshortcuts="Meta+K Control+K"
    data-open-catalog-command
  >
    <span class="flex items-center gap-2">
      <Search aria-hidden="true" />
      Search catalog
    </span>
    <span class="flex items-center gap-1" aria-hidden="true"><Kbd>⌘</Kbd><Kbd>K</Kbd></span>
  </Button>
</header>
