---
import { Search } from "@lucide/astro"
import Button from "@/ui/button/button.astro"
import Kbd from "@/ui/kbd/kbd.astro"
import { catalogPages } from "../../data/catalogNavigation"
type Props = { group: string; description: string; pageNumber: number }
const { group, description, pageNumber } = Astro.props
---

<header class="masthead">
  <div>
    <p class="eyebrow">
      Component foundry · {String(pageNumber).padStart(2, "0")} / {
        String(catalogPages.length).padStart(2, "0")
      }
    </p>
    <h1>{group}.</h1>
    <p class="lede">{description}</p>
  </div>

  <Button
    class="catalog-command-trigger justify-between gap-5"
    variant="outline"
    aria-controls="catalog-navigation-dialog"
    aria-haspopup="dialog"
    aria-keyshortcuts="Meta+K Control+K"
    data-open-catalog-command
  >
    <span class="flex items-center gap-2">
      <Search aria-hidden="true" />
      Search catalog
    </span>
    <span class="flex items-center gap-1" aria-hidden="true"><Kbd>⌘</Kbd><Kbd>K</Kbd></span>
  </Button>
</header>
