---
import Button from "../../../../../generated/astro/button/button.astro"
import CardContent from "../../../../../generated/astro/card/card-content.astro"
import CardDescription from "../../../../../generated/astro/card/card-description.astro"
import CardFooter from "../../../../../generated/astro/card/card-footer.astro"
import CardHeader from "../../../../../generated/astro/card/card-header.astro"
import CardTitle from "../../../../../generated/astro/card/card-title.astro"
import Card from "../../../../../generated/astro/card/card.astro"
import astroCardSource from "../../../../../generated/astro/card/card.astro?raw"
import reactCardSource from "../../../../../generated/react/card/card.tsx?raw"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"
import ComponentSource from "../ComponentSource.astro"
import { cardPreviewSources } from "../../data/catalogPreviewSources"

const card = manifest.library.components.card
const cardVariants = ["outline", "elevated", "ghost"] as const

const cardSources = [
  {
    code: astroCardSource,
    filename: "generated/astro/card/card.astro",
    framework: "Astro · Card",
    language: "astro" as const,
  },
  {
    code: reactCardSource,
    filename: "generated/react/card/card.tsx",
    framework: "React · Card",
    language: "tsx" as const,
  },
]

const astroUsage = `---
import Button from "@/ui/button/button.astro"
import CardContent from "@/ui/card/card-content.astro"
import CardDescription from "@/ui/card/card-description.astro"
import CardFooter from "@/ui/card/card-footer.astro"
import CardHeader from "@/ui/card/card-header.astro"
import CardTitle from "@/ui/card/card-title.astro"
import Card from "@/ui/card/card.astro"
---

<Card aria-labelledby="release-card-title">
  <CardHeader>
    <CardTitle id="release-card-title">Release candidate ready</CardTitle>
    <CardDescription>All required checks passed seven minutes ago.</CardDescription>
  </CardHeader>

  <CardContent>
    <p>Version 2.8.0 can move to the production channel.</p>
  </CardContent>

  <CardFooter>
    <Button size="sm">Review release</Button>
    <Button size="sm" variant="outline">View checks</Button>
  </CardFooter>
</Card>`

const reactUsage = `import { Button } from "@/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/ui/card"

export function ReleaseCard() {
  return (
    <Card aria-labelledby="release-card-title">
      <CardHeader>
        <CardTitle id="release-card-title">Release candidate ready</CardTitle>
        <CardDescription>All required checks passed seven minutes ago.</CardDescription>
      </CardHeader>

      <CardContent>
        <p>Version 2.8.0 can move to the production channel.</p>
      </CardContent>

      <CardFooter>
        <Button size="sm">Review release</Button>
        <Button size="sm" variant="outline">
          View checks
        </Button>
      </CardFooter>
    </Card>
  )
}`

const usageSources = [
  {
    code: astroUsage,
    filename: "src/components/release-card.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactUsage,
    filename: "src/components/release-card.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="card" aria-labelledby="card-section-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Surface</p>
      <h2 id="card-section-title">Card</h2>
    </div>
    <span class="status">Composes natively</span>
  </div>

  <article class="bench glass-panel" aria-label="Card component preview">
    <div class="workbench workbench--card">
      <ComponentPreview
        component="Card"
        hint="Semantic article"
        requirePropsView={true}
        variantsLabel="Styles"
      >
        <div slot="variants" class="grid gap-4">
          <Card variant="elevated" aria-labelledby="catalog-release-title">
            <CardHeader>
              <div
                class="mb-1 flex items-center justify-between gap-4 font-mono text-xs tracking-wider text-muted-foreground uppercase"
              >
                <span>Elevated / Release 024</span>
                <span class="flex items-center gap-1.5 text-foreground">
                  <i
                    class="size-2 rounded-full bg-success shadow-[0_0_0_4px_color-mix(in_oklab,var(--color-success)_16%,transparent)]"
                  ></i>
                  Ready
                </span>
              </div>
              <CardTitle id="catalog-release-title">Candidate approved for production.</CardTitle>
              <CardDescription>
                The release train is clear. All required checks completed seven minutes ago.
              </CardDescription>
            </CardHeader>

            <CardContent>
              <div class="grid gap-5">
                <div
                  class="grid grid-cols-3 overflow-hidden rounded-md border border-border bg-surface-raised/70 max-[760px]:grid-cols-1"
                >
                  <span
                    class="grid gap-0.5 border-l border-border px-4 py-3 first:border-l-0 max-[760px]:border-t max-[760px]:border-l-0 max-[760px]:first:border-t-0"
                  >
                    <strong class="text-lg tracking-tight">18</strong>
                    <small class="text-xs text-muted-foreground">checks passed</small>
                  </span>
                  <span
                    class="grid gap-0.5 border-l border-border px-4 py-3 first:border-l-0 max-[760px]:border-t max-[760px]:border-l-0"
                  >
                    <strong class="text-lg tracking-tight">0</strong>
                    <small class="text-xs text-muted-foreground">open blockers</small>
                  </span>
                  <span
                    class="grid gap-0.5 border-l border-border px-4 py-3 first:border-l-0 max-[760px]:border-t max-[760px]:border-l-0"
                  >
                    <strong class="text-lg tracking-tight">4m</strong>
                    <small class="text-xs text-muted-foreground">build time</small>
                  </span>
                </div>
                <div
                  class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3"
                  aria-label="Release readiness: 100%"
                >
                  <span class="font-mono text-xs font-medium tracking-wider uppercase"
                    >Readiness</span
                  >
                  <span
                    class="h-1 overflow-hidden rounded-full bg-foreground/10"
                    aria-hidden="true"
                  >
                    <i class="block h-full w-full rounded-[inherit] bg-primary"></i>
                  </span>
                  <strong class="font-mono text-xs font-medium">100%</strong>
                </div>
              </div>
            </CardContent>

            <CardFooter>
              <Button size="sm">Review release</Button>
              <Button size="sm" variant="outline">View checks</Button>
              <span
                class="ml-auto font-mono text-xs text-muted-foreground max-[760px]:ml-0 max-[760px]:w-full"
              >
                Updated 7m ago
              </span>
            </CardFooter>
          </Card>

          <div
            class="grid grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] gap-4 max-[760px]:grid-cols-1"
          >
            <Card variant="outline" aria-labelledby="catalog-velocity-title">
              <CardHeader>
                <span class="font-mono text-xs font-medium tracking-wider uppercase"
                  >Outline / Cycle velocity</span
                >
                <CardTitle id="catalog-velocity-title">4.2 days</CardTitle>
                <CardDescription>Median time to production</CardDescription>
              </CardHeader>
              <CardContent>
                <div class="flex h-14 items-end gap-1" aria-label="Velocity improved 16 percent">
                  <span class="h-[46%] w-1.5 rounded-t-full bg-primary"></span>
                  <span class="h-[58%] w-1.5 rounded-t-full bg-primary"></span>
                  <span class="h-[52%] w-1.5 rounded-t-full bg-primary"></span>
                  <span class="h-[68%] w-1.5 rounded-t-full bg-primary"></span>
                  <span class="h-[63%] w-1.5 rounded-t-full bg-primary"></span>
                  <span class="h-[82%] w-1.5 rounded-t-full bg-primary"></span>
                  <strong class="ml-auto self-end font-mono text-xs font-medium text-success">
                    −16%
                  </strong>
                </div>
              </CardContent>
            </Card>

            <Card variant="ghost" aria-labelledby="catalog-note-title">
              <CardHeader>
                <span class="font-mono text-xs text-primary">Ghost / 01</span>
                <CardTitle id="catalog-note-title">Native by default.</CardTitle>
              </CardHeader>
              <CardContent>
                <p>
                  Every part accepts native attributes. Classes merge last, so a card can become a
                  metric, notice, or full workflow surface without another prop.
                </p>
              </CardContent>
            </Card>
          </div>
        </div>

        <div slot="props" class="prop-playground">
          <div class="prop-controls prop-controls--toggles">
            <label class="prop-control prop-control--wide">
              <span class="label">Variant</span>
              <select aria-label="Card variant" data-card-prop-variant>
                <option value="outline">Outline</option>
                <option value="elevated">Elevated</option>
                <option value="ghost">Ghost</option>
              </select>
            </label>

            <label class="prop-disabled">
              <input type="checkbox" checked data-card-prop-description />
              <span class="toggle-track" aria-hidden="true"><span></span></span>
              <span class="label">Description</span>
            </label>
            <label class="prop-disabled">
              <input type="checkbox" checked data-card-prop-content />
              <span class="toggle-track" aria-hidden="true"><span></span></span>
              <span class="label">Content</span>
            </label>
            <label class="prop-disabled">
              <input type="checkbox" checked data-card-prop-footer />
              <span class="toggle-track" aria-hidden="true"><span></span></span>
              <span class="label">Footer</span>
            </label>
          </div>

          <div class="playground-stage playground-stage--card">
            {
              cardVariants.map((variant) => (
                <Card
                  variant={variant}
                  aria-labelledby={`card-prop-title-${variant}`}
                  class="w-full max-w-[27rem]"
                  data-playground-card
                  hidden={variant !== "outline"}
                >
                  <CardHeader>
                    <span class="font-mono text-xs font-medium tracking-wider uppercase">
                      Release / 024
                    </span>
                    <CardTitle id={`card-prop-title-${variant}`}>Candidate ready.</CardTitle>
                    <CardDescription data-card-prop-part="description">
                      All required checks passed seven minutes ago.
                    </CardDescription>
                  </CardHeader>
                  <CardContent data-card-prop-part="content">
                    <strong>18 checks passed</strong>
                  </CardContent>
                  <CardFooter data-card-prop-part="footer">
                    <Button size="sm">Review release</Button>
                  </CardFooter>
                </Card>
              ))
            }
          </div>

          <code class="prop-readout" data-card-prop-readout aria-live="polite"
            >&lt;Card&gt;Header + Content + Footer&lt;/Card&gt;</code
          >
        </div>

        <dl slot="facts" class="facts">
          <div class="fact">
            <dt class="label">Available in</dt>
            <dd>{card.frameworks.join(" · ")}</dd>
          </div>
          <div class="fact">
            <dt class="label">Compound parts</dt>
            <dd>6 semantic exports</dd>
          </div>
          <div class="fact">
            <dt class="label">Custom props</dt>
            <dd>variant · native HTML</dd>
          </div>
        </dl>
      </ComponentPreview>

      <ComponentSource
        component="Card"
        generatedFamilies={["card"]}
        previewSources={cardPreviewSources}
        sources={cardSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncCardPlayground = (preview: HTMLElement) => {
    const variant =
      preview.querySelector<HTMLSelectElement>("[data-card-prop-variant]")?.value ?? "outline"
    const parts = ["description", "content", "footer"] as const
    const visible: string[] = ["Header"]

    preview.querySelectorAll<HTMLElement>("[data-playground-card]").forEach((card) => {
      card.hidden = card.dataset.variant !== variant
    })

    parts.forEach((part) => {
      const checked =
        preview.querySelector<HTMLInputElement>(`[data-card-prop-${part}]`)?.checked ?? true
      preview
        .querySelectorAll<HTMLElement>(`[data-card-prop-part="${part}"]`)
        .forEach((element) => {
          element.hidden = !checked
        })
      if (checked) visible.push(part[0]?.toUpperCase() + part.slice(1))
    })

    const readout = preview.querySelector<HTMLElement>("[data-card-prop-readout]")
    if (readout) {
      readout.textContent = `<Card variant="${variant}">${visible.join(" + ")}</Card>`
    }
  }

  document.addEventListener("previewmodechange", (event) => {
    const preview = (event.target as HTMLElement).closest<HTMLElement>(
      '[data-preview-component="card-preview"]'
    )
    if (preview && (event as CustomEvent<{ mode?: string }>).detail.mode === "props") {
      syncCardPlayground(preview)
    }
  })

  document.addEventListener("change", (event) => {
    const control = (event.target as HTMLElement).closest(
      [
        "[data-card-prop-variant]",
        "[data-card-prop-description]",
        "[data-card-prop-content]",
        "[data-card-prop-footer]",
      ].join(",")
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="card-preview"]')
    if (preview) syncCardPlayground(preview)
  })
</script>
