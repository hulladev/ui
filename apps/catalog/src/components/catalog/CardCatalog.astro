---
import astroCardSource from "../../../../../generated/astro/card/card.astro?raw"
import reactCardSource from "../../../../../generated/react/card/card.tsx?raw"
import ComponentSource from "../ComponentSource.astro"
import CardPreview from "../previews/CardPreview.astro"
import { cardPreviewSources } from "../../data/catalogPreviewSources"

const cardSources = [
  {
    code: astroCardSource,
    filename: "generated/astro/card/card.astro",
    framework: "Astro · Card",
    language: "astro" as const,
  },
  {
    code: reactCardSource,
    filename: "generated/react/card/card.tsx",
    framework: "React · Card",
    language: "tsx" as const,
  },
]

const astroUsage = `---
import Button from "@/ui/button/button.astro"
import CardContent from "@/ui/card/card-content.astro"
import CardDescription from "@/ui/card/card-description.astro"
import CardFooter from "@/ui/card/card-footer.astro"
import CardHeader from "@/ui/card/card-header.astro"
import CardTitle from "@/ui/card/card-title.astro"
import Card from "@/ui/card/card.astro"
---

<Card aria-labelledby="release-card-title">
  <CardHeader>
    <CardTitle id="release-card-title">Release candidate ready</CardTitle>
    <CardDescription>All required checks passed seven minutes ago.</CardDescription>
  </CardHeader>

  <CardContent>
    <p>Version 2.8.0 can move to the production channel.</p>
  </CardContent>

  <CardFooter>
    <Button size="sm">Review release</Button>
    <Button size="sm" variant="outline">View checks</Button>
  </CardFooter>
</Card>`

const reactUsage = `import { Button } from "@/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/ui/card"

export function ReleaseCard() {
  return (
    <Card aria-labelledby="release-card-title">
      <CardHeader>
        <CardTitle id="release-card-title">Release candidate ready</CardTitle>
        <CardDescription>All required checks passed seven minutes ago.</CardDescription>
      </CardHeader>

      <CardContent>
        <p>Version 2.8.0 can move to the production channel.</p>
      </CardContent>

      <CardFooter>
        <Button size="sm">Review release</Button>
        <Button size="sm" variant="outline">
          View checks
        </Button>
      </CardFooter>
    </Card>
  )
}`

const usageSources = [
  {
    code: astroUsage,
    filename: "src/components/release-card.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactUsage,
    filename: "src/components/release-card.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="card" aria-labelledby="card-section-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Surface</p>
      <h2 id="card-section-title">Card</h2>
    </div>
    <span class="status">Composes natively</span>
  </div>

  <article class="bench glass-panel" aria-label="Card component preview">
    <div class="workbench workbench--card">
      <CardPreview />

      <ComponentSource
        component="Card"
        generatedFamilies={["card"]}
        previewSources={cardPreviewSources}
        sources={cardSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncCardPlayground = (preview: HTMLElement) => {
    const variant =
      preview.querySelector<HTMLSelectElement>("[data-card-prop-variant]")?.value ?? "outline"
    const parts = ["description", "content", "footer"] as const
    const visible: string[] = ["Header"]

    preview.querySelectorAll<HTMLElement>("[data-playground-card]").forEach((card) => {
      card.hidden = card.dataset.variant !== variant
    })

    parts.forEach((part) => {
      const checked =
        preview.querySelector<HTMLInputElement>(`[data-card-prop-${part}]`)?.checked ?? true
      preview
        .querySelectorAll<HTMLElement>(`[data-card-prop-part="${part}"]`)
        .forEach((element) => {
          element.hidden = !checked
        })
      if (checked) visible.push(part[0]?.toUpperCase() + part.slice(1))
    })

    const readout = preview.querySelector<HTMLElement>("[data-card-prop-readout]")
    if (readout) {
      readout.textContent = `<Card variant="${variant}">${visible.join(" + ")}</Card>`
    }
  }

  document.addEventListener("previewmodechange", (event) => {
    const preview = (event.target as HTMLElement).closest<HTMLElement>(
      '[data-preview-component="card-preview"]'
    )
    if (preview && (event as CustomEvent<{ mode?: string }>).detail.mode === "props") {
      syncCardPlayground(preview)
    }
  })

  document.addEventListener("change", (event) => {
    const control = (event.target as HTMLElement).closest(
      [
        "[data-card-prop-variant]",
        "[data-card-prop-description]",
        "[data-card-prop-content]",
        "[data-card-prop-footer]",
      ].join(",")
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="card-preview"]')
    if (preview) syncCardPlayground(preview)
  })
</script>
