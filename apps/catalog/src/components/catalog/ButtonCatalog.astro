---
import astroButtonGroupSource from "../../../../../generated/astro/button/button-group.astro?raw"
import astroButtonSource from "../../../../../generated/astro/button/button.astro?raw"
import reactButtonGroupSource from "../../../../../generated/react/button/button-group.tsx?raw"
import reactButtonSource from "../../../../../generated/react/button/button.tsx?raw"
import ComponentSource from "../ComponentSource.astro"
import ButtonPreview from "../previews/ButtonPreview.astro"
import { buttonPreviewSources } from "../../data/catalogPreviewSources"
const buttonSources = [
  {
    code: astroButtonGroupSource,
    filename: "generated/astro/button/button-group.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: astroButtonSource,
    filename: "generated/astro/button/button.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactButtonGroupSource,
    filename: "generated/react/button/button-group.tsx",
    framework: "React",
    language: "tsx" as const,
  },
  {
    code: reactButtonSource,
    filename: "generated/react/button/button.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]

const buttonUsageSources = [
  {
    code: `---
import Button from "@/ui/button/button.astro"
import ButtonGroup from "@/ui/button/button-group.astro"
---

<ButtonGroup aria-label="Document actions">
  <Button variant="outline">Preview</Button>
  <Button variant="outline">Duplicate</Button>
  <Button>Publish</Button>
</ButtonGroup>`,
    filename: "src/components/button-demo.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { Button, ButtonGroup } from "@/ui/button"

export function ButtonDemo() {
  return (
    <ButtonGroup aria-label="Document actions">
      <Button variant="outline">Preview</Button>
      <Button variant="outline">Duplicate</Button>
      <Button>Publish</Button>
    </ButtonGroup>
  )
}`,
    filename: "src/components/button-demo.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="button" aria-labelledby="button-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Action</p>
      <h2 id="button-title">Button</h2>
    </div>
    <span class="status">Generated cleanly</span>
  </div>

  <article class="bench glass-panel" aria-label="Button component preview">
    <div class="workbench">
      <ButtonPreview />

      <ComponentSource
        component="Button"
        generatedFamilies={["button"]}
        previewSources={buttonPreviewSources}
        sources={buttonSources}
        usageSources={buttonUsageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncButtonPlayground = (preview: HTMLElement) => {
    const variant =
      preview.querySelector<HTMLSelectElement>("[data-button-prop-variant]")?.value ?? "primary"
    const size = preview.querySelector<HTMLSelectElement>("[data-button-prop-size]")?.value ?? "md"
    const disabled =
      preview.querySelector<HTMLInputElement>("[data-button-prop-disabled]")?.checked ?? false

    preview.querySelectorAll<HTMLButtonElement>("[data-playground-button]").forEach((button) => {
      const selected = button.dataset.variant === variant && button.dataset.size === size
      button.hidden = !selected
      button.disabled = disabled
    })

    const readout = preview.querySelector<HTMLElement>("[data-prop-readout]")
    if (readout) {
      readout.textContent = `<Button variant="${variant}" size="${size}"${disabled ? " disabled" : ""} />`
    }
  }

  document.addEventListener("previewmodechange", (event) => {
    const preview = (event.target as HTMLElement).closest<HTMLElement>(
      '[data-preview-component="button-preview"]'
    )
    if (preview && (event as CustomEvent<{ mode?: string }>).detail.mode === "props") {
      syncButtonPlayground(preview)
    }
  })

  document.addEventListener("change", (event) => {
    const control = (event.target as HTMLElement).closest(
      ["[data-button-prop-variant]", "[data-button-prop-size]", "[data-button-prop-disabled]"].join(
        ","
      )
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="button-preview"]')
    if (preview) syncButtonPlayground(preview)
  })
</script>
