---
import astroProgressSource from "../../../../../generated/astro/progress/progress.astro?raw"
import reactProgressSource from "../../../../../generated/react/progress/progress.tsx?raw"
import { progressPreviewSources } from "../../data/catalogPreviewSources"
import ComponentSource from "../ComponentSource.astro"
import ProgressPreview from "../previews/ProgressPreview.astro"

const progressSources = [
  {
    code: astroProgressSource,
    filename: "generated/astro/progress/progress.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactProgressSource,
    filename: "generated/react/progress/progress.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]

const progressUsageSources = [
  {
    code: `---
import Progress from "@/ui/progress/progress.astro"
---

<label>
  Uploading assets
  <Progress value={68} max={100}>68%</Progress>
</label>`,
    filename: "src/components/upload-progress.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { Progress } from "@/ui/progress"

export function UploadProgress() {
  return (
    <label>
      Uploading assets
      <Progress value={68} max={100}>68%</Progress>
    </label>
  )
}`,
    filename: "src/components/upload-progress.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="progress" aria-labelledby="progress-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Feedback</p>
      <h2 id="progress-title">Progress</h2>
    </div>
    <span class="status">Native semantics</span>
  </div>

  <article class="bench glass-panel" aria-label="Progress component preview">
    <div class="workbench">
      <ProgressPreview />

      <ComponentSource
        component="Progress"
        generatedFamilies={["progress"]}
        previewSources={progressPreviewSources}
        sources={progressSources}
        usageSources={progressUsageSources}
      />
    </div>
  </article>
</section>

<script>
  const progressToneClasses = {
    primary: "text-primary",
    success: "text-success",
    warning: "text-warning",
  } as const

  const syncProgressPlayground = (preview: HTMLElement) => {
    const state =
      preview.querySelector<HTMLSelectElement>("[data-progress-state]")?.value ?? "determinate"
    const valueControl = preview.querySelector<HTMLInputElement>("[data-progress-value]")
    const value = Number(valueControl?.value ?? 68)
    const tone =
      preview.querySelector<HTMLSelectElement>("[data-progress-tone]")?.value ?? "primary"

    if (valueControl) valueControl.disabled = state === "indeterminate"

    preview
      .querySelectorAll<HTMLProgressElement>("[data-playground-progress]")
      .forEach((progress) => {
        progress.hidden = progress.dataset.tone !== tone
        if (state === "indeterminate") progress.removeAttribute("value")
        else progress.value = value
        progress.textContent = state === "indeterminate" ? "In progress" : `${value}%`
      })

    const readout = preview.querySelector<HTMLElement>("[data-progress-readout]")
    const toneClass = progressToneClasses[tone as keyof typeof progressToneClasses]
    if (readout) {
      readout.textContent =
        state === "indeterminate"
          ? `<Progress className="${toneClass}" />`
          : `<Progress value={${value}} max={100} className="${toneClass}" />`
    }
  }

  document.addEventListener("input", (event) => {
    const control = (event.target as HTMLElement).closest(
      "[data-progress-state], [data-progress-value], [data-progress-tone]"
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="progress-preview"]')
    if (preview) syncProgressPlayground(preview)
  })
</script>
