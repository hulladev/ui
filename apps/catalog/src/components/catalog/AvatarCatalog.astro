---
import ComponentSource from "../ComponentSource.astro"
import AvatarPreview from "../previews/AvatarPreview.astro"
import { avatarPreviewSources } from "../../data/catalogPreviewSources"

const avatarUsageSources = [
  {
    code: `---
import Avatar from "@/ui/avatar/avatar.astro"
import AvatarFallback from "@/ui/avatar/avatar-fallback.astro"
import AvatarImage from "@/ui/avatar/avatar-image.astro"
---

<Avatar>
  <AvatarFallback>SK</AvatarFallback>
  <AvatarImage src="/sora.jpg" alt="Sora Kim" />
</Avatar>`,
    filename: "src/components/account-avatar.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { Avatar, AvatarFallback, AvatarImage } from "@/ui/avatar"

export function AccountAvatar() {
  return (
    <Avatar>
      <AvatarFallback>SK</AvatarFallback>
      <AvatarImage src="/sora.jpg" alt="Sora Kim" />
    </Avatar>
  )
}`,
    filename: "src/components/account-avatar.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="avatar" aria-labelledby="avatar-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Identity</p>
      <h2 id="avatar-title">Avatar</h2>
    </div>
    <span class="status">Image-safe fallback</span>
  </div>

  <article class="bench glass-panel" aria-label="Avatar component preview">
    <div class="workbench workbench--avatar">
      <AvatarPreview />

      <ComponentSource
        component="Avatar"
        generatedFamilies={["avatar"]}
        previewSources={avatarPreviewSources}
        usageSources={avatarUsageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncAvatarPlayground = (preview: HTMLElement) => {
    const size = preview.querySelector<HTMLSelectElement>("[data-avatar-prop-size]")?.value ?? "md"
    const source =
      preview.querySelector<HTMLSelectElement>("[data-avatar-prop-source]")?.value ?? "image"
    const fallback =
      preview.querySelector<HTMLInputElement>("[data-avatar-prop-fallback]")?.value.trim() || "?"

    preview.querySelectorAll<HTMLElement>("[data-playground-avatar]").forEach((avatar) => {
      avatar.hidden = avatar.dataset.size !== size || avatar.dataset.source !== source
      const fallbackElement = avatar.querySelector<HTMLElement>("[data-playground-avatar-fallback]")
      if (fallbackElement) fallbackElement.textContent = fallback
    })

    const readout = preview.querySelector<HTMLElement>("[data-avatar-prop-readout]")
    if (readout) {
      readout.textContent =
        source === "image"
          ? `<Avatar role="img" size="${size}" aria-label="Sora Kim"><AvatarFallback>${fallback}</AvatarFallback><AvatarImage src="/sora.jpg" alt="" /></Avatar>`
          : `<Avatar role="img" size="${size}" aria-label="Sora Kim"><AvatarFallback>${fallback}</AvatarFallback></Avatar>`
    }
  }

  document.addEventListener("input", (event) => {
    const control = (event.target as HTMLElement).closest(
      "[data-avatar-prop-size], [data-avatar-prop-source], [data-avatar-prop-fallback]"
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="avatar-preview"]')
    if (preview) syncAvatarPlayground(preview)
  })
</script>
