---
import Avatar from "../../../../../generated/astro/avatar/avatar.astro"
import AvatarFallback from "../../../../../generated/astro/avatar/avatar-fallback.astro"
import AvatarImage from "../../../../../generated/astro/avatar/avatar-image.astro"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"
import ComponentSource from "../ComponentSource.astro"
import { avatarPreviewSources } from "../../data/catalogPreviewSources"

const avatar = manifest.library.components.avatar
const avatarSizes = ["sm", "md", "lg"] as const
// Exercise the image error state without making a request to the dev server.
const unavailableAvatarSrc = "data:image/svg+xml,%3Csvg"
const teammates = [
  {
    description: "Design systems",
    initials: "SK",
    name: "Sora Kim",
    src: "/avatar-sora.svg",
  },
  {
    description: "Product design",
    initials: "LM",
    name: "Lea Müller",
    src: undefined,
  },
  {
    description: "Engineering",
    initials: "AO",
    name: "Amara Okafor",
    src: undefined,
  },
] as const

const avatarUsageSources = [
  {
    code: `---
import Avatar from "@/ui/avatar/avatar.astro"
import AvatarFallback from "@/ui/avatar/avatar-fallback.astro"
import AvatarImage from "@/ui/avatar/avatar-image.astro"
---

<Avatar>
  <AvatarFallback>SK</AvatarFallback>
  <AvatarImage src="/sora.jpg" alt="Sora Kim" />
</Avatar>`,
    filename: "src/components/account-avatar.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { Avatar, AvatarFallback, AvatarImage } from "@/ui/avatar"

export function AccountAvatar() {
  return (
    <Avatar>
      <AvatarFallback>SK</AvatarFallback>
      <AvatarImage src="/sora.jpg" alt="Sora Kim" />
    </Avatar>
  )
}`,
    filename: "src/components/account-avatar.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="avatar" aria-labelledby="avatar-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Identity</p>
      <h2 id="avatar-title">Avatar</h2>
    </div>
    <span class="status">Image-safe fallback</span>
  </div>

  <article class="bench glass-panel" aria-label="Avatar component preview">
    <div class="workbench workbench--avatar">
      <ComponentPreview component="Avatar" hint="Non-interactive" requirePropsView={true}>
        <div slot="variants" class="grid gap-5">
          <div
            class="overflow-hidden rounded-lg border border-border bg-surface-raised shadow-xs"
            aria-label="Team directory example"
          >
            <div class="flex items-center justify-between border-b border-border px-4 py-3">
              <div>
                <p
                  class="font-mono text-[0.6875rem] font-medium tracking-wider text-muted-foreground uppercase"
                >
                  Project Atlas
                </p>
                <h3 class="mt-1 text-base font-semibold tracking-[-0.02em]">Core team</h3>
              </div>
              <span class="font-mono text-xs text-muted-foreground">03 / 03</span>
            </div>

            <div>
              {
                teammates.map(({ description, initials, name, src }, index) => (
                  <div class="flex items-center gap-3 border-t border-border px-4 py-3 first:border-t-0">
                    <Avatar role="img" aria-label={name}>
                      <AvatarFallback
                        class:list={[
                          index === 1 && "bg-primary/10 text-primary",
                          index === 2 && "bg-success/10 text-success",
                        ]}
                      >
                        {initials}
                      </AvatarFallback>
                      {src && <AvatarImage src={src} alt="" />}
                    </Avatar>
                    <span class="min-w-0 flex-1">
                      <strong class="block truncate text-sm font-medium">{name}</strong>
                      <small class="block truncate text-xs text-muted-foreground">
                        {description}
                      </small>
                    </span>
                    <span class="size-2 rounded-full bg-success" aria-label="Available" />
                  </div>
                ))
              }
            </div>
          </div>

          <div class="flex items-end justify-between gap-5 px-1">
            <span
              class="font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase"
            >
              Scale
            </span>
            <div class="flex items-end gap-4">
              {
                avatarSizes.map((size) => (
                  <span class="grid justify-items-center gap-2">
                    <Avatar role="img" size={size} aria-label={`Sora Kim, ${size} avatar`}>
                      <AvatarFallback>SK</AvatarFallback>
                      <AvatarImage src="/avatar-sora.svg" alt="" />
                    </Avatar>
                    <span class="font-mono text-[0.6875rem] text-muted-foreground">{size}</span>
                  </span>
                ))
              }
            </div>
          </div>

          <div class="flex items-center gap-3 rounded-md border border-dashed border-border p-3">
            <Avatar role="img" aria-label="Fallback example">
              <AvatarFallback class="bg-warning/10 text-warning">FX</AvatarFallback>
              <AvatarImage src={unavailableAvatarSrc} alt="" />
            </Avatar>
            <div>
              <strong class="block text-sm font-medium">Automatic fallback</strong>
              <small class="block text-xs text-muted-foreground">
                Shown when the image cannot be loaded
              </small>
            </div>
          </div>
        </div>

        <div slot="props" class="prop-playground">
          <div class="prop-controls">
            <label class="prop-control">
              <span class="label">Size</span>
              <select aria-label="Avatar size" data-avatar-prop-size>
                {
                  avatarSizes.map((size) => (
                    <option value={size} selected={size === "md"}>
                      {size}
                    </option>
                  ))
                }
              </select>
            </label>

            <label class="prop-control">
              <span class="label">Image</span>
              <select aria-label="Avatar image state" data-avatar-prop-source>
                <option value="image">Loaded</option>
                <option value="fallback">Unavailable</option>
              </select>
            </label>

            <label class="prop-control prop-control--wide">
              <span class="label">Fallback</span>
              <input type="text" value="SK" maxlength="3" data-avatar-prop-fallback />
            </label>
          </div>

          <div class="playground-stage">
            {
              (["image", "fallback"] as const).flatMap((source) =>
                avatarSizes.map((size) => (
                  <Avatar
                    role="img"
                    size={size}
                    aria-label="Sora Kim"
                    data-playground-avatar
                    data-source={source}
                    data-size={size}
                    hidden={source !== "image" || size !== "md"}
                  >
                    <AvatarFallback data-playground-avatar-fallback>SK</AvatarFallback>
                    <AvatarImage
                      src={source === "image" ? "/avatar-sora.svg" : unavailableAvatarSrc}
                      alt=""
                    />
                  </Avatar>
                ))
              )
            }
          </div>

          <code class="prop-readout" data-avatar-prop-readout aria-live="polite"
            >&lt;Avatar size="md"&gt;…&lt;/Avatar&gt;</code
          >
        </div>

        <dl slot="facts" class="facts">
          <div class="fact">
            <dt class="label">Available in</dt>
            <dd>{avatar.frameworks.join(" · ")}</dd>
          </div>
          <div class="fact">
            <dt class="label">Native elements</dt>
            <dd>span · img · span</dd>
          </div>
          <div class="fact">
            <dt class="label">Custom props</dt>
            <dd>size · native image attributes</dd>
          </div>
        </dl>
      </ComponentPreview>

      <ComponentSource
        component="Avatar"
        generatedFamilies={["avatar"]}
        previewSources={avatarPreviewSources}
        usageSources={avatarUsageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncAvatarPlayground = (preview: HTMLElement) => {
    const size = preview.querySelector<HTMLSelectElement>("[data-avatar-prop-size]")?.value ?? "md"
    const source =
      preview.querySelector<HTMLSelectElement>("[data-avatar-prop-source]")?.value ?? "image"
    const fallback =
      preview.querySelector<HTMLInputElement>("[data-avatar-prop-fallback]")?.value.trim() || "?"

    preview.querySelectorAll<HTMLElement>("[data-playground-avatar]").forEach((avatar) => {
      avatar.hidden = avatar.dataset.size !== size || avatar.dataset.source !== source
      const fallbackElement = avatar.querySelector<HTMLElement>("[data-playground-avatar-fallback]")
      if (fallbackElement) fallbackElement.textContent = fallback
    })

    const readout = preview.querySelector<HTMLElement>("[data-avatar-prop-readout]")
    if (readout) {
      readout.textContent =
        source === "image"
          ? `<Avatar role="img" size="${size}" aria-label="Sora Kim"><AvatarFallback>${fallback}</AvatarFallback><AvatarImage src="/sora.jpg" alt="" /></Avatar>`
          : `<Avatar role="img" size="${size}" aria-label="Sora Kim"><AvatarFallback>${fallback}</AvatarFallback></Avatar>`
    }
  }

  document.addEventListener("input", (event) => {
    const control = (event.target as HTMLElement).closest(
      "[data-avatar-prop-size], [data-avatar-prop-source], [data-avatar-prop-fallback]"
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="avatar-preview"]')
    if (preview) syncAvatarPlayground(preview)
  })
</script>
