---
import { stepperPreviewSources } from "../../data/catalogPreviewSources"
import ComponentSource from "../ComponentSource.astro"
import StepperPreview from "../previews/StepperPreview.astro"
const usageSources = [
  {
    code: `---
import StepperDescription from "@/ui/stepper/stepper-description.astro"
import StepperContent from "@/ui/stepper/stepper-content.astro"
import Stepper from "@/ui/stepper/stepper.astro"
import StepperItem from "@/ui/stepper/stepper-item.astro"
import StepperLink from "@/ui/stepper/stepper-link.astro"
import StepperIndicator from "@/ui/stepper/stepper-indicator.astro"
---

<nav aria-label="Checkout progress">
  <Stepper>
    <StepperItem state="complete">
      <StepperLink href="/cart"
        ><StepperIndicator>1</StepperIndicator><StepperContent
          ><span>Cart</span><StepperDescription>Review items</StepperDescription></StepperContent
        ></StepperLink
      >
    </StepperItem>
    <StepperItem state="current">
      <StepperLink href="/delivery"
        ><StepperIndicator>2</StepperIndicator><StepperContent
          ><span>Delivery</span><StepperDescription>Choose an address</StepperDescription
          ></StepperContent
        ></StepperLink
      >
    </StepperItem>
  </Stepper>
</nav>`,
    filename: "src/components/stepper.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import {
  StepperDescription,
  StepperContent,
  Stepper,
  StepperItem,
  StepperLink,
  StepperIndicator,
} from "@/ui/stepper"

export function CheckoutSteps() {
  return (
    <nav aria-label="Checkout progress">
      <Stepper>
        <StepperItem state="complete">
          <StepperLink href="/cart">
            <StepperIndicator>1</StepperIndicator>
            <StepperContent>
              <span>Cart</span>
              <StepperDescription>Review items</StepperDescription>
            </StepperContent>
          </StepperLink>
        </StepperItem>
        <StepperItem state="current">
          <StepperLink href="/delivery">
            <StepperIndicator>2</StepperIndicator>
            <StepperContent>
              <span>Delivery</span>
              <StepperDescription>Choose an address</StepperDescription>
            </StepperContent>
          </StepperLink>
        </StepperItem>
      </Stepper>
    </nav>
  )
}`,
    filename: "src/components/stepper.tsx",
    framework: "React",
    language: "tsx" as const,
  },
  {
    code: `import {
  StepperDescription,
  StepperContent,
  Stepper,
  StepperItem,
  StepperLink,
  StepperIndicator,
} from "@/ui/stepper"

export function CheckoutSteps() {
  return (
    <nav aria-label="Checkout progress">
      <Stepper>
        <StepperItem state="complete">
          <StepperLink href="/cart">
            <StepperIndicator>1</StepperIndicator>
            <StepperContent>
              <span>Cart</span>
              <StepperDescription>Review items</StepperDescription>
            </StepperContent>
          </StepperLink>
        </StepperItem>
        <StepperItem state="current">
          <StepperLink href="/delivery">
            <StepperIndicator>2</StepperIndicator>
            <StepperContent>
              <span>Delivery</span>
              <StepperDescription>Choose an address</StepperDescription>
            </StepperContent>
          </StepperLink>
        </StepperItem>
      </Stepper>
    </nav>
  )
}`,
    filename: "src/components/stepper.tsx",
    framework: "Solid",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="stepper" aria-labelledby="stepper-title">
  <div class="section-head">
    <div><p class="eyebrow">Primitive / Navigation</p><h2 id="stepper-title">Stepper</h2></div>
    <span class="status">Explicit progress</span>
  </div>
  <article class="bench glass-panel" aria-label="Stepper component preview">
    <div class="workbench">
      <StepperPreview />
      <ComponentSource
        component="Stepper"
        generatedFamilies={["stepper"]}
        previewSources={stepperPreviewSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>
