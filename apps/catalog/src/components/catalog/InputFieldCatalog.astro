---
import FieldDescription from "../../../../../generated/astro/field/field-description.astro"
import FieldError from "../../../../../generated/astro/field/field-error.astro"
import FieldLabel from "../../../../../generated/astro/field/field-label.astro"
import Field from "../../../../../generated/astro/field/field.astro"
import Input from "../../../../../generated/astro/input/input.astro"
import astroFieldSource from "../../../../../generated/astro/field/field.astro?raw"
import astroInputSource from "../../../../../generated/astro/input/input.astro?raw"
import reactFieldSource from "../../../../../generated/react/field/field.tsx?raw"
import reactInputSource from "../../../../../generated/react/input/input.tsx?raw"
import manifest from "../../../../../generated/ui.manifest.json"
import ComponentPreview from "../ComponentPreview.astro"
import ComponentSource from "../ComponentSource.astro"
import { inputPreviewSources } from "../../data/catalogPreviewSources"

const field = manifest.library.components.field
const input = manifest.library.components.input
const inputSizes = ["sm", "md", "lg"] as const
const inputVariants = ["outline", "filled", "underline"] as const
const inputSources = [
  {
    code: astroInputSource,
    filename: "generated/astro/input/input.astro",
    framework: "Astro · Input",
    language: "astro" as const,
  },
  {
    code: reactInputSource,
    filename: "generated/react/input/input.tsx",
    framework: "React · Input",
    language: "tsx" as const,
  },
  {
    code: astroFieldSource,
    filename: "generated/astro/field/field.astro",
    framework: "Astro · Field",
    language: "astro" as const,
  },
  {
    code: reactFieldSource,
    filename: "generated/react/field/field.tsx",
    framework: "React · Field",
    language: "tsx" as const,
  },
]

const inputUsageSources = [
  {
    code: `---
import FieldDescription from "@/ui/field/field-description.astro"
import FieldLabel from "@/ui/field/field-label.astro"
import Field from "@/ui/field/field.astro"
import Input from "@/ui/input/input.astro"
---

<Field>
  <FieldLabel for="workspace-name">Workspace name</FieldLabel>
  <Input
    id="workspace-name"
    name="workspace"
    placeholder="Orbit command"
    aria-describedby="workspace-help"
    required
  />
  <FieldDescription id="workspace-help">
    This appears in invitations and shared links.
  </FieldDescription>
</Field>`,
    filename: "src/components/workspace-field.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import {
  Field,
  FieldDescription,
  FieldLabel,
} from "@/ui/field"
import { Input } from "@/ui/input"

export function WorkspaceField() {
  return (
    <Field>
      <FieldLabel htmlFor="workspace-name">Workspace name</FieldLabel>
      <Input
        id="workspace-name"
        name="workspace"
        placeholder="Orbit command"
        aria-describedby="workspace-help"
        required
      />
      <FieldDescription id="workspace-help">
        This appears in invitations and shared links.
      </FieldDescription>
    </Field>
  )
}`,
    filename: "src/components/workspace-field.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="input" aria-labelledby="input-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Form</p>
      <h2 id="input-title">Input + Field</h2>
    </div>
    <span class="status">Generated cleanly</span>
  </div>

  <article class="bench glass-panel" aria-label="Input and Field component preview">
    <div class="workbench workbench--input">
      <ComponentPreview
        component="Input + Field"
        hint="Tab through controls"
        requirePropsView={true}
      >
        <div slot="variants" class="grid gap-8">
          <div class="grid gap-4" aria-label="Input style variants">
            {
              inputVariants.map((variant) => (
                <Field>
                  <FieldLabel for={`input-variant-${variant}`}>{variant}</FieldLabel>
                  <Input
                    id={`input-variant-${variant}`}
                    variant={variant}
                    placeholder={
                      variant === "outline"
                        ? "name@company.com"
                        : variant === "filled"
                          ? "Search by title…"
                          : "Workspace name"
                    }
                  />
                </Field>
              ))
            }
          </div>

          <div
            class="grid grid-cols-3 items-end gap-4 border-t border-border pt-8 max-[760px]:grid-cols-1"
            aria-label="Input sizes"
          >
            {
              inputSizes.map((size) => (
                <Field>
                  <FieldLabel for={`input-size-${size}`}>{size}</FieldLabel>
                  <Input
                    id={`input-size-${size}`}
                    controlSize={size}
                    placeholder={`${size} input`}
                  />
                </Field>
              ))
            }
          </div>

          <div class="grid gap-5 border-t border-border pt-8" aria-label="Native input types">
            <div
              class="flex items-baseline justify-between gap-4 text-sm text-muted-foreground max-[760px]:flex-col max-[760px]:items-start"
            >
              <span class="font-mono text-xs font-medium tracking-wider uppercase"
                >Native types</span
              >
              <span>One primitive, browser-native behavior</span>
            </div>
            <div class="grid grid-cols-2 gap-4 max-[760px]:grid-cols-1">
              <Field>
                <FieldLabel for="input-date">Date</FieldLabel>
                <Input id="input-date" type="date" value="2026-07-25" />
              </Field>

              <Field>
                <FieldLabel for="input-time">Time</FieldLabel>
                <Input id="input-time" type="time" value="09:30" />
              </Field>

              <Field>
                <FieldLabel for="input-datetime">Date + time</FieldLabel>
                <Input
                  id="input-datetime"
                  type="datetime-local"
                  value="2026-07-25T09:30"
                  variant="filled"
                />
              </Field>

              <Field>
                <FieldLabel for="input-month">Month</FieldLabel>
                <Input id="input-month" type="month" value="2026-07" variant="filled" />
              </Field>

              <Field>
                <FieldLabel for="input-number">Seats</FieldLabel>
                <Input id="input-number" type="number" value="3" min="1" max="99" />
              </Field>

              <Field>
                <FieldLabel for="input-search">Search</FieldLabel>
                <Input id="input-search" type="search" placeholder="Search projects…" />
              </Field>

              <div class="col-span-full max-[760px]:col-span-1">
                <Field>
                  <FieldLabel for="input-file">Attachments</FieldLabel>
                  <Input
                    id="input-file"
                    type="file"
                    accept=".pdf,image/*"
                    multiple
                    aria-describedby="input-file-description"
                  />
                  <FieldDescription id="input-file-description">
                    PDF or image · multiple files accepted
                  </FieldDescription>
                </Field>
              </div>
            </div>
          </div>

          <div
            class="grid grid-cols-2 gap-x-4 gap-y-6 border-t border-border pt-8 max-[760px]:grid-cols-1"
            aria-label="Field states"
          >
            <Field>
              <FieldLabel for="project-code">Project code</FieldLabel>
              <Input
                id="project-code"
                required
                placeholder="e.g. ORB-142"
                aria-describedby="project-code-description"
              />
              <FieldDescription id="project-code-description">
                Used in generated issue keys.
              </FieldDescription>
            </Field>

            <Field>
              <FieldLabel for="contact-email">Contact email</FieldLabel>
              <Input
                id="contact-email"
                type="email"
                value="not-an-email"
                aria-invalid="true"
                aria-describedby="contact-email-error"
              />
              <FieldError id="contact-email-error">Enter a valid work email.</FieldError>
            </Field>

            <Field>
              <FieldLabel for="region">Region</FieldLabel>
              <Input
                id="region"
                value="Europe / Prague"
                disabled
                aria-describedby="region-description"
              />
              <FieldDescription id="region-description">
                Inherited from your organization.
              </FieldDescription>
            </Field>

            <Field>
              <FieldLabel for="account-id">Account ID</FieldLabel>
              <Input
                id="account-id"
                value="acc_01HX9R2Q"
                readOnly
                variant="filled"
                aria-describedby="account-id-description"
              />
              <FieldDescription id="account-id-description"
                >Read-only system value.</FieldDescription
              >
            </Field>
          </div>
        </div>

        <div slot="props" class="prop-playground">
          <div class="prop-controls prop-controls--input">
            <label class="prop-control">
              <span class="label">Variant</span>
              <select aria-label="Input variant" data-input-prop-variant>
                <option value="outline">Outline</option>
                <option value="filled">Filled</option>
                <option value="underline">Underline</option>
              </select>
            </label>

            <label class="prop-control">
              <span class="label">Size</span>
              <select aria-label="Input size" data-input-prop-control-size>
                <option value="sm">Small</option>
                <option value="md" selected>Medium</option>
                <option value="lg">Large</option>
              </select>
            </label>

            <label class="prop-control">
              <span class="label">State</span>
              <select aria-label="Input state" data-input-prop-state>
                <option value="default">Default</option>
                <option value="invalid">Invalid</option>
                <option value="disabled">Disabled</option>
                <option value="readonly">Read only</option>
              </select>
            </label>
          </div>

          <div class="playground-stage playground-stage--field">
            <Field>
              <FieldLabel for="input-playground-outline-md" data-playground-label>
                Workspace name
              </FieldLabel>
              {
                inputVariants.map((variant) =>
                  inputSizes.map((size) => {
                    const selected = variant === "outline" && size === "md"
                    return (
                      <Input
                        id={`input-playground-${variant}-${size}`}
                        variant={variant}
                        controlSize={size}
                        value="Orbit command"
                        aria-describedby={selected ? "input-prop-description" : undefined}
                        data-playground-input
                        data-variant={variant}
                        data-size={size}
                        disabled={!selected}
                        hidden={!selected}
                        tabindex={selected ? 0 : -1}
                      />
                    )
                  })
                )
              }
              <FieldDescription id="input-prop-description" data-playground-description>
                This is how the field appears in context.
              </FieldDescription>
              <FieldError id="input-prop-error" data-playground-error hidden>
                A workspace with this name already exists.
              </FieldError>
            </Field>
          </div>

          <code class="prop-readout" data-prop-readout aria-live="polite"
            >&lt;Input variant="outline" controlSize="md" /&gt;</code
          >
        </div>

        <dl slot="facts" class="facts">
          <div class="fact">
            <dt class="label">Available in</dt>
            <dd>{input.frameworks.join(" · ")}</dd>
          </div>
          <div class="fact">
            <dt class="label">Field wrapper</dt>
            <dd>{field.frameworks.join(" · ")}</dd>
          </div>
          <div class="fact">
            <dt class="label">A11y contract</dt>
            <dd>Native + linked</dd>
          </div>
        </dl>
      </ComponentPreview>

      <ComponentSource
        component="Input + Field"
        generatedFamilies={["input", "field"]}
        previewSources={inputPreviewSources}
        sources={inputSources}
        usageSources={inputUsageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncInputPlayground = (preview: HTMLElement) => {
    const variant =
      preview.querySelector<HTMLSelectElement>("[data-input-prop-variant]")?.value ?? "outline"
    const controlSize =
      preview.querySelector<HTMLSelectElement>("[data-input-prop-control-size]")?.value ?? "md"
    const state =
      preview.querySelector<HTMLSelectElement>("[data-input-prop-state]")?.value ?? "default"

    preview.querySelectorAll<HTMLInputElement>("[data-playground-input]").forEach((input) => {
      const selected = input.dataset.variant === variant && input.dataset.size === controlSize
      input.hidden = !selected
      input.disabled = !selected || state === "disabled"
      input.readOnly = selected && state === "readonly"
      input.tabIndex = selected ? 0 : -1

      if (selected && state === "invalid") {
        input.setAttribute("aria-invalid", "true")
        input.setAttribute("aria-describedby", "input-prop-error")
      } else if (selected) {
        input.removeAttribute("aria-invalid")
        input.setAttribute("aria-describedby", "input-prop-description")
      }
    })

    const label = preview.querySelector<HTMLLabelElement>("[data-playground-label]")
    if (label) label.htmlFor = `input-playground-${variant}-${controlSize}`

    const description = preview.querySelector<HTMLElement>("[data-playground-description]")
    const error = preview.querySelector<HTMLElement>("[data-playground-error]")
    if (description) description.hidden = state === "invalid"
    if (error) error.hidden = state !== "invalid"

    const stateProp =
      state === "invalid"
        ? ' aria-invalid="true"'
        : state === "disabled"
          ? " disabled"
          : state === "readonly"
            ? " readOnly"
            : ""
    const readout = preview.querySelector<HTMLElement>("[data-prop-readout]")
    if (readout) {
      readout.textContent = `<Input variant="${variant}" controlSize="${controlSize}"${stateProp} />`
    }
  }

  document.addEventListener("previewmodechange", (event) => {
    const preview = (event.target as HTMLElement).closest<HTMLElement>(
      '[data-preview-component="input-field-preview"]'
    )
    if (preview && (event as CustomEvent<{ mode?: string }>).detail.mode === "props") {
      syncInputPlayground(preview)
    }
  })

  document.addEventListener("change", (event) => {
    const control = (event.target as HTMLElement).closest(
      [
        "[data-input-prop-variant]",
        "[data-input-prop-control-size]",
        "[data-input-prop-state]",
      ].join(",")
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="input-field-preview"]')
    if (preview) syncInputPlayground(preview)
  })
</script>
