---
import ComponentSource from "../ComponentSource.astro"
import SelectPreview from "../previews/SelectPreview.astro"
import { selectPreviewSources } from "../../data/catalogPreviewSources"

const selectUsageSources = [
  {
    code: `---
import FieldDescription from "@/ui/field/field-description.astro"
import FieldLabel from "@/ui/field/field-label.astro"
import Field from "@/ui/field/field.astro"
import InputAdornment from "@/ui/input/input-adornment.astro"
import InputGroup from "@/ui/input/input-group.astro"
import SelectContent from "@/ui/select/select-content.astro"
import SelectGroupLabel from "@/ui/select/select-group-label.astro"
import SelectGroup from "@/ui/select/select-group.astro"
import SelectOption from "@/ui/select/select-option.astro"
import SelectTrigger from "@/ui/select/select-trigger.astro"
import SelectValue from "@/ui/select/select-value.astro"
import Select from "@/ui/select/select.astro"
---

<Field>
  <FieldLabel for="team-trigger">Team</FieldLabel>
  <Select name="team" defaultValue="engineering">
    <InputGroup>
      <InputAdornment aria-hidden="true">Team</InputAdornment>
      <SelectTrigger id="team-trigger" aria-describedby="team-help">
        <SelectValue placeholder="Choose a team" />
      </SelectTrigger>
    </InputGroup>
    <SelectContent>
      <SelectGroup>
        <SelectGroupLabel>Product</SelectGroupLabel>
        <SelectOption value="design">Design</SelectOption>
        <SelectOption value="engineering">Engineering</SelectOption>
      </SelectGroup>
      <SelectOption value="operations">Operations</SelectOption>
    </SelectContent>
  </Select>
  <FieldDescription id="team-help">
    Controls which workspace you join.
  </FieldDescription>
</Field>`,
    filename: "src/components/team-select.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import {
  Field,
  FieldDescription,
  FieldLabel,
} from "@/ui/field"
import { InputAdornment, InputGroup } from "@/ui/input"
import {
  Select,
  SelectContent,
  SelectGroup,
  SelectGroupLabel,
  SelectOption,
  SelectTrigger,
  SelectValue,
} from "@/ui/select"

export function TeamSelect() {
  return (
    <Field>
      <FieldLabel htmlFor="team-trigger">Team</FieldLabel>
      <Select name="team" defaultValue="engineering">
        <InputGroup>
          <InputAdornment aria-hidden="true">Team</InputAdornment>
          <SelectTrigger id="team-trigger" aria-describedby="team-help">
            <SelectValue placeholder="Choose a team" />
          </SelectTrigger>
        </InputGroup>
        <SelectContent>
          <SelectGroup>
            <SelectGroupLabel>Product</SelectGroupLabel>
            <SelectOption value="design">Design</SelectOption>
            <SelectOption value="engineering">Engineering</SelectOption>
          </SelectGroup>
          <SelectOption value="operations">Operations</SelectOption>
        </SelectContent>
      </Select>
      <FieldDescription id="team-help">
        Controls which workspace you join.
      </FieldDescription>
    </Field>
  )
}`,
    filename: "src/components/team-select.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="select" aria-labelledby="select-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Choice</p>
      <h2 id="select-title">Select</h2>
    </div>
    <span class="status">Custom + native</span>
  </div>

  <article class="bench glass-panel" aria-label="Select component preview">
    <div class="workbench workbench--select">
      <SelectPreview />

      <ComponentSource
        component="Select"
        generatedFamilies={["select", "input", "field"]}
        previewSources={selectPreviewSources}
        usageSources={selectUsageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncSelectPlayground = (preview: HTMLElement) => {
    const variant =
      preview.querySelector<HTMLSelectElement>("[data-select-prop-variant]")?.value ?? "outline"
    const controlSize =
      preview.querySelector<HTMLSelectElement>("[data-select-prop-control-size]")?.value ?? "md"
    const mode =
      preview.querySelector<HTMLSelectElement>("[data-select-prop-mode]")?.value ?? "single"
    const state =
      preview.querySelector<HTMLSelectElement>("[data-select-prop-state]")?.value ?? "default"

    preview.querySelectorAll<HTMLElement>("[data-playground-select]").forEach((select) => {
      const selected =
        select.dataset.variant === variant &&
        select.dataset.size === controlSize &&
        select.dataset.mode === mode
      select.hidden = !selected
      select.dataset.disabled = !selected || state === "disabled" ? "true" : "false"

      const trigger = select.querySelector<HTMLButtonElement>("[data-slot='select-trigger']")
      if (!trigger) return

      if (selected && state === "invalid") {
        trigger.setAttribute("aria-invalid", "true")
        trigger.setAttribute("aria-describedby", "select-prop-error")
      } else if (selected) {
        trigger.removeAttribute("aria-invalid")
        trigger.setAttribute("aria-describedby", "select-prop-description")
      }
    })

    const label = preview.querySelector<HTMLLabelElement>("[data-select-playground-label]")
    if (label) label.htmlFor = `select-playground-${mode}-${variant}-${controlSize}-trigger`

    const description = preview.querySelector<HTMLElement>("[data-select-playground-description]")
    const error = preview.querySelector<HTMLElement>("[data-select-playground-error]")
    if (description) description.hidden = state === "invalid"
    if (error) error.hidden = state !== "invalid"

    const stateProp =
      state === "invalid" ? ' aria-invalid="true"' : state === "disabled" ? " disabled" : ""
    const multipleProp = mode === "multiple" ? " multiple" : ""
    const readout = preview.querySelector<HTMLElement>("[data-prop-readout]")
    if (readout) {
      readout.textContent = `<Select${multipleProp}><SelectTrigger variant="${variant}" controlSize="${controlSize}"${stateProp}>…</SelectTrigger></Select>`
    }
  }

  document.addEventListener("previewmodechange", (event) => {
    const preview = (event.target as HTMLElement).closest<HTMLElement>(
      '[data-preview-component="select-preview"]'
    )
    if (preview && (event as CustomEvent<{ mode?: string }>).detail.mode === "props") {
      syncSelectPlayground(preview)
    }
  })

  document.addEventListener("change", (event) => {
    const control = (event.target as HTMLElement).closest(
      [
        "[data-select-prop-variant]",
        "[data-select-prop-control-size]",
        "[data-select-prop-mode]",
        "[data-select-prop-state]",
      ].join(",")
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="select-preview"]')
    if (preview) syncSelectPlayground(preview)
  })
</script>
