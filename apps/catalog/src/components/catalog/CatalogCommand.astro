---
import { ArrowUpRight, Component, Search } from "@lucide/astro"
import CommandEmpty from "@/ui/command/command-empty.astro"
import CommandGroupLabel from "@/ui/command/command-group-label.astro"
import CommandGroup from "@/ui/command/command-group.astro"
import CommandInput from "@/ui/command/command-input.astro"
import CommandItem from "@/ui/command/command-item.astro"
import CommandList from "@/ui/command/command-list.astro"
import CommandShortcut from "@/ui/command/command-shortcut.astro"
import Command from "@/ui/command/command.astro"
import Dialog from "@/ui/dialog/dialog.astro"
import Kbd from "@/ui/kbd/kbd.astro"
import {
  catalogResources,
  catalogSectionGroups,
  catalogSections,
} from "../../data/catalogNavigation"
---

<Dialog
  id="catalog-navigation-dialog"
  contentClass="max-w-2xl p-0"
  hidden
  aria-label="Navigate the component catalog"
  data-catalog-command-dialog
>
  <Command class="rounded-[inherit] border-0 shadow-none" aria-label="Catalog destinations">
    <CommandInput
      id="catalog-navigation-input"
      placeholder="Search components and sections…"
      autofocus
    >
      <Search slot="icon" aria-hidden="true" />
    </CommandInput>

    <CommandList class="max-h-[min(28rem,60dvh)]">
      <CommandEmpty>
        <span class="block font-medium text-foreground">No catalog destination found.</span>
        <span class="mt-1 block text-xs">Try a component name, pattern, or primitive.</span>
      </CommandEmpty>

      {
        catalogSectionGroups.map((group) => (
          <CommandGroup>
            <CommandGroupLabel>{group}</CommandGroupLabel>
            {catalogSections
              .filter((item) => item.group === group)
              .map((item) => {
                const index = catalogSections.indexOf(item)
                return (
                  <CommandItem value={item.href} keywords={[...item.keywords]}>
                    <Component aria-hidden="true" />
                    <span>{item.label}</span>
                    <CommandShortcut>{String(index + 1).padStart(2, "0")}</CommandShortcut>
                  </CommandItem>
                )
              })}
          </CommandGroup>
        ))
      }

      <CommandGroup>
        <CommandGroupLabel>Resources</CommandGroupLabel>
        {
          catalogResources.map((item) => (
            <CommandItem value={item.href} keywords={[...item.keywords]}>
              <ArrowUpRight aria-hidden="true" />
              <span>{item.label}</span>
              <CommandShortcut>↗</CommandShortcut>
            </CommandItem>
          ))
        }
      </CommandGroup>
    </CommandList>

    <div
      class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-border px-4 py-2.5 font-mono text-[0.625rem] tracking-[0.06em] text-muted-foreground uppercase"
      aria-hidden="true"
    >
      <span class="flex items-center gap-1.5"><Kbd>↑</Kbd><Kbd>↓</Kbd> Move</span>
      <span class="flex items-center gap-1.5"><Kbd>↵</Kbd> Open</span>
      <span class="ml-auto flex items-center gap-1.5"><Kbd>Esc</Kbd> Close</span>
    </div>
  </Command>
</Dialog>

<script>
  import { COMMAND_SELECT_EVENT, type CommandSelectDetail } from "@/ui/lib/command"
  import { onDialogDismiss } from "@/ui/lib/dialog"

  const dialog = document.querySelector<HTMLElement>("[data-catalog-command-dialog]")
  const input = dialog?.querySelector<HTMLInputElement>("[data-slot='command-input']")
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-open-catalog-command]")
  )

  const closeDialog = () => {
    if (dialog) dialog.hidden = true
  }

  const openDialog = () => {
    if (!dialog || !input) return

    if (document.activeElement === document.body) {
      triggers[0]?.focus({ preventScroll: true })
    }

    input.value = ""
    input.dispatchEvent(new Event("input", { bubbles: true }))
    dialog.hidden = false
  }

  const toggleDialog = () => {
    if (!dialog || dialog.hidden) openDialog()
    else closeDialog()
  }

  const navigate = (href: string) => {
    closeDialog()

    queueMicrotask(() => {
      if (!href.startsWith("#")) {
        window.location.assign(href)
        return
      }

      const target = document.querySelector<HTMLElement>(href)
      if (window.location.hash === href) {
        target?.scrollIntoView({ block: "start" })
      } else {
        window.location.hash = href
      }
    })
  }

  triggers.forEach((trigger) => trigger.addEventListener("click", openDialog))
  document.addEventListener("keydown", (event) => {
    if (
      (event.metaKey || event.ctrlKey) &&
      !event.altKey &&
      !event.shiftKey &&
      event.key.toLocaleLowerCase() === "k"
    ) {
      event.preventDefault()
      toggleDialog()
    }
  })

  dialog?.addEventListener(COMMAND_SELECT_EVENT, (event) => {
    navigate((event as CustomEvent<CommandSelectDetail>).detail.value)
  })
  if (dialog) onDialogDismiss(dialog, closeDialog)
</script>
