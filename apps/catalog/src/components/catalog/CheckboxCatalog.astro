---
import astroCheckboxSource from "../../../../../generated/astro/checkbox/checkbox.astro?raw"
import reactCheckboxSource from "../../../../../generated/react/checkbox/checkbox.tsx?raw"
import { checkboxPreviewSources } from "../../data/catalogPreviewSources"
import ComponentSource from "../ComponentSource.astro"
import CheckboxPreview from "../previews/CheckboxPreview.astro"

const checkboxSources = [
  {
    code: astroCheckboxSource,
    filename: "generated/astro/checkbox/checkbox.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactCheckboxSource,
    filename: "generated/react/checkbox/checkbox.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]

const checkboxUsageSources = [
  {
    code: `---
import FieldContent from "@/ui/field/field-content.astro"
import Checkbox from "@/ui/checkbox/checkbox.astro"
import FieldDescription from "@/ui/field/field-description.astro"
import FieldLabel from "@/ui/field/field-label.astro"
import Field from "@/ui/field/field.astro"
---

<Field orientation="horizontal">
  <Checkbox id="release-notes" name="releaseNotes" aria-describedby="release-notes-help" checked />
  <FieldContent>
    <FieldLabel for="release-notes">Review release notes</FieldLabel>
    <FieldDescription id="release-notes-help">
      Confirm the copy, destination, and audience.
    </FieldDescription>
  </FieldContent>
</Field>`,
    filename: "src/components/release-check.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { FieldContent, Field, FieldDescription, FieldLabel } from "@/ui/field"
import { Checkbox } from "@/ui/checkbox"

export function ReleaseCheck() {
  return (
    <Field orientation="horizontal">
      <Checkbox
        id="release-notes"
        name="releaseNotes"
        aria-describedby="release-notes-help"
        defaultChecked
      />
      <FieldContent>
        <FieldLabel htmlFor="release-notes">Review release notes</FieldLabel>
        <FieldDescription id="release-notes-help">
          Confirm the copy, destination, and audience.
        </FieldDescription>
      </FieldContent>
    </Field>
  )
}`,
    filename: "src/components/release-check.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="checkbox" aria-labelledby="checkbox-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Form</p>
      <h2 id="checkbox-title">Checkbox</h2>
    </div>
    <span class="status">Native control</span>
  </div>

  <article class="bench glass-panel" aria-label="Checkbox component preview">
    <div class="workbench workbench--checkbox">
      <CheckboxPreview />

      <ComponentSource
        component="Checkbox"
        generatedFamilies={["checkbox"]}
        previewSources={checkboxPreviewSources}
        sources={checkboxSources}
        usageSources={checkboxUsageSources}
      />
    </div>
  </article>
</section>

<script>
  document
    .querySelectorAll<HTMLInputElement>("[data-checkbox-indeterminate]")
    .forEach((checkbox) => {
      checkbox.indeterminate = true
    })

  const syncCheckboxPlayground = (preview: HTMLElement) => {
    const checkbox = preview.querySelector<HTMLInputElement>("[data-playground-checkbox]")
    const checkedSelect = preview.querySelector<HTMLSelectElement>("[data-checkbox-checked]")
    const disabledSelect = preview.querySelector<HTMLSelectElement>("[data-checkbox-disabled]")
    if (!checkbox || !checkedSelect || !disabledSelect) return

    checkbox.checked = checkedSelect.value === "true"
    checkbox.disabled = disabledSelect.value === "true"

    const readout = preview.querySelector<HTMLElement>("[data-checkbox-readout]")
    if (readout) {
      const props = [
        checkbox.checked ? "defaultChecked" : "",
        checkbox.disabled ? "disabled" : "",
        'aria-label="Include archived projects"',
      ].filter(Boolean)
      readout.textContent = `<Checkbox ${props.join(" ")} />`
    }
  }

  document.addEventListener("change", (event) => {
    const target = event.target as HTMLElement
    const preview = target.closest<HTMLElement>('[data-preview-component="checkbox-preview"]')
    if (!preview) return

    if (target.matches("[data-playground-checkbox]")) {
      const checkedSelect = preview.querySelector<HTMLSelectElement>("[data-checkbox-checked]")
      if (checkedSelect && target instanceof HTMLInputElement) {
        checkedSelect.value = String(target.checked)
      }
    }

    syncCheckboxPlayground(preview)
  })
</script>
