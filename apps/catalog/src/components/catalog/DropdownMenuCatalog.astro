const reactUsage = `import { useId } from "react"
import { Button } from "@/ui/button"
import {
  DropdownMenu,
  DropdownMenuGroup,
  DropdownMenuItem,
  DropdownMenuLabel,
  DropdownMenuSeparator,
} from "@/ui/dropdown-menu"

export function ProjectActions() {
  const menuId = useId()

  return (
    <>
      <Button popoverTarget={menuId} aria-haspopup="menu">
        Project actions
