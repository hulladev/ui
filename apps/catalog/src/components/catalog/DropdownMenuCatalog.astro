---

<section class="component-section" id="dropdown-menu" aria-labelledby="dropdown-menu-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Pattern / Navigation</p>
      <h2 id="dropdown-menu-title">Dropdown Menu</h2>
    </div>
    <span class="status">Popover powered</span>
  </div>

  <article class="bench glass-panel" aria-label="Dropdown Menu component preview">
    <div class="workbench workbench--dropdown-menu">
      <DropdownMenuPreview />

      <ComponentSource
        component="Dropdown Menu"
        generatedFamilies={["dropdown-menu"]}
        previewSources={dropdownMenuPreviewSources}
        sources={dropdownMenuSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncDropdownMenuPlayground = (preview: HTMLElement) => {
    const placement =
      preview.querySelector<HTMLSelectElement>("[data-menu-prop-placement]")?.value ??
      "bottom-start"
    const variant =
      preview.querySelector<HTMLSelectElement>("[data-menu-prop-variant]")?.value ?? "default"

    preview.querySelectorAll<HTMLElement>("[data-menu-prop-case]").forEach((item) => {
      const menu = item.querySelector<HTMLElement>("[popover]")
      if (item.dataset.placement !== placement && menu?.matches(":popover-open")) {
        menu.hidePopover()
      }
      item.hidden = item.dataset.placement !== placement
    })
    preview.querySelectorAll<HTMLElement>("[data-menu-prop-item]").forEach((item) => {
      item.hidden = item.dataset.variant !== variant
    })

    const readout = preview.querySelector<HTMLElement>("[data-menu-prop-readout]")
    if (readout) {
      readout.textContent =
        `<DropdownMenu placement="${placement}">` +
        `<DropdownMenuItem variant="${variant}" /></DropdownMenu>`
    }
  }

  document.addEventListener("input", (event) => {
    const control = (event.target as HTMLElement).closest(
      "[data-menu-prop-placement], [data-menu-prop-variant]"
    )
    const preview = control?.closest<HTMLElement>(
      '[data-preview-component="dropdown-menu-preview"]'
    )
    if (preview) syncDropdownMenuPlayground(preview)
  })
</script>
