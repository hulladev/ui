---
import astroSkeletonSource from "../../../../../generated/astro/skeleton/skeleton.astro?raw"
import reactSkeletonSource from "../../../../../generated/react/skeleton/skeleton.tsx?raw"
import { skeletonPreviewSources } from "../../data/catalogPreviewSources"
import ComponentSource from "../ComponentSource.astro"
import SkeletonPreview from "../previews/SkeletonPreview.astro"

const skeletonSources = [
  {
    code: astroSkeletonSource,
    filename: "generated/astro/skeleton/skeleton.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactSkeletonSource,
    filename: "generated/react/skeleton/skeleton.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]

const skeletonUsageSources = [
  {
    code: `---
import Skeleton from "@/ui/skeleton/skeleton.astro"
---

<section aria-busy="true" aria-label="Loading article" class="grid gap-4">
  <div class="flex items-center gap-3">
    <Skeleton class="size-10 rounded-full" />
    <div class="grid flex-1 gap-2">
      <Skeleton class="h-3 w-32" />
      <Skeleton class="h-2.5 w-20" />
    </div>
  </div>
  <Skeleton
    variant="shimmer"
    class="aspect-[16/7] w-full [--skeleton-iteration-count:1]"
  />
  <Skeleton class="h-3 w-full" />
  <Skeleton class="h-3 w-4/5" />
</section>`,
    filename: "src/components/article-loading.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { Skeleton } from "@/ui/skeleton"

export function ArticleLoading() {
  return (
    <section aria-busy="true" aria-label="Loading article" className="grid gap-4">
      <div className="flex items-center gap-3">
        <Skeleton className="size-10 rounded-full" />
        <div className="grid flex-1 gap-2">
          <Skeleton className="h-3 w-32" />
          <Skeleton className="h-2.5 w-20" />
        </div>
      </div>
      <Skeleton
        variant="shimmer"
        className="aspect-[16/7] w-full [--skeleton-iteration-count:1]"
      />
      <Skeleton className="h-3 w-full" />
      <Skeleton className="h-3 w-4/5" />
    </section>
  )
}`,
    filename: "src/components/article-loading.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="skeleton" aria-labelledby="skeleton-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Feedback</p>
      <h2 id="skeleton-title">Skeleton</h2>
    </div>
    <span class="status">Motion aware</span>
  </div>

  <article class="bench glass-panel" aria-label="Skeleton component preview">
    <div class="workbench">
      <SkeletonPreview />

      <ComponentSource
        component="Skeleton"
        generatedFamilies={["skeleton"]}
        previewSources={skeletonPreviewSources}
        sources={skeletonSources}
        usageSources={skeletonUsageSources}
      />
    </div>
  </article>
</section>

<script>
  const shapeClasses = {
    avatar: "size-16 rounded-full",
    line: "h-4 w-48",
    media: "aspect-video w-64 max-w-full",
  } as const

  const syncSkeletonPlayground = (preview: HTMLElement) => {
    const shape = preview.querySelector<HTMLSelectElement>("[data-skeleton-shape]")?.value ?? "line"
    const variant =
      preview.querySelector<HTMLSelectElement>("[data-skeleton-variant]")?.value ?? "pulse"
    const iteration =
      preview.querySelector<HTMLSelectElement>("[data-skeleton-iteration]")?.value ?? "repeat"

    preview.querySelectorAll<HTMLElement>("[data-playground-skeleton]").forEach((skeleton) => {
      skeleton.hidden =
        skeleton.dataset.shape !== shape ||
        skeleton.dataset.variant !== variant ||
        skeleton.dataset.iteration !== iteration
    })

    const readout = preview.querySelector<HTMLElement>("[data-skeleton-readout]")
    const baseClasses = shapeClasses[shape as keyof typeof shapeClasses] ?? shapeClasses.line
    const classes = `${baseClasses}${iteration === "once" ? " [--skeleton-iteration-count:1]" : ""}`
    const variantProp = variant === "shimmer" ? ' variant="shimmer"' : ""
    if (readout) {
      readout.textContent = `<Skeleton${variantProp} className="${classes}" />`
    }
  }

  document.addEventListener("change", (event) => {
    const control = (event.target as HTMLElement).closest(
      "[data-skeleton-shape], [data-skeleton-variant], [data-skeleton-iteration]"
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="skeleton-preview"]')
    if (preview) syncSkeletonPlayground(preview)
  })
</script>
