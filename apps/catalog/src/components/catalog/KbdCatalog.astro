---
import astroKbdSource from "../../../../../generated/astro/kbd/kbd.astro?raw"
import reactKbdSource from "../../../../../generated/react/kbd/kbd.tsx?raw"
import ComponentSource from "../ComponentSource.astro"
import KbdPreview from "../previews/KbdPreview.astro"
import { kbdPreviewSources } from "../../data/catalogPreviewSources"

const kbdSources = [
  {
    code: astroKbdSource,
    filename: "generated/astro/kbd/kbd.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactKbdSource,
    filename: "generated/react/kbd/kbd.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]

const kbdUsageSources = [
  {
    code: `---
import Kbd from "@/ui/kbd/kbd.astro"
---

<p>
  Press <Kbd>⌘</Kbd> + <Kbd>K</Kbd> to open the command menu.
</p>`,
    filename: "src/components/shortcut-hint.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { Kbd } from "@/ui/kbd"

export function ShortcutHint() {
  return (
    <p>
      Press <Kbd>⌘</Kbd> + <Kbd>K</Kbd> to open the command menu.
    </p>
  )
}`,
    filename: "src/components/shortcut-hint.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="kbd" aria-labelledby="kbd-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Typography</p>
      <h2 id="kbd-title">Kbd</h2>
    </div>
    <span class="status">Native semantics</span>
  </div>

  <article class="bench glass-panel" aria-label="Kbd component preview">
    <div class="workbench workbench--kbd">
      <KbdPreview />

      <ComponentSource
        component="Kbd"
        generatedFamilies={["kbd"]}
        previewSources={kbdPreviewSources}
        sources={kbdSources}
        usageSources={kbdUsageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncKbdPlayground = (preview: HTMLElement) => {
    const content =
      preview.querySelector<HTMLInputElement>("[data-kbd-prop-content]")?.value.trim() || "Key"
    const tone = "default"

    preview.querySelectorAll<HTMLElement>("[data-playground-kbd]").forEach((kbd) => {
      kbd.hidden = kbd.dataset.tone !== tone
      kbd.textContent = content
    })

    const readout = preview.querySelector<HTMLElement>("[data-kbd-prop-readout]")
    if (readout) readout.textContent = `<Kbd>${content}</Kbd>`
  }

  document.addEventListener("input", (event) => {
    const control = (event.target as HTMLElement).closest("[data-kbd-prop-content]")
    const preview = control?.closest<HTMLElement>('[data-preview-component="kbd-preview"]')
    if (preview) syncKbdPlayground(preview)
  })
</script>
