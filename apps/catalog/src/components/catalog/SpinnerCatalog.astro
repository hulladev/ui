---
import astroSpinnerSource from "../../../../../generated/astro/spinner/spinner.astro?raw"
import reactSpinnerSource from "../../../../../generated/react/spinner/spinner.tsx?raw"
import { spinnerPreviewSources } from "../../data/catalogPreviewSources"
import ComponentSource from "../ComponentSource.astro"
import SpinnerPreview from "../previews/SpinnerPreview.astro"

const spinnerSources = [
  {
    code: astroSpinnerSource,
    filename: "generated/astro/spinner/spinner.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactSpinnerSource,
    filename: "generated/react/spinner/spinner.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]

const spinnerUsageSources = [
  {
    code: `---
import Spinner from "@/ui/spinner/spinner.astro"
---

<div role="status" class="inline-flex items-center gap-2">
  <Spinner />
  <span>Saving changes…</span>
</div>`,
    filename: "src/components/save-status.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { Spinner } from "@/ui/spinner"

export function SaveStatus() {
  return (
    <div role="status" className="inline-flex items-center gap-2">
      <Spinner />
      <span>Saving changes…</span>
    </div>
  )
}`,
    filename: "src/components/save-status.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="spinner" aria-labelledby="spinner-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Feedback</p>
      <h2 id="spinner-title">Spinner</h2>
    </div>
    <span class="status">Indeterminate</span>
  </div>

  <article class="bench glass-panel" aria-label="Spinner component preview">
    <div class="workbench">
      <SpinnerPreview />

      <ComponentSource
        component="Spinner"
        generatedFamilies={["spinner"]}
        previewSources={spinnerPreviewSources}
        sources={spinnerSources}
        usageSources={spinnerUsageSources}
      />
    </div>
  </article>
</section>

<script>
  document.addEventListener("input", (event) => {
    const control = event.target as HTMLInputElement
    if (!control.matches("[data-spinner-label]")) return
    const preview = control.closest('[data-preview-component="spinner-preview"]')
    const status = preview?.querySelector("[data-spinner-status]")
    if (status) status.textContent = control.value
  })
</script>
