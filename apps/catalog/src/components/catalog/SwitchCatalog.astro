---
import astroSwitchSource from "../../../../../generated/astro/switch/switch.astro?raw"
import reactSwitchSource from "../../../../../generated/react/switch/switch.tsx?raw"
import { switchPreviewSources } from "../../data/catalogPreviewSources"
import ComponentSource from "../ComponentSource.astro"
import SwitchPreview from "../previews/SwitchPreview.astro"

const switchSources = [
  {
    code: astroSwitchSource,
    filename: "generated/astro/switch/switch.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactSwitchSource,
    filename: "generated/react/switch/switch.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]

const switchUsageSources = [
  {
    code: `---
import FieldDescription from "@/ui/field/field-description.astro"
import FieldLabel from "@/ui/field/field-label.astro"
import Field from "@/ui/field/field.astro"
import Switch from "@/ui/switch/switch.astro"
---

<Field class="grid-cols-[1fr_auto] items-center gap-x-5">
  <div>
    <FieldLabel for="weekly-digest">Weekly digest</FieldLabel>
    <FieldDescription id="weekly-digest-help">
      Receive a summary every Monday morning.
    </FieldDescription>
  </div>
  <Switch
    id="weekly-digest"
    variant="subtle"
    name="weeklyDigest"
    aria-describedby="weekly-digest-help"
    checked
  />
</Field>`,
    filename: "src/components/digest-preference.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { Field, FieldDescription, FieldLabel } from "@/ui/field"
import { Switch } from "@/ui/switch"

export function DigestPreference() {
  return (
    <Field className="grid-cols-[1fr_auto] items-center gap-x-5">
      <div>
        <FieldLabel htmlFor="weekly-digest">Weekly digest</FieldLabel>
        <FieldDescription id="weekly-digest-help">
          Receive a summary every Monday morning.
        </FieldDescription>
      </div>
      <Switch
        id="weekly-digest"
        variant="subtle"
        name="weeklyDigest"
        aria-describedby="weekly-digest-help"
        defaultChecked
      />
    </Field>
  )
}`,
    filename: "src/components/digest-preference.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="switch" aria-labelledby="switch-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Form</p>
      <h2 id="switch-title">Switch</h2>
    </div>
    <span class="status">Native control</span>
  </div>

  <article class="bench glass-panel" aria-label="Switch component preview">
    <div class="workbench workbench--switch">
      <SwitchPreview />

      <ComponentSource
        component="Switch"
        generatedFamilies={["switch"]}
        previewSources={switchPreviewSources}
        sources={switchSources}
        usageSources={switchUsageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncSwitchPlayground = (preview: HTMLElement) => {
    const switchElement = preview.querySelector<HTMLInputElement>("[data-playground-switch]")
    const checkedSelect = preview.querySelector<HTMLSelectElement>("[data-switch-checked]")
    const disabledSelect = preview.querySelector<HTMLSelectElement>("[data-switch-disabled]")
    if (!switchElement || !checkedSelect || !disabledSelect) return

    switchElement.checked = checkedSelect.value === "true"
    switchElement.disabled = disabledSelect.value === "true"

    const readout = preview.querySelector<HTMLElement>("[data-switch-readout]")
    if (readout) {
      const props = [
        switchElement.checked ? "defaultChecked" : "",
        switchElement.disabled ? "disabled" : "",
        'aria-label="Sync activity"',
      ].filter(Boolean)
      readout.textContent = `<Switch ${props.join(" ")} />`
    }
  }

  document.addEventListener("change", (event) => {
    const target = event.target as HTMLElement
    const preview = target.closest<HTMLElement>('[data-preview-component="switch-preview"]')
    if (!preview) return

    if (target.matches("[data-playground-switch]")) {
      const checkedSelect = preview.querySelector<HTMLSelectElement>("[data-switch-checked]")
      if (checkedSelect && target instanceof HTMLInputElement) {
        checkedSelect.value = String(target.checked)
      }
    }

    syncSwitchPlayground(preview)
  })
</script>
