import Dialog from "../../../../../generated/astro/dialog/dialog.astro"
import TableBody from "../../../../../generated/astro/table/table-body.astro"
import TableCell from "../../../../../generated/astro/table/table-cell.astro"
import TableHead from "../../../../../generated/astro/table/table-head.astro"
import TableHeader from "../../../../../generated/astro/table/table-header.astro"
import TableRow from "../../../../../generated/astro/table/table-row.astro"
import Table from "../../../../../generated/astro/table/table.astro"
import astroDialogSource from "../../../../../generated/astro/dialog/dialog.astro?raw"
import reactDialogSource from "../../../../../generated/react/dialog/dialog.tsx?raw"
import ComponentSource from "../ComponentSource.astro"
import DialogPreview from "../previews/DialogPreview.astro"
import { dialogPreviewSources } from "../../data/catalogPreviewSources"

const dialogSources = [
  {
    code: astroDialogSource,
    filename: "generated/astro/dialog/dialog.astro",
    framework: "Astro · Dialog",
    language: "astro" as const,
  },
  {
    code: reactDialogSource,
    filename: "generated/react/dialog/dialog.tsx",
    framework: "React · Dialog",
    language: "tsx" as const,
  },
]

const astroUsage = `---
import Button from "@/ui/button/button.astro"
import DialogDescription from "@/ui/dialog/dialog-description.astro"
import DialogFooter from "@/ui/dialog/dialog-footer.astro"
import DialogHeader from "@/ui/dialog/dialog-header.astro"
import DialogTitle from "@/ui/dialog/dialog-title.astro"
import Dialog from "@/ui/dialog/dialog.astro"
---

<Button data-open-archive>Archive release</Button>

<Dialog
  data-archive-dialog
  variant="compact"
  hidden
  aria-labelledby="archive-title"
  aria-describedby="archive-description"
>
  <DialogHeader>
    <DialogTitle id="archive-title">Archive this release?</DialogTitle>
    <DialogDescription id="archive-description">
      It remains available in history.
    </DialogDescription>
  </DialogHeader>

  <DialogFooter>
    <Button variant="outline" data-close-archive>Cancel</Button>
    <Button data-close-archive>Archive</Button>
  </DialogFooter>
</Dialog>

<script>
  import { onDialogDismiss } from "@/ui/lib/dialog"

  // dialog: HTMLElement | null
  const dialog = document.querySelector<HTMLElement>("[data-archive-dialog]")
  const close = () => {
    if (dialog) dialog.hidden = true
  }

  document.querySelector("[data-open-archive]")?.addEventListener("click", () => {
    if (dialog) dialog.hidden = false
  })
  document.querySelectorAll("[data-close-archive]").forEach((button) => {
    button.addEventListener("click", close)
  })
  if (dialog) onDialogDismiss(dialog, close)
</script>`

const reactUsage = `import { useState } from "react"
import { Button } from "@/ui/button"
import {
  Dialog,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  type DialogDismissReason,
} from "@/ui/dialog"

export function ArchiveRelease() {
  const [open, setOpen] = useState(false) // open: boolean

  const dismiss = (_reason: DialogDismissReason) => {
    setOpen(false)
  }

  return (
    <>
      <Button onClick={() => setOpen(true)}>Archive release</Button>

      {open && (
        <Dialog
          variant="compact"
          aria-labelledby="archive-title"
          aria-describedby="archive-description"
          onDismiss={dismiss}
        >
          <DialogHeader>
            <DialogTitle id="archive-title">Archive this release?</DialogTitle>
            <DialogDescription id="archive-description">
              It remains available in history.
            </DialogDescription>
          </DialogHeader>

          <DialogFooter>
            <Button variant="outline" onClick={() => setOpen(false)}>
              Cancel
            </Button>
            <Button onClick={() => setOpen(false)}>Archive</Button>
          </DialogFooter>
        </Dialog>
      )}
    </>
  )
}`

const usageSources = [
  {
    code: astroUsage,
    filename: "src/components/archive-release.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: reactUsage,
    filename: "src/components/archive-release.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
