    <div class="workbench workbench--dialog">
      <DialogPreview />

      <ComponentSource
        component="Dialog"
        generatedFamilies={["dialog"]}
        previewSources={dialogPreviewSources}
        sources={dialogSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>

<Dialog
  id="catalog-dialog"
  hidden
  aria-labelledby="catalog-dialog-title"
  aria-describedby="catalog-dialog-description"
