<Dialog
  id="catalog-nested-dialog"
  hidden
  aria-labelledby="catalog-nested-title"
  aria-describedby="catalog-nested-description"
>
  <DialogHeader>
    <div
      class="flex items-center justify-between gap-4 font-mono text-xs tracking-wider text-muted-foreground uppercase"
    >
      <span>Top layer</span>
      <code class="text-primary" data-catalog-nested-order>pending</code>
    </div>
    <DialogTitle id="catalog-nested-title">Ordering is structural.</DialogTitle>
    <DialogDescription id="catalog-nested-description">
      This layer registered second, so it receives Escape and focus before the dialog underneath it.
    </DialogDescription>
  </DialogHeader>

  <DialogFooter>
    <Button autofocus data-close-catalog-nested>Return to dialog</Button>
  </DialogFooter>
</Dialog>

<script>
  import { onDialogDismiss } from "../../../../../generated/astro/lib/dialog"

  const catalogDialog = document.querySelector<HTMLElement>("#catalog-dialog")
  const catalogWorkspaceDialog = document.querySelector<HTMLElement>("#catalog-workspace-dialog")
  const catalogFullscreenDialog = document.querySelector<HTMLElement>("#catalog-fullscreen-dialog")
  const catalogNestedDialog = document.querySelector<HTMLElement>("#catalog-nested-dialog")
  const layerCount = document.querySelector<HTMLElement>("[data-overlay-layer-count]")
  const catalogLayerOrder = document.querySelector<HTMLElement>("[data-catalog-layer-order]")
  const catalogNestedOrder = document.querySelector<HTMLElement>("[data-catalog-nested-order]")
  const dialogPropsPreview = document.querySelector<HTMLElement>(
    '[data-preview-component="dialog-preview"]'
  )

  const getPropsDialog = () => {
    const variant =
      dialogPropsPreview?.querySelector<HTMLSelectElement>("[data-dialog-prop-variant]")?.value ??
      "compact"
    const dialog =
      variant === "workspace"
        ? catalogWorkspaceDialog
        : variant === "fullscreen"
          ? catalogFullscreenDialog
          : catalogDialog
    return { dialog, variant }
  }

  const syncDialogProps = () => {
    if (!dialogPropsPreview) return
    const { variant } = getPropsDialog()
    const dismissible =
      dialogPropsPreview.querySelector<HTMLInputElement>("[data-dialog-prop-dismissible]")
        ?.checked ?? true
    const summary = dialogPropsPreview.querySelector<HTMLElement>("[data-dialog-prop-summary]")
    const readout = dialogPropsPreview.querySelector<HTMLElement>("[data-dialog-prop-readout]")
    if (summary) summary.textContent = `${variant} · ${dismissible ? "dismissible" : "locked"}`
    if (readout) {
      readout.textContent = `<Dialog variant="${variant}" dismissible={${dismissible}} />`
    }
  }

  const syncLayerLedger = () => {
    const count = document.querySelectorAll("[data-slot='dialog-overlay']:not([hidden])").length
    if (layerCount) layerCount.textContent = `${count} active layer${count === 1 ? "" : "s"}`

    const dialogOrder = catalogDialog?.dataset.layerOrder
    const nestedOrder = catalogNestedDialog?.dataset.layerOrder
    if (catalogLayerOrder) {
      catalogLayerOrder.textContent = dialogOrder === undefined ? "pending" : `order ${dialogOrder}`
    }
    if (catalogNestedOrder) {
      catalogNestedOrder.textContent =
        nestedOrder === undefined ? "pending" : `order ${nestedOrder}`
    }
  }

  const closeCatalogNested = () => {
    if (catalogNestedDialog) catalogNestedDialog.hidden = true
  }

  const closeCatalogDialog = () => {
    closeCatalogNested()
    if (catalogDialog) catalogDialog.hidden = true
  }

  const closeWorkspaceDialog = () => {
    if (catalogWorkspaceDialog) catalogWorkspaceDialog.hidden = true
  }

  const closeFullscreenDialog = () => {
    if (catalogFullscreenDialog) catalogFullscreenDialog.hidden = true
  }

  document.querySelector("[data-open-catalog-dialog]")?.addEventListener("click", () => {
    if (catalogDialog) catalogDialog.hidden = false
  })
  document.querySelector("[data-open-workspace-dialog]")?.addEventListener("click", () => {
    if (catalogWorkspaceDialog) catalogWorkspaceDialog.hidden = false
  })
  document.querySelector("[data-open-fullscreen-dialog]")?.addEventListener("click", () => {
    if (catalogFullscreenDialog) catalogFullscreenDialog.hidden = false
  })
  document.querySelector("[data-open-catalog-nested]")?.addEventListener("click", () => {
    if (catalogNestedDialog) catalogNestedDialog.hidden = false
  })
  document.querySelector("[data-open-props-dialog]")?.addEventListener("click", () => {
    const { dialog } = getPropsDialog()
    const dismissible =
      dialogPropsPreview?.querySelector<HTMLInputElement>("[data-dialog-prop-dismissible]")
        ?.checked ?? true
    if (dialog) {
      dialog.dataset.dismissible = String(dismissible)
      dialog.hidden = false
    }
  })
  dialogPropsPreview?.addEventListener("input", (event) => {
    if (
      (event.target as HTMLElement).matches(
        "[data-dialog-prop-variant], [data-dialog-prop-dismissible]"
      )
    ) {
      syncDialogProps()
    }
  })
  document.querySelectorAll("[data-close-catalog-dialog]").forEach((button) => {
    button.addEventListener("click", closeCatalogDialog)
  })
  document.querySelectorAll("[data-close-workspace-dialog]").forEach((button) => {
    button.addEventListener("click", closeWorkspaceDialog)
  })
  document.querySelectorAll("[data-close-fullscreen-dialog]").forEach((button) => {
    button.addEventListener("click", closeFullscreenDialog)
  })
  document
    .querySelector("[data-close-catalog-nested]")
    ?.addEventListener("click", closeCatalogNested)

  if (catalogDialog) onDialogDismiss(catalogDialog, closeCatalogDialog)
  if (catalogWorkspaceDialog) onDialogDismiss(catalogWorkspaceDialog, closeWorkspaceDialog)
  if (catalogFullscreenDialog) onDialogDismiss(catalogFullscreenDialog, closeFullscreenDialog)
  if (catalogNestedDialog) onDialogDismiss(catalogNestedDialog, closeCatalogNested)

  const layerObserver = new MutationObserver(syncLayerLedger)
  ;[catalogDialog, catalogWorkspaceDialog, catalogFullscreenDialog, catalogNestedDialog].forEach(
    (dialog) => {
      if (!dialog) return
      layerObserver.observe(dialog, {
        attributeFilter: ["data-layer-order", "hidden"],
      })
    }
  )
  syncDialogProps()
  syncLayerLedger()
</script>
