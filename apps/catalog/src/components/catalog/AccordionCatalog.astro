---
import ComponentSource from "../ComponentSource.astro"
import AccordionPreview from "../previews/AccordionPreview.astro"
import { accordionPreviewSources } from "../../data/catalogPreviewSources"

const usageSources = [
  {
    code: `---
import Accordion from "@/ui/accordion/accordion.astro"
import AccordionContent from "@/ui/accordion/accordion-content.astro"
import AccordionItem from "@/ui/accordion/accordion-item.astro"
import AccordionTrigger from "@/ui/accordion/accordion-trigger.astro"
---

<Accordion>
  <AccordionItem name="product-faq" open>
    <AccordionTrigger>Can I invite external collaborators?</AccordionTrigger>
    <AccordionContent>
      Yes. Guests can be limited to individual projects and removed at any time.
    </AccordionContent>
  </AccordionItem>
  <AccordionItem name="product-faq">
    <AccordionTrigger>How does billing work?</AccordionTrigger>
    <AccordionContent>
      Plans are billed per active member. Guests and archived members are free.
    </AccordionContent>
  </AccordionItem>
</Accordion>`,
    filename: "src/components/product-faq.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
} from "@/ui/accordion"

export function ProductFaq() {
  return (
    <Accordion>
      <AccordionItem name="product-faq" open>
        <AccordionTrigger>Can I invite external collaborators?</AccordionTrigger>
        <AccordionContent>
          Yes. Guests can be limited to individual projects and removed at any time.
        </AccordionContent>
      </AccordionItem>
      <AccordionItem name="product-faq">
        <AccordionTrigger>How does billing work?</AccordionTrigger>
        <AccordionContent>
          Plans are billed per active member. Guests and archived members are free.
        </AccordionContent>
      </AccordionItem>
    </Accordion>
  )
}`,
    filename: "src/components/product-faq.tsx",
    framework: "React",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="accordion" aria-labelledby="accordion-section-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Primitive / Disclosure</p>
      <h2 id="accordion-section-title">Accordion</h2>
    </div>
    <span class="status">Native disclosure</span>
  </div>

  <article class="bench glass-panel" aria-label="Accordion component preview">
    <div class="workbench workbench--accordion">
      <AccordionPreview />

      <ComponentSource
        component="Accordion"
        generatedFamilies={["accordion"]}
        previewSources={accordionPreviewSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>

<script>
  const syncAccordionPlayground = (preview: HTMLElement) => {
    const mode =
      preview.querySelector<HTMLSelectElement>("[data-accordion-prop-mode]")?.value ?? "exclusive"
    const firstOpen =
      preview.querySelector<HTMLInputElement>("[data-accordion-prop-open]")?.checked ?? true
    const items = Array.from(
      preview.querySelectorAll<HTMLDetailsElement>("[data-playground-accordion] > details")
    )

    items.forEach((item) => {
      item.name = mode === "exclusive" ? "catalog-accordion-playground" : ""
    })
    if (items[0]) items[0].open = firstOpen

    const readout = preview.querySelector<HTMLElement>("[data-accordion-prop-readout]")
    if (readout) {
      const name = mode === "exclusive" ? ' name="faq"' : ""
      const open = firstOpen ? " open" : ""
      readout.textContent = `<AccordionItem${name}${open}>…</AccordionItem>`
    }
  }

  document.addEventListener("input", (event) => {
    const control = (event.target as HTMLElement).closest(
      "[data-accordion-prop-mode], [data-accordion-prop-open]"
    )
    const preview = control?.closest<HTMLElement>('[data-preview-component="accordion-preview"]')
    if (preview) syncAccordionPlayground(preview)
  })
</script>
