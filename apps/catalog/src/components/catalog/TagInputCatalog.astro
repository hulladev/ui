---
import tagInputUsageSource from "../../examples/tag-input.astro.txt?raw"
import { tagInputPreviewSources } from "../../data/catalogPreviewSources"
import ComponentSource from "../ComponentSource.astro"
import TagInputPreview from "../previews/TagInputPreview.astro"
const usageSources = [
  {
    code: tagInputUsageSource,
    filename: "src/components/tag-input.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: `import { useRef, useState } from "react"
import {
  TagInput,
  TagInputControl,
  TagInputTag,
  TagInputLabel,
  TagInputRemove,
} from "@/ui/tag-input"

export function Labels() {
  const [tags, setTags] = useState(["Design"])
  const inputRef = useRef<HTMLInputElement>(null)
  return (
    <TagInput>
      {tags.map((tag) => (
        <TagInputTag key={tag}>
          <TagInputLabel>{tag}</TagInputLabel>
          <input type="hidden" name="labels" value={tag} />
          <TagInputRemove
            aria-label={\`Remove \${tag}\`}
            onClick={() => {
              setTags(tags.filter((item) => item !== tag))
              inputRef.current?.focus()
            }}
          />
        </TagInputTag>
      ))}
      <TagInputControl
        ref={inputRef}
        aria-label="Add label"
        onTagAdd={(tag) => {
          if (tags.includes(tag)) return false
          setTags([...tags, tag])
        }}
      />
    </TagInput>
  )
}`,
    filename: "src/components/tag-input.tsx",
    framework: "React",
    language: "tsx" as const,
  },
  {
    code: `import { createSignal, For } from "solid-js"
import {
  TagInput,
  TagInputControl,
  TagInputTag,
  TagInputLabel,
  TagInputRemove,
} from "@/ui/tag-input"

export function Labels() {
  const [tags, setTags] = createSignal(["Design"])
  let inputRef: HTMLInputElement | undefined
  return (
    <TagInput>
      <For each={tags()}>
        {(tag) => (
          <TagInputTag>
            <TagInputLabel>{tag}</TagInputLabel>
            <input type="hidden" name="labels" value={tag} />
            <TagInputRemove
              aria-label={\`Remove \${tag}\`}
              onClick={() => {
                setTags(tags().filter((item) => item !== tag))
                inputRef?.focus()
              }}
            />
          </TagInputTag>
        )}
      </For>
      <TagInputControl
        ref={(element) => {
          inputRef = element
        }}
        aria-label="Add label"
        onTagAdd={(tag) => {
          if (tags().includes(tag)) return false
          setTags([...tags(), tag])
        }}
      />
    </TagInput>
  )
}`,
    filename: "src/components/tag-input.tsx",
    framework: "Solid",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="tag-input" aria-labelledby="tag-input-title">
  <div class="section-head">
    <div><p class="eyebrow">Primitive / Forms</p><h2 id="tag-input-title">Tag Input</h2></div>
    <span class="status">Composable values</span>
  </div>
  <article class="bench glass-panel" aria-label="TagInput component preview">
    <div class="workbench">
      <TagInputPreview />
      <ComponentSource
        component="TagInput"
        generatedFamilies={["tag-input"]}
        previewSources={tagInputPreviewSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>
