---
import tagInputUsageSource from "../../examples/tag-input.astro.txt?raw"
import { tagInputPreviewSources } from "../../data/catalogPreviewSources"
import ComponentSource from "../ComponentSource.astro"
import TagInputPreview from "../previews/TagInputPreview.astro"
const usageSources = [
  {
    code: tagInputUsageSource,
    filename: "src/components/tag-input.astro",
    framework: "Astro",
    language: "astro" as const,
  },
  {
    code: 'import { useRef, useState } from "react"\nimport { TagInput, TagInputControl, TagInputTag, TagInputRemove } from "@/ui/tag-input"\n\nexport function Labels() {\n  const [tags, setTags] = useState(["Design"])\n  const inputRef = useRef<HTMLInputElement>(null)\n  return (\n    <TagInput>\n      {tags.map((tag) => (\n        <TagInputTag key={tag}>\n          <span>{tag}</span>\n          <input type="hidden" name="labels" value={tag} />\n          <TagInputRemove aria-label={`Remove ${tag}`} onClick={() => { setTags(tags.filter((item) => item !== tag)); inputRef.current?.focus() }}>\n            ×\n          </TagInputRemove>\n        </TagInputTag>\n      ))}\n      <TagInputControl ref={inputRef} aria-label="Add label" onTagAdd={(tag) => {\n        if (tags.includes(tag)) return false\n        setTags([...tags, tag])\n      }} />\n    </TagInput>\n  )\n}',
    filename: "src/components/tag-input.tsx",
    framework: "React",
    language: "tsx" as const,
  },
  {
    code: 'import { createSignal, For } from "solid-js"\nimport { TagInput, TagInputControl, TagInputTag, TagInputRemove } from "@/ui/tag-input"\n\nexport function Labels() {\n  const [tags, setTags] = createSignal(["Design"])\n  let inputRef: HTMLInputElement | undefined\n  return (\n    <TagInput>\n      <For each={tags()}>{(tag) => (\n        <TagInputTag>\n          <span>{tag}</span>\n          <input type="hidden" name="labels" value={tag} />\n          <TagInputRemove aria-label={`Remove ${tag}`} onClick={() => { setTags(tags().filter((item) => item !== tag)); inputRef?.focus() }}>\n            ×\n          </TagInputRemove>\n        </TagInputTag>\n      )}</For>\n      <TagInputControl ref={(element) => { inputRef = element }} aria-label="Add label" onTagAdd={(tag) => {\n        if (tags().includes(tag)) return false\n        setTags([...tags(), tag])\n      }} />\n    </TagInput>\n  )\n}',
    filename: "src/components/tag-input.tsx",
    framework: "Solid",
    language: "tsx" as const,
  },
]
---

<section class="component-section" id="tag-input" aria-labelledby="tag-input-title">
  <div class="section-head">
    <div><p class="eyebrow">Primitive / Forms</p><h2 id="tag-input-title">Tag Input</h2></div>
    <span class="status">Composable values</span>
  </div>
  <article class="bench glass-panel" aria-label="TagInput component preview">
    <div class="workbench">
      <TagInputPreview />
      <ComponentSource
        component="TagInput"
        generatedFamilies={["tag-input"]}
        previewSources={tagInputPreviewSources}
        usageSources={usageSources}
      />
    </div>
  </article>
</section>
