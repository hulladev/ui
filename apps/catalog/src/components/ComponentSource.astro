---
import { Code } from "astro:components"

type SourceFile = {
  code: string
  filename: string
  framework: string
  language: "astro" | "tsx"
}

type Props = {
  component: string
  sources: SourceFile[]
}

const { component, sources } = Astro.props
const inspectorId = `${component.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}-source`
const firstSource = sources[0]
---

<section class="source-inspector" data-source-inspector aria-labelledby={`${inspectorId}-title`}>
  <header class="source-head">
    <div>
      <p class="eyebrow">Generated output</p>
      <h3 id={`${inspectorId}-title`}>Source inspection</h3>
    </div>

    <div class="source-head-actions">
      <span class="editor-capability label">
        <span aria-hidden="true"></span>
        <span data-service-label>
          {
            firstSource?.language === "tsx"
              ? "TypeScript + Tailwind IntelliSense"
              : "Astro + Tailwind IntelliSense"
          }
        </span>
      </span>
      <button
        class="editor-action label"
        type="button"
        aria-pressed="false"
        data-edit-source
        title="Edit this source in a temporary scratch buffer"
      >
        <svg aria-hidden="true" viewBox="0 0 16 16">
          <path
            d="m3 11-.5 2.5L5 13l7.8-7.8-2-2L3 11Zm6.8-6.8 2 2"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span data-edit-label>Edit sample</span>
      </button>
      <button class="editor-action label" type="button" data-reset-source hidden>
        <svg aria-hidden="true" viewBox="0 0 16 16">
          <path
            d="M3.2 5.7A5.2 5.2 0 1 1 3 10.9M3.2 2.8v2.9h2.9"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Reset
      </button>
      <button class="copy-button label" type="button" data-copy-source>
        <svg aria-hidden="true" viewBox="0 0 16 16">
          <path
            d="M5.5 4.5v-2h8v8h-2m-9-6h8v9h-8z"
            fill="none"
            stroke="currentColor"
            stroke-linejoin="round"></path>
        </svg>
        <span data-copy-label>Copy</span>
      </button>
    </div>
  </header>

  <div class="source-toolbar">
    <div class="source-tabs" role="tablist" aria-label={`${component} framework source`}>
      {
        sources.map((source, index) => (
          <button
            id={`${inspectorId}-tab-${index}`}
            class="source-tab label"
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-source-tab
          >
            <span class={`framework-icon framework-icon--${source.language}`} aria-hidden="true">
              {source.language === "astro" ? (
                <svg viewBox="0 0 24 24">
                  <path
                    d="M12 2.3 5.1 20h4l1.1-3.3h3.6l1.1 3.3h4L12 2.3Zm0 8.2 1.1 3.2h-2.2l1.1-3.2Z"
                    fill="currentColor"
                  />
                  <path
                    d="M7.8 18.7c1.5 1.1 2.7 1.6 4.2 1.6 1.6 0 2.8-.5 4.3-1.6-.4 2-1.9 3-4.3 3s-3.8-1-4.2-3Z"
                    fill="var(--icon-accent)"
                  />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="1.8" fill="currentColor" />
                  <ellipse
                    cx="12"
                    cy="12"
                    rx="9.2"
                    ry="3.7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.35"
                  />
                  <ellipse
                    cx="12"
                    cy="12"
                    rx="9.2"
                    ry="3.7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.35"
                    transform="rotate(60 12 12)"
                  />
                  <ellipse
                    cx="12"
                    cy="12"
                    rx="9.2"
                    ry="3.7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.35"
                    transform="rotate(120 12 12)"
                  />
                </svg>
              )}
            </span>
            <span class="source-tab-index">{String(index + 1).padStart(2, "0")}</span>
            {source.framework}
          </button>
        ))
      }
    </div>

    <p class="source-path label" data-source-path>{firstSource?.filename}</p>
  </div>

  <div class="source-records" hidden>
    {
      sources.map((source) => (
        <input
          type="hidden"
          value={source.code}
          data-filename={source.filename}
          data-framework={source.framework}
          data-language={source.language}
          data-source-record
        />
      ))
    }
  </div>

  <div class="editor-stage">
    <div class="monaco-mount" data-monaco-mount></div>
    {
      firstSource && (
        <div class="editor-fallback" data-editor-fallback>
          <Code code={firstSource.code} lang={firstSource.language} theme="vesper" wrap={false} />
        </div>
      )
    }
  </div>

  <footer class="editor-statusbar label">
    <span class="editor-mode">
      <span class="status-led" aria-hidden="true"></span>
      <span data-diagnostics>
        {firstSource?.language === "tsx" ? "Checking TypeScript…" : "Syntax highlighting only"}
      </span>
    </span>
    <span data-editor-state>Generated source · Read only</span>
  </footer>
</section>

<script>
  import * as monaco from "monaco-editor/editor/editor.api"
  import EditorWorker from "monaco-editor/editor/editor.worker?worker"
  import "monaco-editor/editor/contrib/bracketMatching/browser/bracketMatching"
  import "monaco-editor/editor/contrib/find/browser/findController"
  import "monaco-editor/editor/contrib/gotoError/browser/gotoError"
  import "monaco-editor/editor/contrib/hover/browser/hoverContribution"
  import "monaco-editor/editor/contrib/suggest/browser/suggestController"
  import "monaco-editor/editor/contrib/wordHighlighter/browser/wordHighlighter"
  import * as tsLanguage from "monaco-editor/languages/features/typescript/register"
  import TypeScriptWorker from "monaco-editor/languages/features/typescript/ts.worker?worker"

  type MonacoEnvironment = {
    getWorker: (workerId: string, label: string) => Worker
  }
  ;(self as typeof self & { MonacoEnvironment: MonacoEnvironment }).MonacoEnvironment = {
    getWorker(workerId, label) {
      void workerId
      if (label === "typescript" || label === "javascript") return new TypeScriptWorker()
      return new EditorWorker()
    },
  }

  if (!monaco.languages.getLanguages().some(({ id }) => id === "typescript")) {
    monaco.languages.register({
      id: "typescript",
      extensions: [".ts", ".tsx", ".cts", ".mts"],
      aliases: ["TypeScript", "ts", "typescript"],
      mimetypes: ["text/typescript"],
    })
  }
  monaco.languages.setLanguageConfiguration("typescript", {
    autoClosingPairs: [
      { open: "{", close: "}" },
      { open: "[", close: "]" },
      { open: "(", close: ")" },
      { open: '"', close: '"', notIn: ["string"] },
      { open: "'", close: "'", notIn: ["string", "comment"] },
      { open: "`", close: "`", notIn: ["string", "comment"] },
    ],
    brackets: [
      ["{", "}"],
      ["[", "]"],
      ["(", ")"],
    ],
    comments: {
      blockComment: ["/*", "*/"],
      lineComment: "//",
    },
  })
  monaco.languages.setMonarchTokensProvider("typescript", {
    defaultToken: "",
    tokenPostfix: ".ts",
    keywords: [
      "as",
      "async",
      "await",
      "break",
      "case",
      "catch",
      "class",
      "const",
      "continue",
      "default",
      "delete",
      "do",
      "else",
      "export",
      "extends",
      "false",
      "finally",
      "for",
      "from",
      "function",
      "get",
      "if",
      "implements",
      "import",
      "in",
      "instanceof",
      "interface",
      "keyof",
      "let",
      "new",
      "null",
      "of",
      "return",
      "satisfies",
      "set",
      "static",
      "super",
      "switch",
      "this",
      "throw",
      "true",
      "try",
      "type",
      "typeof",
      "undefined",
      "var",
      "void",
      "while",
      "yield",
    ],
    typeKeywords: [
      "any",
      "bigint",
      "boolean",
      "never",
      "number",
      "object",
      "readonly",
      "string",
      "symbol",
      "unknown",
    ],
    operators: [
      "=",
      ">",
      "<",
      "!",
      "~",
      "?",
      ":",
      "==",
      "<=",
      ">=",
      "!=",
      "&&",
      "||",
      "++",
      "--",
      "+",
      "-",
      "*",
      "/",
      "&",
      "|",
      "^",
      "%",
      "+=",
      "-=",
      "*=",
      "/=",
      "&=",
      "|=",
      "^=",
      "%=",
      "<<",
      ">>",
      ">>>",
      "<<=",
      ">>=",
      ">>>=",
      "=>",
    ],
    symbols: /[=><!~?:&|+\-*/^%]+/,
    tokenizer: {
      root: [
        [/(<\/?)([a-z][\w.-]*)/, ["delimiter", "tag"]],
        [/[a-zA-Z_$][\w$]*(?=\s*=)/, "attribute.name"],
        [/[A-Z][\w$]*/, "type.identifier"],
        [
          /[a-zA-Z_$][\w$]*/,
          {
            cases: {
              "@keywords": "keyword",
              "@typeKeywords": "type.identifier",
              "@default": "identifier",
            },
          },
        ],
        { include: "@whitespace" },
        [/[{}()[\]]/, "@brackets"],
        [/@symbols/, { cases: { "@operators": "delimiter", "@default": "" } }],
        [/\d+(?:\.\d+)?/, "number"],
        [/"([^"\\]|\\.)*$/, "string.invalid"],
        [/'([^'\\]|\\.)*$/, "string.invalid"],
        [/"/, "string", "@doubleString"],
        [/'/, "string", "@singleString"],
        [/`/, "string", "@templateString"],
      ],
      whitespace: [
        [/[ \t\r\n]+/, ""],
        [/\/\*/, "comment", "@comment"],
        [/\/\/.*$/, "comment"],
      ],
      comment: [
        [/[^/*]+/, "comment"],
        [/\*\//, "comment", "@pop"],
        [/[/*]/, "comment"],
      ],
      doubleString: [
        [/[^\\"]+/, "string"],
        [/\\./, "string.escape"],
        [/"/, "string", "@pop"],
      ],
      singleString: [
        [/[^\\']+/, "string"],
        [/\\./, "string.escape"],
        [/'/, "string", "@pop"],
      ],
      templateString: [
        [/[^\\`$]+/, "string"],
        [/\\./, "string.escape"],
        [/\$\{/, { token: "delimiter.bracket", next: "@bracketCounting" }],
        [/`/, "string", "@pop"],
      ],
      bracketCounting: [
        [/\{/, "delimiter.bracket", "@bracketCounting"],
        [/\}/, "delimiter.bracket", "@pop"],
        { include: "root" },
      ],
    },
  })

  if (!monaco.languages.getLanguages().some(({ id }) => id === "astro")) {
    monaco.languages.register({
      id: "astro",
      extensions: [".astro"],
      aliases: ["Astro"],
    })
    monaco.languages.setLanguageConfiguration("astro", {
      autoClosingPairs: [
        { open: "{", close: "}" },
        { open: "[", close: "]" },
        { open: "(", close: ")" },
        { open: '"', close: '"' },
        { open: "'", close: "'" },
        { open: "`", close: "`" },
      ],
      brackets: [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["<", ">"],
      ],
      comments: {
        blockComment: ["<!--", "-->"],
        lineComment: "//",
      },
    })
    monaco.languages.setMonarchTokensProvider("astro", {
      defaultToken: "",
      tokenPostfix: ".astro",
      tokenizer: {
        root: [
          [/^---\s*$/, { token: "delimiter.astro", next: "@frontmatter" }],
          [/<!--/, "comment", "@comment"],
          [/(<!DOCTYPE)(\s+)([^>]+)(>)/, ["metatag", "", "metatag.content", "metatag"]],
          [/(<\/?)([\w:-]+)/, ["delimiter", "tag"], "@tag"],
          [/{/, { token: "delimiter.bracket", next: "@expression" }],
        ],
        frontmatter: [
          [/^---\s*$/, { token: "delimiter.astro", next: "@root" }],
          [/\/\/.*$/, "comment"],
          [/\/\*/, "comment", "@jsComment"],
          [
            /\b(?:as|const|export|extends|from|import|interface|let|return|satisfies|type)\b/,
            "keyword",
          ],
          [/\b(?:Astro|false|null|true|undefined)\b/, "constant"],
          [/[A-Z][\w$]*/, "type.identifier"],
          [/[a-zA-Z_$][\w$]*(?=\s*\()/, "function"],
          [/"([^"\\]|\\.)*$/, "string.invalid"],
          [/'([^'\\]|\\.)*$/, "string.invalid"],
          [/"/, "string", "@doubleString"],
          [/'/, "string", "@singleString"],
          [/`/, "string", "@templateString"],
          [/\d+(?:\.\d+)?/, "number"],
        ],
        tag: [
          [/\s+/, ""],
          [/[\w:-]+/, "attribute.name"],
          [/=/, "delimiter"],
          [/"[^"]*"/, "attribute.value"],
          [/'[^']*'/, "attribute.value"],
          [/{/, { token: "delimiter.bracket", next: "@expression" }],
          [/\/?>/, { token: "delimiter", next: "@pop" }],
        ],
        expression: [
          [/}/, { token: "delimiter.bracket", next: "@pop" }],
          [/\b(?:as|await|const|else|false|if|let|null|return|true|typeof|undefined)\b/, "keyword"],
          [/[A-Z][\w$]*/, "type.identifier"],
          [/[a-zA-Z_$][\w$]*(?=\s*\()/, "function"],
          [/"/, "string", "@doubleString"],
          [/'/, "string", "@singleString"],
          [/`/, "string", "@templateString"],
          [/\d+(?:\.\d+)?/, "number"],
        ],
        comment: [
          [/-->/, "comment", "@pop"],
          [/./, "comment"],
        ],
        jsComment: [
          [/\*\//, "comment", "@pop"],
          [/./, "comment"],
        ],
        doubleString: [
          [/[^\\"]+/, "string"],
          [/\\./, "string.escape"],
          [/"/, "string", "@pop"],
        ],
        singleString: [
          [/[^\\']+/, "string"],
          [/\\./, "string.escape"],
          [/'/, "string", "@pop"],
        ],
        templateString: [
          [/[^\\`$]+/, "string"],
          [/\\./, "string.escape"],
          [/`/, "string", "@pop"],
        ],
      },
    })
  }

  const reactTypeStubs = `
declare module "react" {
  export type ReactNode = unknown
  export type PropsWithChildren<P = unknown> = P & { children?: ReactNode }
  export type ComponentPropsWithoutRef<T extends string> = {
    "aria-describedby"?: string
    "aria-invalid"?: boolean | "false" | "true"
    children?: ReactNode
    className?: string
    disabled?: boolean
    htmlFor?: string
    id?: string
    readOnly?: boolean
    required?: boolean
    size?: number
    type?: string
  }
  export type ButtonHTMLAttributes<T> = {
    className?: string
    disabled?: boolean
    type?: "button" | "reset" | "submit"
  }
  export type DetailedHTMLProps<E, T> = E
}

declare module "react/jsx-runtime" {
  export const Fragment: unique symbol
  export function jsx(type: unknown, props: unknown, key?: unknown): unknown
  export function jsxs(type: unknown, props: unknown, key?: unknown): unknown
}

declare namespace JSX {
  type IntrinsicElements = {
    button: Record<string, unknown>
    div: Record<string, unknown>
    input: Record<string, unknown>
    label: Record<string, unknown>
    p: Record<string, unknown>
  }
}
`

  const styleTypeStubs = `
declare module "@/lib/style" {
  type Variant<V extends Record<string, unknown>> = ((value: keyof V) => string) & {
    infer: keyof V
  }

  export const cn: (...classes: unknown[]) => string
  export const vn: <const V extends Record<string, unknown>>(variants: V) => Variant<V>
}
`

  tsLanguage.typescriptDefaults.setCompilerOptions({
    allowNonTsExtensions: true,
    esModuleInterop: true,
    jsx: tsLanguage.JsxEmit.ReactJSX,
    module: tsLanguage.ModuleKind.ESNext,
    moduleResolution: tsLanguage.ModuleResolutionKind.NodeJs,
    noEmit: true,
    skipLibCheck: true,
    strict: true,
    target: tsLanguage.ScriptTarget.ESNext,
  })
  tsLanguage.typescriptDefaults.setDiagnosticsOptions({
    noSemanticValidation: false,
    noSyntaxValidation: false,
  })
  tsLanguage.typescriptDefaults.setEagerModelSync(true)
  tsLanguage.typescriptDefaults.addExtraLib(
    reactTypeStubs,
    "file:///node_modules/@types/react/index.d.ts"
  )
  tsLanguage.typescriptDefaults.addExtraLib(
    styleTypeStubs,
    "file:///generated/react/lib/style.d.ts"
  )

  monaco.editor.defineTheme("hulla-foundry", {
    base: "vs-dark",
    inherit: true,
    colors: {
      "editor.background": "#0b0e18",
      "editor.foreground": "#edf2ff",
      "editor.lineHighlightBackground": "#ffffff06",
      "editorLineNumber.foreground": "#4d566c",
      "editorLineNumber.activeForeground": "#a8b3cf",
      "editorCursor.foreground": "#718bff",
      "editor.selectionBackground": "#5478ff33",
      "editor.inactiveSelectionBackground": "#ffffff12",
      "editorIndentGuide.background1": "#ffffff0d",
      "editorIndentGuide.activeBackground1": "#ffffff24",
      "editorError.foreground": "#ff7c8f",
      "editorWarning.foreground": "#f1cb72",
      "editorHoverWidget.background": "#171c2a",
      "editorHoverWidget.border": "#ffffff24",
      "editorSuggestWidget.background": "#171c2a",
      "editorSuggestWidget.border": "#ffffff24",
      "editorWidget.border": "#ffffff24",
      "scrollbarSlider.background": "#ffffff1f",
      "scrollbarSlider.hoverBackground": "#ffffff33",
      "scrollbarSlider.activeBackground": "#ffffff45",
    },
    rules: [
      { token: "delimiter.astro", foreground: "718BFF", fontStyle: "bold" },
      { token: "tag", foreground: "9EB3FF" },
      { token: "attribute.name", foreground: "B8C8FF" },
      { token: "attribute.value", foreground: "B7E875" },
      { token: "keyword", foreground: "90A7FF" },
      { token: "type.identifier", foreground: "C4D0FF" },
      { token: "function", foreground: "7BD9EF" },
      { token: "string", foreground: "A9DB87" },
      { token: "number", foreground: "E2B1FF" },
      { token: "comment", foreground: "6F7890", fontStyle: "italic" },
    ],
  })

  type SourceRecord = {
    code: string
    filename: string
    framework: string
    language: "astro" | "tsx"
  }

  type TailwindSuggestion = {
    description: string
    detail: string
    label: string
  }

  const commonTailwindSuggestions: TailwindSuggestion[] = [
    { label: "relative", detail: "position: relative", description: "Position relative" },
    { label: "absolute", detail: "position: absolute", description: "Position absolute" },
    { label: "fixed", detail: "position: fixed", description: "Position fixed" },
    { label: "sticky", detail: "position: sticky", description: "Position sticky" },
    { label: "block", detail: "display: block", description: "Block layout" },
    { label: "inline-block", detail: "display: inline-block", description: "Inline-block layout" },
    { label: "inline", detail: "display: inline", description: "Inline layout" },
    { label: "flex", detail: "display: flex", description: "Flex layout" },
    { label: "inline-flex", detail: "display: inline-flex", description: "Inline flex layout" },
    { label: "grid", detail: "display: grid", description: "Grid layout" },
    { label: "hidden", detail: "display: none", description: "Hide the element" },
    { label: "border", detail: "border-width: 1px", description: "Use the default border width" },
    { label: "shrink-0", detail: "flex-shrink: 0", description: "Prevent flex shrinking" },
    { label: "grow", detail: "flex-grow: 1", description: "Allow flex growth" },
    {
      label: "items-start",
      detail: "align-items: flex-start",
      description: "Align items at start",
    },
    { label: "items-center", detail: "align-items: center", description: "Center items" },
    { label: "items-end", detail: "align-items: flex-end", description: "Align items at end" },
    {
      label: "items-stretch",
      detail: "align-items: stretch",
      description: "Stretch items across the cross axis",
    },
    {
      label: "justify-start",
      detail: "justify-content: flex-start",
      description: "Pack items at start",
    },
    {
      label: "justify-center",
      detail: "justify-content: center",
      description: "Center items",
    },
    {
      label: "justify-between",
      detail: "justify-content: space-between",
      description: "Distribute space between items",
    },
    { label: "overflow-hidden", detail: "overflow: hidden", description: "Clip overflow" },
    { label: "overflow-auto", detail: "overflow: auto", description: "Scroll overflow as needed" },
    {
      label: "whitespace-nowrap",
      detail: "white-space: nowrap",
      description: "Prevent text wrapping",
    },
    { label: "select-none", detail: "user-select: none", description: "Disable text selection" },
    { label: "font-medium", detail: "font-weight: 500", description: "Medium font weight" },
    { label: "font-semibold", detail: "font-weight: 600", description: "Semibold font weight" },
    { label: "leading-none", detail: "line-height: 1", description: "Tight line height" },
    {
      label: "antialiased",
      detail: "font smoothing",
      description: "Use antialiased text rendering",
    },
    {
      label: "transition",
      detail: "transition-property: common properties",
      description: "Apply the default transition",
    },
    {
      label: "transition-colors",
      detail: "transition-property: color, background, border",
      description: "Transition color properties",
    },
    { label: "cursor-pointer", detail: "cursor: pointer", description: "Pointer cursor" },
    {
      label: "disabled:cursor-not-allowed",
      detail: "cursor: not-allowed",
      description: "Use a disabled cursor when the element is disabled",
    },
  ]

  const spacingSteps = [
    "0",
    "0.5",
    "1",
    "1.5",
    "2",
    "2.5",
    "3",
    "3.5",
    "4",
    "5",
    "6",
    "8",
    "10",
    "12",
    "16",
    "20",
    "24",
    "32",
  ]
  const spacingPrefixes = [
    "gap",
    "gap-x",
    "gap-y",
    "h",
    "m",
    "mb",
    "ml",
    "mr",
    "mt",
    "mx",
    "my",
    "p",
    "pb",
    "pl",
    "pr",
    "pt",
    "px",
    "py",
    "w",
  ]
  for (const prefix of spacingPrefixes) {
    for (const step of spacingSteps) {
      commonTailwindSuggestions.push({
        label: `${prefix}-${step}`,
        detail: `Tailwind spacing · ${Number(step) * 0.25}rem`,
        description: `Project spacing utility using the ${step} spacing step`,
      })
    }
  }

  const projectColors = [
    "background",
    "border",
    "focus-ring",
    "foreground",
    "muted-foreground",
    "primary",
    "primary-foreground",
    "surface",
    "surface-raised",
  ]
  const colorPrefixes = ["bg", "border", "caret", "fill", "outline", "ring", "stroke", "text"]
  for (const prefix of colorPrefixes) {
    for (const color of projectColors) {
      commonTailwindSuggestions.push({
        label: `${prefix}-${color}`,
        detail: `Hulla theme · --color-${color}`,
        description: `Uses the ${color} color from the active Hulla theme`,
      })
    }
  }

  for (const radius of ["sm", "md", "lg"]) {
    commonTailwindSuggestions.push({
      label: `rounded-${radius}`,
      detail: `Hulla theme · --radius-${radius}`,
      description: `Uses the ${radius} radius from the Hulla theme`,
    })
  }

  const getTailwindToken = (
    model: monaco.editor.ITextModel,
    position: monaco.Position
  ): { range: monaco.Range; token: string } | undefined => {
    const line = model.getLineContent(position.lineNumber)
    const cursor = position.column - 1
    let start = cursor
    let end = cursor

    while (start > 0 && !/[\s"'`]/.test(line[start - 1] ?? "")) start -= 1
    while (end < line.length && !/[\s"'`,)]/.test(line[end] ?? "")) end += 1

    const token = line.slice(start, end)
    if (!token) return
    return {
      token,
      range: new monaco.Range(position.lineNumber, start + 1, position.lineNumber, end + 1),
    }
  }

  const getTailwindCompletionRange = (
    model: monaco.editor.ITextModel,
    position: monaco.Position,
    knownClasses: Set<string>
  ): monaco.Range | undefined => {
    const line = model.getLineContent(position.lineNumber)
    const cursor = position.column - 1
    const beforeCursor = line.slice(0, cursor)
    const openingQuote = Math.max(
      beforeCursor.lastIndexOf('"'),
      beforeCursor.lastIndexOf("'"),
      beforeCursor.lastIndexOf("`")
    )
    if (openingQuote < 0) return

    const quote = line[openingQuote]
    const closingQuote = line.indexOf(quote ?? "", cursor)
    if (closingQuote < 0) return

    const value = line.slice(openingQuote + 1, closingQuote)
    const nearbySource = model.getValueInRange(
      new monaco.Range(
        Math.max(1, position.lineNumber - 10),
        1,
        position.lineNumber,
        openingQuote + 1
      )
    )
    const isKnownClassList = value.split(/\s+/).some((className) => knownClasses.has(className))
    const isClassContext =
      isKnownClassList || /(?:class|className)\s*=|(?:cn|vn)\s*\([\s\S]*$/.test(nearbySource)
    if (!isClassContext) return

    const fragment = beforeCursor.slice(openingQuote + 1).match(/[^\s]*$/)?.[0] ?? ""
    return new monaco.Range(
      position.lineNumber,
      position.column - fragment.length,
      position.lineNumber,
      position.column
    )
  }

  const registerTailwindIntelliSense = (records: SourceRecord[]) => {
    const suggestions = new Map(
      commonTailwindSuggestions.map((suggestion) => [suggestion.label, suggestion])
    )
    const classPattern = /["'`]([^"'`\n]+)["'`]/g

    for (const record of records) {
      for (const match of record.code.matchAll(classPattern)) {
        const classList = match[1] ?? ""
        if (!/\s/.test(classList)) continue

        for (const className of classList.split(/\s+/)) {
          if (!/[-:[\]/]/.test(className)) continue
          if (!suggestions.has(className)) {
            suggestions.set(className, {
              label: className,
              detail: "Tailwind class · used by this component",
              description: "A Tailwind utility found in this generated component",
            })
          }
        }
      }
    }

    const knownClasses = new Set(suggestions.keys())
    const completionProvider: monaco.languages.CompletionItemProvider = {
      triggerCharacters: [":", "-", "[", "/"],
      provideCompletionItems(model, position) {
        const range = getTailwindCompletionRange(model, position, knownClasses)
        if (!range) return { suggestions: [] }

        return {
          suggestions: Array.from(suggestions.values()).map((suggestion) => ({
            label: suggestion.label,
            kind: monaco.languages.CompletionItemKind.Value,
            detail: suggestion.detail,
            documentation: suggestion.description,
            insertText: suggestion.label,
            range,
            sortText: suggestion.detail.startsWith("Hulla")
              ? `0-${suggestion.label}`
              : `1-${suggestion.label}`,
          })),
        }
      },
    }
    const hoverProvider: monaco.languages.HoverProvider = {
      provideHover(model, position) {
        const result = getTailwindToken(model, position)
        const suggestion = result ? suggestions.get(result.token) : undefined
        if (!result || !suggestion) return

        return {
          range: result.range,
          contents: [
            { value: `**${suggestion.label}**` },
            { value: suggestion.detail },
            { value: suggestion.description },
          ],
        }
      },
    }

    const disposables = ["astro", "typescript"].flatMap((language) => [
      monaco.languages.registerCompletionItemProvider(language, completionProvider),
      monaco.languages.registerHoverProvider(language, hoverProvider),
    ])
    return () => disposables.forEach((disposable) => disposable.dispose())
  }

  const initializeSourceInspector = (inspector: HTMLElement) => {
    if (inspector.dataset.sourceInspectorReady === "true") return

    const tabs = Array.from(inspector.querySelectorAll<HTMLButtonElement>("[data-source-tab]"))
    const records = Array.from(
      inspector.querySelectorAll<HTMLInputElement>("[data-source-record]")
    ).map(
      (input): SourceRecord => ({
        code: input.value,
        filename: input.dataset.filename ?? "generated/source.ts",
        framework: input.dataset.framework ?? "Source",
        language: input.dataset.language === "tsx" ? "tsx" : "astro",
      })
    )
    const mount = inspector.querySelector<HTMLElement>("[data-monaco-mount]")
    const fallback = inspector.querySelector<HTMLElement>("[data-editor-fallback]")
    const path = inspector.querySelector<HTMLElement>("[data-source-path]")
    const serviceLabel = inspector.querySelector<HTMLElement>("[data-service-label]")
    const diagnostics = inspector.querySelector<HTMLElement>("[data-diagnostics]")
    const editorState = inspector.querySelector<HTMLElement>("[data-editor-state]")
    const editButton = inspector.querySelector<HTMLButtonElement>("[data-edit-source]")
    const editLabel = inspector.querySelector<HTMLElement>("[data-edit-label]")
    const resetButton = inspector.querySelector<HTMLButtonElement>("[data-reset-source]")
    const copyButton = inspector.querySelector<HTMLButtonElement>("[data-copy-source]")
    const copyLabel = inspector.querySelector<HTMLElement>("[data-copy-label]")
    if (!mount || records.length === 0) return
    inspector.dataset.sourceInspectorReady = "true"

    const models = records.map((record) =>
      monaco.editor.createModel(
        record.code,
        record.language === "tsx" ? "typescript" : "astro",
        monaco.Uri.parse(`file:///${record.filename}`)
      )
    )
    const originalSources = new Map(
      models.map((model, index) => [model.uri.toString(), records[index]?.code ?? ""])
    )
    const disposeTailwindIntelliSense = registerTailwindIntelliSense(records)
    let activeIndex = 0
    let isEditing = false

    const editor = monaco.editor.create(mount, {
      model: models[0],
      ariaLabel: `${records[0]?.framework} generated source`,
      automaticLayout: true,
      bracketPairColorization: { enabled: true },
      cursorBlinking: "smooth",
      cursorSmoothCaretAnimation: "on",
      fontFamily: '"IBM Plex Mono", "SFMono-Regular", "Cascadia Mono", monospace',
      fontLigatures: true,
      fontSize: 13,
      glyphMargin: true,
      lineHeight: 22,
      minimap: { enabled: false },
      padding: { top: 14, bottom: 18 },
      readOnly: true,
      readOnlyMessage: { value: "Generated output is read only." },
      renderLineHighlight: "gutter",
      renderValidationDecorations: "on",
      roundedSelection: false,
      scrollBeyondLastLine: false,
      scrollbar: {
        horizontalScrollbarSize: 9,
        verticalScrollbarSize: 9,
      },
      smoothScrolling: true,
      tabSize: 2,
      theme: "hulla-foundry",
      wordWrap: "off",
    })
    fallback?.setAttribute("hidden", "")

    const updateEditorState = () => {
      const model = models[activeIndex]
      const hasChanges = model?.getValue() !== originalSources.get(model?.uri.toString() ?? "")

      editButton?.setAttribute("aria-pressed", String(isEditing))
      if (editLabel) editLabel.textContent = isEditing ? "Done" : "Edit sample"
      if (resetButton) resetButton.hidden = !isEditing || !hasChanges
      if (editorState) {
        editorState.textContent = isEditing
          ? hasChanges
            ? "Scratch buffer · Unsaved local edits"
            : "Scratch buffer · Tailwind suggestions enabled"
          : "Generated source · Read only"
      }
    }

    const updateDiagnostics = () => {
      if (!diagnostics) return
      const record = records[activeIndex]
      if (record?.language !== "tsx") {
        diagnostics.textContent = "Syntax highlighting only"
        diagnostics.closest(".editor-mode")?.classList.remove("has-errors", "is-checking")
        return
      }

      const markers = monaco.editor.getModelMarkers({ resource: models[activeIndex]?.uri })
      const errorCount = markers.filter(
        ({ severity }) => severity === monaco.MarkerSeverity.Error
      ).length
      const warningCount = markers.filter(
        ({ severity }) => severity === monaco.MarkerSeverity.Warning
      ).length
      const mode = diagnostics.closest(".editor-mode")
      mode?.classList.remove("is-checking")
      mode?.classList.toggle("has-errors", errorCount > 0)

      if (errorCount > 0) {
        diagnostics.textContent = `${errorCount} TypeScript error${errorCount === 1 ? "" : "s"}`
      } else if (warningCount > 0) {
        diagnostics.textContent = `${warningCount} TypeScript warning${warningCount === 1 ? "" : "s"}`
      } else {
        diagnostics.textContent = "No TypeScript errors"
      }
    }

    const selectSource = (index: number, moveFocus = false) => {
      if (!records[index] || !models[index]) return
      activeIndex = index
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index
        tab.setAttribute("aria-selected", String(selected))
        tab.tabIndex = selected ? 0 : -1
        if (selected && moveFocus) tab.focus()
      })

      editor.setModel(models[index])
      editor.updateOptions({ ariaLabel: `${records[index].framework} generated source` })
      editor.setScrollPosition({ scrollLeft: 0, scrollTop: 0 })
      editor.layout()
      if (path) path.textContent = records[index].filename
      if (serviceLabel) {
        serviceLabel.textContent =
          records[index].language === "tsx"
            ? "TypeScript + Tailwind IntelliSense"
            : "Astro + Tailwind IntelliSense"
      }
      if (diagnostics && records[index].language === "tsx") {
        diagnostics.textContent = "Checking TypeScript…"
        diagnostics.closest(".editor-mode")?.classList.add("is-checking")
      }
      updateDiagnostics()
      updateEditorState()
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectSource(index))
      tab.addEventListener("keydown", (event) => {
        let nextIndex = index

        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length
        if (event.key === "Home") nextIndex = 0
        if (event.key === "End") nextIndex = tabs.length - 1
        if (nextIndex === index) return

        event.preventDefault()
        selectSource(nextIndex, true)
      })
    })

    monaco.editor.onDidChangeMarkers((uris) => {
      if (uris.some((uri) => uri.toString() === models[activeIndex]?.uri.toString())) {
        updateDiagnostics()
      }
    })

    editor.onDidChangeModelContent(updateEditorState)

    editButton?.addEventListener("click", () => {
      isEditing = !isEditing
      editor.updateOptions({
        readOnly: !isEditing,
        readOnlyMessage: isEditing
          ? undefined
          : { value: "Choose Edit sample to make local changes." },
      })
      updateEditorState()
      if (isEditing) editor.focus()
    })

    resetButton?.addEventListener("click", () => {
      const model = models[activeIndex]
      const originalSource = originalSources.get(model?.uri.toString() ?? "")
      if (model && originalSource !== undefined) model.setValue(originalSource)
      editor.focus()
    })

    copyButton?.addEventListener("click", async () => {
      const source = editor.getModel()?.getValue()
      if (!source || !copyLabel) return

      try {
        await navigator.clipboard.writeText(source)
        copyLabel.textContent = "Copied"
        window.setTimeout(() => {
          copyLabel.textContent = "Copy"
        }, 1600)
      } catch {
        copyLabel.textContent = "Copy failed"
      }
    })

    window.addEventListener(
      "pagehide",
      () => {
        disposeTailwindIntelliSense()
      },
      { once: true }
    )
  }

  const initializeSourceInspectors = (root: ParentNode = document) => {
    root.querySelectorAll<HTMLElement>("[data-source-inspector]").forEach(initializeSourceInspector)
  }

  type SourceInspectorWindow = Window & {
    hullaSourceInspectorObserver?: MutationObserver
  }

  initializeSourceInspectors()

  const sourceInspectorWindow = window as SourceInspectorWindow
  sourceInspectorWindow.hullaSourceInspectorObserver?.disconnect()
  sourceInspectorWindow.hullaSourceInspectorObserver = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      for (const node of mutation.addedNodes) {
        if (!(node instanceof HTMLElement)) continue
        if (node.matches("[data-source-inspector]")) initializeSourceInspector(node)
        initializeSourceInspectors(node)
      }
    }
  })
  sourceInspectorWindow.hullaSourceInspectorObserver.observe(document.body, {
    childList: true,
    subtree: true,
  })
</script>
