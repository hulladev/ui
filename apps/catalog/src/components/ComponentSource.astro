---
import { ChevronDown } from "@lucide/astro"
import CodeBlock from "@/ui/code/code-block.astro"
import CodeBlockContent from "@/ui/code/code-block-content.astro"
import CodeBlockPath from "@/ui/code/code-block-path.astro"
import { generatedSourcesFor, type CatalogSourceLanguage } from "../data/generatedCatalogSources"

type SourceFile = {
  code: string
  filename: string
  framework: string
  label?: string
  language: CatalogSourceLanguage
}

type Props = {
  component: string
  generatedFamilies?: string[]
  previewSources?: SourceFile[]
  sources?: SourceFile[]
  usageSources?: SourceFile[]
}

type SourceMode = "visible" | "minimal" | "generated"
type Framework = "Astro" | "React" | "Solid"
type SourceRecord = Omit<SourceFile, "framework"> & {
  framework: Framework
  mode: SourceMode
}

const {
  component,
  generatedFamilies = [],
  previewSources = [],
  sources = [],
  usageSources = [],
} = Astro.props
const inspectorId = `${component.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}-source`
const hasUsage = usageSources.length > 0
const hasPreview = previewSources.length > 0
const initialMode: SourceMode = hasPreview ? "visible" : hasUsage ? "minimal" : "generated"
const frameworkOf = (source: SourceFile): Framework => {
  const framework = source.framework.toLowerCase()
  if (framework.includes("react")) return "React"
  if (framework.includes("solid")) return "Solid"
  return "Astro"
}
const normalizeSources = (groupSources: SourceFile[], mode: SourceMode): SourceRecord[] =>
  groupSources.map((source) => ({ ...source, framework: frameworkOf(source), mode }))
const generatedSources =
  generatedFamilies.length > 0 ? generatedSourcesFor(...generatedFamilies) : sources
const sourceGroups: {
  description: string
  label: string
  mode: SourceMode
  sources: SourceFile[]
}[] = [
  ...(hasPreview
    ? [
        {
          description: "Exact rendered source",
          label: "Rendered",
          mode: "visible" as const,
          sources: previewSources,
        },
      ]
    : []),
  ...(hasUsage
    ? [
        {
          description: "Copy-ready composition",
          label: "Minimal",
          mode: "minimal" as const,
          sources: usageSources,
        },
      ]
    : []),
  {
    description: "Install output",
    label: "Generated",
    mode: "generated",
    sources: generatedSources,
  },
]
const records = sourceGroups.flatMap(({ mode, sources: groupSources }) =>
  normalizeSources(groupSources, mode)
)
const frameworks = (["React", "Solid", "Astro"] as const).filter((framework) =>
  records.some((record) => record.framework === framework)
)
const initialModeFrameworks = frameworks.filter((framework) =>
  records.some((record) => record.mode === initialMode && record.framework === framework)
)
const initialFramework: Framework = initialModeFrameworks.includes("React") ? "React" : "Astro"
const firstSource =
  records.find((record) => record.mode === initialMode && record.framework === initialFramework) ??
  records[0]
const fileName = (source: SourceRecord) => source.filename.split("/").at(-1) ?? source.filename
const fileIconTone = (source: SourceRecord) =>
  source.framework === "Solid" ? "solid" : source.language === "tsx" ? "react" : source.language
---

<section class="source-inspector" data-source-inspector aria-labelledby={`${inspectorId}-title`}>
  <header class="source-head">
    <div class="source-heading">
      <h3 id={`${inspectorId}-title`} class="sr-only">{component} source code</h3>

      <div class="source-controls">
        <label class="source-framework-field">
          <span class="sr-only">{component} framework</span>
          <select data-source-framework-select aria-label={`${component} framework`}>
            {
              frameworks.map((framework) => (
                <option value={framework} selected={framework === initialFramework}>
                  {framework}
                </option>
              ))
            }
          </select>
          <ChevronDown aria-hidden="true" />
        </label>

        {
          sourceGroups.length > 1 && (
            <div class="source-mode-tabs" role="tablist" aria-label={`${component} source scope`}>
              {sourceGroups.map(({ description, label, mode }) => (
                <button
                  class="source-mode-tab"
                  type="button"
                  role="tab"
                  aria-selected={mode === initialMode ? "true" : "false"}
                  tabindex={mode === initialMode ? 0 : -1}
                  title={`${label}: ${description}`}
                  data-source-mode={mode}
                >
                  <span class="source-mode-name">{label}</span>
                  <span class="sr-only">{description}</span>
                </button>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <div class="source-head-actions">
      <button class="copy-button" type="button" data-copy-source>
        <svg aria-hidden="true" viewBox="0 0 16 16">
          <path
            d="M5.5 4.5v-2h8v8h-2m-9-6h8v9h-8z"
            fill="none"
            stroke="currentColor"
            stroke-linejoin="round"></path>
        </svg>
        <span data-copy-label>Copy</span>
      </button>
    </div>
  </header>

  <div class="source-toolbar">
    {
      sourceGroups.flatMap(({ label, mode }) =>
        frameworks.map((framework) => {
          const groupRecords = records.filter(
            (record) => record.mode === mode && record.framework === framework
          )
          if (groupRecords.length === 0) return null

          return (
            <div
              class="source-tab-group"
              data-source-files={`${framework}:${mode}`}
              hidden={mode !== initialMode || framework !== initialFramework}
            >
              <div
                class="source-tabs"
                role="tablist"
                aria-label={`${component} ${framework} ${label.toLowerCase()} files`}
              >
                {groupRecords.map((source, groupIndex) => {
                  const recordIndex = records.indexOf(source)
                  const selected = source === firstSource

                  return (
                    <button
                      id={`${inspectorId}-${framework.toLowerCase()}-${mode}-tab-${groupIndex}`}
                      class="source-tab"
                      type="button"
                      role="tab"
                      aria-selected={selected ? "true" : "false"}
                      tabindex={selected ? 0 : -1}
                      data-source-index={recordIndex}
                      data-source-tab
                    >
                      <span
                        class:list={[
                          "source-file-icon",
                          `source-file-icon--${fileIconTone(source)}`,
                        ]}
                        aria-hidden="true"
                      >
                        {source.language === "css"
                          ? "CSS"
                          : source.language === "astro"
                            ? "A"
                            : source.language === "ts"
                              ? "TS"
                              : "R"}
                      </span>
                      <span class="source-tab-label">{fileName(source)}</span>
                    </button>
                  )
                })}
              </div>
            </div>
          )
        })
      )
    }

    <CodeBlockPath class="source-meta">
      <p class="source-path" data-source-path>{firstSource?.filename}</p>
      <span class="source-diagnostics" data-diagnostics data-state="pending" aria-live="polite"
        >Plain source</span
      >
    </CodeBlockPath>
  </div>

  <div class="source-records" hidden>
    {
      records.map((source) =>
        // prettier-ignore
        <template data-filename={source.filename} data-framework={source.framework} data-language={source.language} data-mode={source.mode} data-source-record>{source.code}</template>
      )
    }
  </div>

  <div class="editor-stage" data-source-output>
    {
      firstSource && (
        <CodeBlock>
          <CodeBlockContent code={firstSource.code} language={firstSource.language} lineNumbers />
        </CodeBlock>
      )
    }
  </div>
</section>

<script>
  import { observeSourceInspectors } from "../lib/source-inspector-loader"

  observeSourceInspectors()
  document.addEventListener("astro:page-load", observeSourceInspectors)
</script>
