---
import { ChevronDown } from "@lucide/astro"
import { css } from "@tanstack/highlight/languages/css"
import { html } from "@tanstack/highlight/languages/html"
import { ts } from "@tanstack/highlight/languages/ts"
import { tsx } from "@tanstack/highlight/languages/tsx"
import CodeBlock from "@/ui/code/code-block.astro"
import CodeBlockContent from "@/ui/code/code-block-content.astro"
import CodeBlockPath from "@/ui/code/code-block-path.astro"
import { createTanStackCodeHighlighter } from "@/ui/code-highlighter-tanstack/code-highlighter-tanstack"
import { generatedSourcesFor, type CatalogSourceLanguage } from "../data/generatedCatalogSources"
import { astro } from "../lib/tanstack-astro"

type SourceFile = {
  code: string
  filename: string
  framework: string
  label?: string
  language: CatalogSourceLanguage
}

type Props = {
  component: string
  generatedFamilies?: string[]
  previewSources?: SourceFile[]
  sources?: SourceFile[]
  usageSources?: SourceFile[]
}

type SourceMode = "visible" | "minimal" | "generated"
type Framework = "Astro" | "React" | "Solid"
type SourceRecord = Omit<SourceFile, "framework"> & {
  framework: Framework
  mode: SourceMode
}

const {
  component,
  generatedFamilies = [],
  previewSources = [],
  sources = [],
  usageSources = [],
} = Astro.props
const inspectorId = `${component.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}-source`
const hasUsage = usageSources.length > 0
const hasPreview = previewSources.length > 0
const initialMode: SourceMode = hasPreview ? "visible" : hasUsage ? "minimal" : "generated"
const frameworkOf = (source: SourceFile): Framework => {
  const framework = source.framework.toLowerCase()
  if (framework.includes("react")) return "React"
  if (framework.includes("solid")) return "Solid"
  return "Astro"
}
const normalizeSources = (groupSources: SourceFile[], mode: SourceMode): SourceRecord[] =>
  groupSources.map((source) => ({ ...source, framework: frameworkOf(source), mode }))
const generatedSources =
  generatedFamilies.length > 0 ? generatedSourcesFor(...generatedFamilies) : sources
const sourceGroups: {
  description: string
  label: string
  mode: SourceMode
  sources: SourceFile[]
}[] = [
  ...(hasPreview
    ? [
        {
          description: "Exact rendered source",
          label: "Rendered",
          mode: "visible" as const,
          sources: previewSources,
        },
      ]
    : []),
  ...(hasUsage
    ? [
        {
          description: "Copy-ready composition",
          label: "Minimal",
          mode: "minimal" as const,
          sources: usageSources,
        },
      ]
    : []),
  {
    description: "Install output",
    label: "Generated",
    mode: "generated",
    sources: generatedSources,
  },
]
const records = sourceGroups.flatMap(({ mode, sources: groupSources }) =>
  normalizeSources(groupSources, mode)
)
const frameworks = (["React", "Solid", "Astro"] as const).filter((framework) =>
  records.some((record) => record.framework === framework)
)
const initialModeFrameworks = frameworks.filter((framework) =>
  records.some((record) => record.mode === initialMode && record.framework === framework)
)
const initialFramework: Framework = initialModeFrameworks.includes("React") ? "React" : "Astro"
const firstSource =
  records.find((record) => record.mode === initialMode && record.framework === initialFramework) ??
  records[0]
const fileName = (source: SourceRecord) => source.filename.split("/").at(-1) ?? source.filename
const fileIconTone = (source: SourceRecord) =>
  source.framework === "Solid" ? "solid" : source.language === "tsx" ? "react" : source.language
const highlighter = createTanStackCodeHighlighter({
  fallbackLanguage: "ts",
  languages: [astro, css, html, ts, tsx],
})
const firstHighlighted = firstSource
  ? highlighter.highlight(firstSource.code, { language: firstSource.language })
  : undefined
---

<section class="source-inspector" data-source-inspector aria-labelledby={`${inspectorId}-title`}>
  <header class="source-head">
    <div class="source-heading">
      <h3 id={`${inspectorId}-title`} class="sr-only">{component} source code</h3>

      <div class="source-controls">
        <label class="source-framework-field">
          <span class="sr-only">{component} framework</span>
          <select data-source-framework-select aria-label={`${component} framework`}>
            {
              frameworks.map((framework) => (
                <option value={framework} selected={framework === initialFramework}>
                  {framework}
                </option>
              ))
            }
          </select>
          <ChevronDown aria-hidden="true" />
        </label>

        {
          sourceGroups.length > 1 && (
            <div class="source-mode-tabs" role="tablist" aria-label={`${component} source scope`}>
              {sourceGroups.map(({ description, label, mode }) => (
                <button
                  class="source-mode-tab"
                  type="button"
                  role="tab"
                  aria-selected={mode === initialMode ? "true" : "false"}
                  tabindex={mode === initialMode ? 0 : -1}
                  title={`${label}: ${description}`}
                  data-source-mode={mode}
                >
                  <span class="source-mode-name">{label}</span>
                  <span class="sr-only">{description}</span>
                </button>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <div class="source-head-actions">
      <button class="copy-button" type="button" data-copy-source>
        <svg aria-hidden="true" viewBox="0 0 16 16">
          <path
            d="M5.5 4.5v-2h8v8h-2m-9-6h8v9h-8z"
            fill="none"
            stroke="currentColor"
            stroke-linejoin="round"></path>
        </svg>
        <span data-copy-label>Copy</span>
      </button>
    </div>
  </header>

  <div class="source-toolbar">
    {
      sourceGroups.flatMap(({ label, mode }) =>
        frameworks.map((framework) => {
          const groupRecords = records.filter(
            (record) => record.mode === mode && record.framework === framework
          )
          if (groupRecords.length === 0) return null

          return (
            <div
              class="source-tab-group"
              data-source-files={`${framework}:${mode}`}
              hidden={mode !== initialMode || framework !== initialFramework}
            >
              <div
                class="source-tabs"
                role="tablist"
                aria-label={`${component} ${framework} ${label.toLowerCase()} files`}
              >
                {groupRecords.map((source, groupIndex) => {
                  const recordIndex = records.indexOf(source)
                  const selected = source === firstSource

                  return (
                    <button
                      id={`${inspectorId}-${framework.toLowerCase()}-${mode}-tab-${groupIndex}`}
                      class="source-tab"
                      type="button"
                      role="tab"
                      aria-selected={selected ? "true" : "false"}
                      tabindex={selected ? 0 : -1}
                      data-source-index={recordIndex}
                      data-source-tab
                    >
                      <span
                        class:list={[
                          "source-file-icon",
                          `source-file-icon--${fileIconTone(source)}`,
                        ]}
                        aria-hidden="true"
                      >
                        {source.language === "css"
                          ? "CSS"
                          : source.language === "astro"
                            ? "A"
                            : source.language === "ts"
                              ? "TS"
                              : "R"}
                      </span>
                      <span class="source-tab-label">{fileName(source)}</span>
                    </button>
                  )
                })}
              </div>
            </div>
          )
        })
      )
    }

    <CodeBlockPath class="source-meta">
      <p class="source-path" data-source-path>{firstSource?.filename}</p>
      <span class="source-diagnostics" data-diagnostics data-state="ready" aria-live="polite"
        >Server highlighted</span
      >
    </CodeBlockPath>
  </div>

  <div class="source-records" hidden>
    {
      records.map((source) =>
        // prettier-ignore
        <template data-filename={source.filename} data-framework={source.framework} data-language={source.language} data-mode={source.mode} data-source-record>{source.code}</template>
      )
    }
  </div>

  <div class="editor-stage" data-source-output>
    {
      firstSource && (
        <CodeBlock>
          <CodeBlockContent highlighted={firstHighlighted} lineNumbers />
        </CodeBlock>
      )
    }
  </div>
</section>

<script>
  import { css } from "@tanstack/highlight/languages/css"
  import { html } from "@tanstack/highlight/languages/html"
  import { ts } from "@tanstack/highlight/languages/ts"
  import { tsx } from "@tanstack/highlight/languages/tsx"
  import { createTanStackCodeHighlighter } from "@/ui/code-highlighter-tanstack/code-highlighter-tanstack"
  import { astro } from "../lib/tanstack-astro"

  type SourceMode = "visible" | "minimal" | "generated"
  type SourceRecord = {
    code: string
    filename: string
    framework: string
    language: "astro" | "css" | "ts" | "tsx"
    mode: SourceMode
  }

  const highlighter = createTanStackCodeHighlighter({
    fallbackLanguage: "ts",
    languages: [astro, css, html, ts, tsx],
  })

  const statusFor = (record: SourceRecord) => {
    if (record.mode === "visible") return "Exact render"
    if (record.mode === "minimal") return "Copy-ready"
    return "Generated source"
  }

  const renderHighlightedSource = (output: HTMLElement, record: SourceRecord) => {
    const highlighted = highlighter.highlight(record.code, { language: record.language })
    const pre = document.createElement("pre")
    pre.tabIndex = 0
    pre.dataset.language = highlighted.language
    pre.dataset.lineNumbers = "true"
    pre.dataset.slot = "code-block-content"
    pre.className =
      "group/code-content m-0 min-w-0 overflow-auto bg-[var(--hulla-code-background)] py-4 font-mono text-[0.8125rem] leading-6 text-[var(--hulla-code-foreground)] [tab-size:2] whitespace-pre focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-focus-ring"

    const code = document.createElement("code")
    code.dataset.slot = "code-block-code"
    highlighted.lines.forEach((line, index) => {
      const lineElement = document.createElement("span")
      lineElement.dataset.codeLine = ""
      lineElement.dataset.line = String(index + 1)
      lineElement.className =
        "relative inline-block min-h-6 min-w-full border-l-2 border-transparent px-4"
      line.tokens.forEach((token) => {
        const tokenElement = document.createElement("span")
        if (token.className) tokenElement.className = token.className
        tokenElement.textContent = token.content
        lineElement.append(tokenElement)
      })
      code.append(lineElement)
      if (index < highlighted.lines.length - 1) code.append("\n")
    })
    pre.append(code)

    const block = document.createElement("div")
    block.dataset.slot = "code-block"
    block.className =
      "group/code-block min-w-0 overflow-hidden rounded-md border border-border bg-surface-raised text-foreground shadow-sm"
    block.append(pre)
    output.replaceChildren(block)
  }

  const initializeSourceInspector = (inspector: HTMLElement) => {
    if (inspector.dataset.sourceInspectorReady === "true") return

    const tabs = Array.from(inspector.querySelectorAll<HTMLButtonElement>("[data-source-tab]"))
    const frameworkSelect = inspector.querySelector<HTMLSelectElement>(
      "[data-source-framework-select]"
    )
    const modeTabs = Array.from(inspector.querySelectorAll<HTMLButtonElement>("[data-source-mode]"))
    const tabGroups = Array.from(inspector.querySelectorAll<HTMLElement>("[data-source-files]"))
    const records = Array.from(
      inspector.querySelectorAll<HTMLTemplateElement>("[data-source-record]")
    ).map(
      (template): SourceRecord => ({
        code: template.content.textContent ?? "",
        filename: template.dataset.filename ?? "generated/source.ts",
        framework: template.dataset.framework ?? "Source",
        language:
          template.dataset.language === "tsx"
            ? "tsx"
            : template.dataset.language === "ts"
              ? "ts"
              : template.dataset.language === "css"
                ? "css"
                : "astro",
        mode:
          template.dataset.mode === "visible" || template.dataset.mode === "minimal"
            ? template.dataset.mode
            : "generated",
      })
    )
    const output = inspector.querySelector<HTMLElement>("[data-source-output]")
    const path = inspector.querySelector<HTMLElement>("[data-source-path]")
    const diagnostics = inspector.querySelector<HTMLElement>("[data-diagnostics]")
    const copyButton = inspector.querySelector<HTMLButtonElement>("[data-copy-source]")
    const copyLabel = inspector.querySelector<HTMLElement>("[data-copy-label]")
    if (!output || records.length === 0) return

    inspector.dataset.sourceInspectorReady = "true"
    const lifecycle = new AbortController()
    let activeIndex = Number(
      inspector.querySelector<HTMLButtonElement>('[data-source-tab][aria-selected="true"]')?.dataset
        .sourceIndex ?? 0
    )

    const selectSource = (index: number, moveFocus = false) => {
      const record = records[index]
      if (!record) return
      activeIndex = index

      tabs.forEach((tab) => {
        const selected = Number(tab.dataset.sourceIndex) === index
        tab.setAttribute("aria-selected", String(selected))
        tab.tabIndex = selected ? 0 : -1
        if (selected && moveFocus) tab.focus()
      })
      modeTabs.forEach((tab) => {
        const selected = tab.dataset.sourceMode === record.mode
        tab.setAttribute("aria-selected", String(selected))
        tab.tabIndex = selected ? 0 : -1
      })
      if (frameworkSelect) frameworkSelect.value = record.framework
      tabGroups.forEach((group) => {
        group.hidden = group.dataset.sourceFiles !== `${record.framework}:${record.mode}`
      })

      renderHighlightedSource(output, record)
      if (path) path.textContent = record.filename
      if (diagnostics) {
        diagnostics.textContent = statusFor(record)
        diagnostics.dataset.state = "ready"
      }
    }

    tabs.forEach((tab) => {
      const index = Number(tab.dataset.sourceIndex)
      tab.addEventListener("click", () => selectSource(index), { signal: lifecycle.signal })
      tab.addEventListener(
        "keydown",
        (event) => {
          const groupTabs = Array.from(
            tab
              .closest("[data-source-files]")
              ?.querySelectorAll<HTMLButtonElement>("[data-source-tab]") ?? []
          )
          const currentPosition = groupTabs.indexOf(tab)
          let nextPosition = currentPosition
          if (event.key === "ArrowRight") nextPosition = (currentPosition + 1) % groupTabs.length
          if (event.key === "ArrowLeft") {
            nextPosition = (currentPosition - 1 + groupTabs.length) % groupTabs.length
          }
          if (event.key === "Home") nextPosition = 0
          if (event.key === "End") nextPosition = groupTabs.length - 1
          if (nextPosition === currentPosition) return
          event.preventDefault()
          selectSource(Number(groupTabs[nextPosition]?.dataset.sourceIndex), true)
        },
        { signal: lifecycle.signal }
      )
    })

    modeTabs.forEach((tab, index) => {
      tab.addEventListener(
        "click",
        () => {
          const activeFramework = records[activeIndex]?.framework
          let recordIndex = records.findIndex(
            ({ framework, mode }) =>
              framework === activeFramework && mode === tab.dataset.sourceMode
          )
          if (recordIndex < 0) {
            recordIndex = records.findIndex(({ mode }) => mode === tab.dataset.sourceMode)
          }
          selectSource(recordIndex)
        },
        { signal: lifecycle.signal }
      )
      tab.addEventListener(
        "keydown",
        (event) => {
          let nextIndex = index
          if (event.key === "ArrowRight") nextIndex = (index + 1) % modeTabs.length
          if (event.key === "ArrowLeft") {
            nextIndex = (index - 1 + modeTabs.length) % modeTabs.length
          }
          if (event.key === "Home") nextIndex = 0
          if (event.key === "End") nextIndex = modeTabs.length - 1
          if (nextIndex === index) return
          event.preventDefault()
          modeTabs[nextIndex]?.click()
          modeTabs[nextIndex]?.focus()
        },
        { signal: lifecycle.signal }
      )
    })

    frameworkSelect?.addEventListener(
      "change",
      () => {
        const activeMode = records[activeIndex]?.mode
        let recordIndex = records.findIndex(
          ({ framework, mode }) => framework === frameworkSelect.value && mode === activeMode
        )
        if (recordIndex < 0) {
          recordIndex = records.findIndex(({ framework }) => framework === frameworkSelect.value)
        }
        selectSource(recordIndex)
      },
      { signal: lifecycle.signal }
    )

    copyButton?.addEventListener(
      "click",
      async () => {
        const source = records[activeIndex]?.code
        if (!source || !copyLabel) return
        try {
          await navigator.clipboard.writeText(source)
          copyLabel.textContent = "Copied"
          window.setTimeout(() => {
            copyLabel.textContent = "Copy"
          }, 1600)
        } catch {
          copyLabel.textContent = "Copy failed"
        }
      },
      { signal: lifecycle.signal }
    )
  }

  const initializeSourceInspectors = (root: ParentNode = document) => {
    if (root instanceof HTMLElement && root.matches("[data-source-inspector]")) {
      initializeSourceInspector(root)
    }
    root.querySelectorAll<HTMLElement>("[data-source-inspector]").forEach(initializeSourceInspector)
  }

  initializeSourceInspectors()
  document.addEventListener("astro:page-load", () => initializeSourceInspectors())
</script>
