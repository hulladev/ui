---
import { Code } from "astro:components"
import { ChevronDown } from "@lucide/astro"
import { generatedSourcesFor, type CatalogSourceLanguage } from "../data/generatedCatalogSources"

type SourceFile = {
  code: string
  filename: string
  framework: string
  label?: string
  language: CatalogSourceLanguage
}

type Props = {
  component: string
  generatedFamilies?: string[]
  previewSources?: SourceFile[]
  sources?: SourceFile[]
  usageSources?: SourceFile[]
}

type SourceMode = "visible" | "minimal" | "generated"
type Framework = "Astro" | "React"
type SourceRecord = Omit<SourceFile, "framework"> & {
  framework: Framework
  mode: SourceMode
}

const {
  component,
  generatedFamilies = [],
  previewSources = [],
  sources = [],
  usageSources = [],
} = Astro.props
const inspectorId = `${component.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}-source`
const hasUsage = usageSources.length > 0
const hasPreview = previewSources.length > 0
const initialMode: SourceMode = hasPreview ? "visible" : hasUsage ? "minimal" : "generated"
const frameworkOf = (source: SourceFile): Framework =>
  source.framework.toLowerCase().includes("react") ? "React" : "Astro"
const normalizeSources = (groupSources: SourceFile[], mode: SourceMode): SourceRecord[] =>
  groupSources.map((source) => ({
    ...source,
    framework: frameworkOf(source),
    mode,
  }))
const generatedSources =
  generatedFamilies.length > 0 ? generatedSourcesFor(...generatedFamilies) : sources
const sourceGroups: {
  description: string
  label: string
  mode: SourceMode
  sources: SourceFile[]
}[] = [
  ...(hasPreview
    ? [
        {
          description: "Preview code",
          label: "Visible",
          mode: "visible" as const,
          sources: previewSources,
        },
      ]
    : []),
  ...(hasUsage
    ? [
        {
          description: "Quick start",
          label: "Minimal",
          mode: "minimal" as const,
          sources: usageSources,
        },
      ]
    : []),
  {
    description: "Install output",
    label: "Generated",
    mode: "generated",
    sources: generatedSources,
  },
]
const records = sourceGroups.flatMap(({ mode, sources: groupSources }) =>
  normalizeSources(groupSources, mode)
)
const frameworks = (["React", "Astro"] as const).filter((framework) =>
  records.some((record) => record.framework === framework)
)
const initialFramework: Framework = frameworks.includes("React") ? "React" : "Astro"
const firstSource =
  records.find((record) => record.mode === initialMode && record.framework === initialFramework) ??
  records[0]
const fileName = (source: SourceRecord) => source.filename.split("/").at(-1) ?? source.filename
const fileIconTone = (source: SourceRecord) =>
  source.language === "tsx" ? "react" : source.language
---

<section class="source-inspector" data-source-inspector aria-labelledby={`${inspectorId}-title`}>
  <header class="source-head">
    <div class="source-heading">
      <h3 id={`${inspectorId}-title`} class="sr-only">{component} source code</h3>

      <div class="source-controls">
        <label class="source-framework-field">
          <span class="sr-only">{component} framework</span>
          <select data-source-framework-select aria-label={`${component} framework`}>
            {
              frameworks.map((framework) => (
                <option value={framework} selected={framework === initialFramework}>
                  {framework}
                </option>
              ))
            }
          </select>
          <ChevronDown aria-hidden="true" />
        </label>

        {
          sourceGroups.length > 1 && (
            <div class="source-mode-tabs" role="tablist" aria-label={`${component} source scope`}>
              {sourceGroups.map(({ description, label, mode }) => (
                <button
                  class="source-mode-tab"
                  type="button"
                  role="tab"
                  aria-selected={mode === initialMode ? "true" : "false"}
                  tabindex={mode === initialMode ? 0 : -1}
                  title={`${label}: ${description}`}
                  data-source-mode={mode}
                >
                  <span class="source-mode-name">{label}</span>
                  <span class="sr-only">{description}</span>
                </button>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <div class="source-head-actions">
      <button class="copy-button" type="button" data-copy-source>
        <svg aria-hidden="true" viewBox="0 0 16 16">
          <path
            d="M5.5 4.5v-2h8v8h-2m-9-6h8v9h-8z"
            fill="none"
            stroke="currentColor"
            stroke-linejoin="round"></path>
        </svg>
        <span data-copy-label>Copy</span>
      </button>
    </div>
  </header>

  <div class="source-toolbar">
    {
      sourceGroups.flatMap(({ label, mode }) =>
        frameworks.map((framework) => {
          const groupRecords = records.filter(
            (record) => record.mode === mode && record.framework === framework
          )
          if (groupRecords.length === 0) return null

          return (
            <div
              class="source-tab-group"
              data-source-files={`${framework}:${mode}`}
              hidden={mode !== initialMode || framework !== initialFramework}
            >
              <div
                class="source-tabs"
                role="tablist"
                aria-label={`${component} ${framework} ${label.toLowerCase()} files`}
              >
                {groupRecords.map((source, groupIndex) => {
                  const recordIndex = records.indexOf(source)
                  const selected = source === firstSource

                  return (
                    <button
                      id={`${inspectorId}-${framework.toLowerCase()}-${mode}-tab-${groupIndex}`}
                      class="source-tab"
                      type="button"
                      role="tab"
                      aria-selected={selected ? "true" : "false"}
                      tabindex={selected ? 0 : -1}
                      data-source-index={recordIndex}
                      data-source-tab
                    >
                      <span
                        class:list={[
                          "source-file-icon",
                          `source-file-icon--${fileIconTone(source)}`,
                        ]}
                        aria-hidden="true"
                      >
                        {source.language === "css" ? (
                          <svg viewBox="0 0 24 24">
                            <path
                              d="M4.4 2.5h15.2l-1.4 16L12 21.5l-6.2-3-1.4-16Z"
                              fill="currentColor"
                            />
                            <path
                              d="M8 7.2h8.3l-.2 2.1-5.8 2.5 5.4-.1-.5 4.1-3.2 1.5-3.1-1.5-.2-2.2h2.1l.1.9 1.1.5 1.2-.6.1-.9-6.6.1-.2-2 5.9-2.4H7.8L8 7.2Z"
                              fill="var(--source-icon-ink)"
                            />
                          </svg>
                        ) : source.language === "astro" ? (
                          <svg viewBox="0 0 24 24">
                            <path
                              d="M8.1 15.8 12 3l3.9 12.8-3.7-2.2a.4.4 0 0 0-.4 0l-3.7 2.2Z"
                              fill="currentColor"
                            />
                            <path
                              d="M8.6 17.1c.8 1.8 1.9 2.8 3.4 3.1 1.5-.3 2.6-1.3 3.4-3.1-1 .5-2.1.8-3.4.8s-2.4-.3-3.4-.8Z"
                              fill="var(--source-icon-accent)"
                            />
                          </svg>
                        ) : source.language === "ts" ? (
                          <svg viewBox="0 0 24 24">
                            <rect
                              width="19"
                              height="19"
                              x="2.5"
                              y="2.5"
                              rx="2.5"
                              fill="currentColor"
                            />
                            <path
                              d="M6.4 9.2h6v2h-1.9v6.1H8.3v-6.1H6.4v-2Zm6.3 7.1 1.1-1.5c.7.6 1.5.9 2.2.9.6 0 1-.2 1-.6 0-.4-.3-.6-1.4-1-1.5-.5-2.5-1.2-2.5-2.6 0-1.6 1.2-2.6 3.1-2.6 1.2 0 2.2.4 3 1.1L18 11.4c-.6-.5-1.2-.7-1.8-.7-.5 0-.8.2-.8.6 0 .4.4.6 1.5 1 1.6.5 2.4 1.2 2.4 2.6 0 1.6-1.2 2.7-3.3 2.7-1.3 0-2.5-.5-3.3-1.3Z"
                              fill="var(--source-icon-ink)"
                            />
                          </svg>
                        ) : (
                          <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="1.75" fill="currentColor" />
                            <ellipse
                              cx="12"
                              cy="12"
                              rx="9.1"
                              ry="3.65"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.35"
                            />
                            <ellipse
                              cx="12"
                              cy="12"
                              rx="9.1"
                              ry="3.65"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.35"
                              transform="rotate(60 12 12)"
                            />
                            <ellipse
                              cx="12"
                              cy="12"
                              rx="9.1"
                              ry="3.65"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.35"
                              transform="rotate(120 12 12)"
                            />
                          </svg>
                        )}
                      </span>
                      <span class="source-tab-label">{fileName(source)}</span>
                    </button>
                  )
                })}
              </div>
            </div>
          )
        })
      )
    }

    <div class="source-meta">
      <p class="source-path" data-source-path>{firstSource?.filename}</p>
      <span class="source-diagnostics" data-diagnostics>
        {
          firstSource?.language === "tsx" || firstSource?.language === "ts"
            ? "Types ready"
            : firstSource?.language === "css"
              ? "Demo styles"
              : "Exact render"
        }
      </span>
    </div>
  </div>

  <div class="source-records" hidden>
    {
      records.map((source) => (
        <input
          type="hidden"
          value={source.code}
          data-filename={source.filename}
          data-framework={source.framework}
          data-language={source.language}
          data-mode={source.mode}
          data-source-record
        />
      ))
    }
  </div>

  <div class="editor-stage">
    <div class="monaco-mount" data-monaco-mount></div>
    {
      firstSource && (
        <div class="editor-fallback" data-editor-fallback>
          <Code code={firstSource.code} lang={firstSource.language} theme="vesper" wrap={false} />
        </div>
      )
    }
  </div>
</section>

<script>
  import * as monaco from "monaco-editor/editor/editor.api"
  import EditorWorker from "monaco-editor/editor/editor.worker?worker"
  import "monaco-editor/editor/contrib/bracketMatching/browser/bracketMatching"
  import "monaco-editor/editor/contrib/find/browser/findController"
  import "monaco-editor/editor/contrib/gotoError/browser/gotoError"
  import "monaco-editor/editor/contrib/hover/browser/hoverContribution"
  import "monaco-editor/editor/contrib/suggest/browser/suggestController"
  import "monaco-editor/editor/contrib/wordHighlighter/browser/wordHighlighter"
  import "monaco-editor/languages/definitions/css/register"
  import "monaco-editor/languages/definitions/typescript/register"
  import CssWorker from "monaco-editor/languages/features/css/css.worker?worker"
  import * as tsLanguage from "monaco-editor/languages/features/typescript/register"
  import TypeScriptWorker from "monaco-editor/languages/features/typescript/ts.worker?worker"

  type MonacoEnvironment = {
    getWorker: (workerId: string, label: string) => Worker
  }
  ;(self as typeof self & { MonacoEnvironment: MonacoEnvironment }).MonacoEnvironment = {
    getWorker(workerId, label) {
      void workerId
      if (label === "css" || label === "less" || label === "scss") return new CssWorker()
      if (label === "typescript" || label === "javascript") return new TypeScriptWorker()
      return new EditorWorker()
    },
  }

  if (!monaco.languages.getLanguages().some(({ id }) => id === "astro")) {
    monaco.languages.register({
      id: "astro",
      extensions: [".astro"],
      aliases: ["Astro"],
    })
    monaco.languages.setLanguageConfiguration("astro", {
      autoClosingPairs: [
        { open: "{", close: "}" },
        { open: "[", close: "]" },
        { open: "(", close: ")" },
        { open: '"', close: '"' },
        { open: "'", close: "'" },
        { open: "`", close: "`" },
      ],
      brackets: [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["<", ">"],
      ],
      comments: {
        blockComment: ["<!--", "-->"],
        lineComment: "//",
      },
    })
    monaco.languages.setMonarchTokensProvider("astro", {
      defaultToken: "",
      tokenPostfix: ".astro",
      tokenizer: {
        root: [
          [/^---\s*$/, { token: "delimiter.astro", next: "@frontmatter" }],
          [/<!--/, "comment", "@comment"],
          [/(<!DOCTYPE)(\s+)([^>]+)(>)/, ["metatag", "", "metatag.content", "metatag"]],
          [/(<\/?)([\w:-]+)/, ["delimiter", "tag"], "@tag"],
          [/{/, { token: "delimiter.bracket", next: "@expression" }],
        ],
        frontmatter: [
          [/^---\s*$/, { token: "delimiter.astro", next: "@root" }],
          [/\/\/.*$/, "comment"],
          [/\/\*/, "comment", "@jsComment"],
          [
            /\b(?:as|const|export|extends|from|import|interface|let|return|satisfies|type)\b/,
            "keyword",
          ],
          [/\b(?:Astro|false|null|true|undefined)\b/, "constant"],
          [/[A-Z][\w$]*/, "type.identifier"],
          [/[a-zA-Z_$][\w$]*(?=\s*\()/, "function"],
          [/"([^"\\]|\\.)*$/, "string.invalid"],
          [/'([^'\\]|\\.)*$/, "string.invalid"],
          [/"/, "string", "@doubleString"],
          [/'/, "string", "@singleString"],
          [/`/, "string", "@templateString"],
          [/\d+(?:\.\d+)?/, "number"],
        ],
        tag: [
          [/\s+/, ""],
          [/[\w:-]+/, "attribute.name"],
          [/=/, "delimiter"],
          [/"[^"]*"/, "attribute.value"],
          [/'[^']*'/, "attribute.value"],
          [/{/, { token: "delimiter.bracket", next: "@expression" }],
          [/\/?>/, { token: "delimiter", next: "@pop" }],
        ],
        expression: [
          [/}/, { token: "delimiter.bracket", next: "@pop" }],
          [/\b(?:as|await|const|else|false|if|let|null|return|true|typeof|undefined)\b/, "keyword"],
          [/[A-Z][\w$]*/, "type.identifier"],
          [/[a-zA-Z_$][\w$]*(?=\s*\()/, "function"],
          [/"/, "string", "@doubleString"],
          [/'/, "string", "@singleString"],
          [/`/, "string", "@templateString"],
          [/\d+(?:\.\d+)?/, "number"],
        ],
        comment: [
          [/-->/, "comment", "@pop"],
          [/./, "comment"],
        ],
        jsComment: [
          [/\*\//, "comment", "@pop"],
          [/./, "comment"],
        ],
        doubleString: [
          [/[^\\"]+/, "string"],
          [/\\./, "string.escape"],
          [/"/, "string", "@pop"],
        ],
        singleString: [
          [/[^\\']+/, "string"],
          [/\\./, "string.escape"],
          [/'/, "string", "@pop"],
        ],
        templateString: [
          [/[^\\`$]+/, "string"],
          [/\\./, "string.escape"],
          [/`/, "string", "@pop"],
        ],
      },
    })
  }

  const reactTypeStubs = `
declare module "react" {
  export type ReactNode =
    | JSX.Element
    | string
    | number
    | boolean
    | null
    | undefined
    | readonly ReactNode[]
  export type PropsWithChildren<P = unknown> = P & { children?: ReactNode }
  export type HTMLAttributes<T = HTMLElement> = {
    "aria-describedby"?: string
    "aria-haspopup"?: boolean | "dialog" | "grid" | "listbox" | "menu" | "tree"
    "aria-invalid"?: boolean | "false" | "true"
    "aria-label"?: string
    "aria-labelledby"?: string
    "aria-modal"?: boolean | "false" | "true"
    accept?: string
    children?: ReactNode
    className?: string
    defaultValue?: string | number | readonly string[]
    disabled?: boolean
    focusable?: boolean | "false" | "true"
    hidden?: boolean
    htmlFor?: string
    href?: string
    id?: string
    key?: string | number
    max?: number | string
    min?: number | string
    multiple?: boolean
    name?: string
    onClick?: (...args: unknown[]) => void
    placeholder?: string
    popover?: "auto" | "hint" | "manual"
    popoverTarget?: string
    popoverTargetAction?: "hide" | "show" | "toggle"
    readOnly?: boolean
    required?: boolean
    role?: string
    size?: number | string
    strokeWidth?: number
    style?: Record<string, string | number>
    tabIndex?: number
    type?: string
    value?: string | number | readonly string[]
    [attribute: \`data-\${string}\`]: string | number | boolean | undefined
  }
  export type ComponentPropsWithoutRef<T extends string> = HTMLAttributes
  export type ButtonHTMLAttributes<T> = HTMLAttributes<T>
  export type DetailedHTMLProps<E, T> = E
  export type MutableRefObject<T> = { current: T }

  export function useEffect(
    effect: () => void | (() => void),
    dependencies: readonly unknown[]
  ): void
  export function useId(): string
  export function useRef<T>(value: T): MutableRefObject<T>
  export function useRef<T>(value: T | null): MutableRefObject<T | null>
  export function useState<T>(
    initialValue: T
  ): [T, (value: T | ((previous: T) => T)) => void]
}

declare module "react/jsx-runtime" {
  export const Fragment: unique symbol
  export function jsx(type: unknown, props: unknown, key?: unknown): JSX.Element
  export function jsxs(type: unknown, props: unknown, key?: unknown): JSX.Element
}

declare namespace JSX {
  interface Element {}
  interface ElementChildrenAttribute {
    children: {}
  }
  interface IntrinsicAttributes {
    key?: string | number
  }
  interface IntrinsicElements {
    [elementName: string]: import("react").HTMLAttributes
  }
}
`

  const styleTypeStubs = `
declare module "@/lib/style" {
  type Variant<V extends Record<string, unknown>> = ((value: keyof V) => string) & {
    infer: keyof V
  }

  export const cn: (...classes: unknown[]) => string
  export const vn: <const V extends Record<string, unknown>>(variants: V) => Variant<V>
}

declare module "@/lib/dialog" {
  export type DialogDismissReason = "backdrop" | "escape"
  export function connectDialog(element: HTMLElement): { destroy(): void }
  export function onDialogDismiss(
    element: HTMLElement,
    callback: (event: CustomEvent<{ reason: DialogDismissReason }>) => void
  ): () => void
}

declare module "@/lib/dropdown-menu" {
  export function connectDropdownMenu(element: HTMLElement): { destroy(): void }
}

declare module "lucide-react" {
  export type LucideProps = import("react").SVGAttributes<SVGSVGElement> & {
    size?: number | string
    strokeWidth?: number | string
  }

  export function TriangleAlert(props: LucideProps): JSX.Element
}
`

  const componentTypeStubs = `
declare module "@/ui/button" {
  type NativeButtonProps = import("react").ComponentPropsWithoutRef<"button">
  export type ButtonProps = NativeButtonProps & {
    /** Controls the button height, text size, and horizontal padding. @default "md" */
    size?: "sm" | "md" | "lg"
    /** Selects the visual emphasis of the action. @default "primary" */
    variant?: "primary" | "secondary" | "outline"
  }
  /** A native button with Hulla variants, focus treatment, and disabled states. */
  export function Button(props: ButtonProps): JSX.Element
}

declare module "@/ui/badge" {
  type NativeBadgeProps = import("react").ComponentPropsWithoutRef<"span">
  export type BadgeProps = NativeBadgeProps & {
    /** Controls the badge height and icon scale. @default "md" */
    size?: "sm" | "md" | "lg"
    /** Communicates the semantic status through color. @default "neutral" */
    variant?: "neutral" | "primary" | "success" | "warning" | "danger"
  }
  /** Compact, non-interactive metadata built on a native span. */
  export function Badge(props: BadgeProps): JSX.Element
}

declare module "@/ui/kbd" {
  export type KbdProps = import("react").ComponentPropsWithoutRef<"kbd">
  /** Displays a keyboard input using the semantic kbd element. */
  export function Kbd(props: KbdProps): JSX.Element
}

declare module "@/ui/input" {
  type NativeInputProps = import("react").ComponentPropsWithoutRef<"input">
  export type InputProps = NativeInputProps & {
    /** Controls the input height and text size. @default "md" */
    controlSize?: "sm" | "md" | "lg"
    /** Selects the border and surface treatment. @default "outline" */
    variant?: "outline" | "filled" | "underline"
  }
  /** A styled native input that preserves native input types and attributes. */
  export function Input(props: InputProps): JSX.Element
}

declare module "@/ui/field" {
  type NativeDivProps = import("react").ComponentPropsWithoutRef<"div">
  type NativeLabelProps = import("react").ComponentPropsWithoutRef<"label">
  type NativeParagraphProps = import("react").ComponentPropsWithoutRef<"p">
  export type FieldProps = NativeDivProps
  export type FieldLabelProps = NativeLabelProps
  export type FieldDescriptionProps = NativeParagraphProps
  export type FieldErrorProps = NativeParagraphProps
  /** Groups a label, control, description, and validation message. */
  export function Field(props: FieldProps): JSX.Element
  /** A native label styled for a Hulla field. */
  export function FieldLabel(props: FieldLabelProps): JSX.Element
  /** Supporting text associated with a field through aria-describedby. */
  export function FieldDescription(props: FieldDescriptionProps): JSX.Element
  /** A validation message associated with an invalid field. */
  export function FieldError(props: FieldErrorProps): JSX.Element
}

declare module "@/ui/select" {
  type NativeSelectProps = import("react").ComponentPropsWithoutRef<"select">
  export type SelectProps = NativeSelectProps & {
    /** Controls the select height and text size. @default "md" */
    controlSize?: "sm" | "md" | "lg"
    /** Selects the border and surface treatment. @default "outline" */
    variant?: "outline" | "filled" | "underline"
  }
  /** A styled native select that preserves options, groups, and multiple selection. */
  export function Select(props: SelectProps): JSX.Element
}

declare module "@/ui/popover" {
  type NativePopoverProps = import("react").ComponentPropsWithoutRef<"div">
  export type PopoverPlacement =
    | "top-start" | "top" | "top-end"
    | "right-start" | "right" | "right-end"
    | "bottom-start" | "bottom" | "bottom-end"
    | "left-start" | "left" | "left-end"
  export type PopoverProps = NativePopoverProps & {
    /** Logical anchor placement with automatic collision fallbacks. @default "bottom" */
    placement?: PopoverPlacement
  }
  /** A native top-layer popover positioned with CSS anchors. */
  export function Popover(props: PopoverProps): JSX.Element
}

declare module "@/ui/dropdown-menu" {
  type NativeDivProps = import("react").ComponentPropsWithoutRef<"div">
  type NativeButtonProps = import("react").ComponentPropsWithoutRef<"button">
  type NativeRuleProps = import("react").ComponentPropsWithoutRef<"hr">
  export type DropdownMenuGroupProps = NativeDivProps
  export type DropdownMenuLabelProps = NativeDivProps
  export type DropdownMenuProps = NativeDivProps & {
    /** Logical anchor placement with automatic collision fallbacks. @default "bottom-start" */
    placement?:
      | "top-start" | "top" | "top-end"
      | "right-start" | "right" | "right-end"
      | "bottom-start" | "bottom" | "bottom-end"
      | "left-start" | "left" | "left-end"
  }
  export type DropdownMenuItemProps = NativeButtonProps & {
    /** Uses destructive styling for dangerous actions. @default "default" */
    variant?: "default" | "danger"
  }
  export type DropdownMenuSeparatorProps = NativeRuleProps
  /** Keyboard-navigable menu built on the native popover top layer. */
  export function DropdownMenu(props: DropdownMenuProps): JSX.Element
  /** A semantic group of related menu actions. */
  export function DropdownMenuGroup(props: DropdownMenuGroupProps): JSX.Element
  /** A roving-focus menu action. */
  export function DropdownMenuItem(props: DropdownMenuItemProps): JSX.Element
  /** A visible label that can name a menu group through aria-labelledby. */
  export function DropdownMenuLabel(props: DropdownMenuLabelProps): JSX.Element
  /** A semantic separator between related menu actions. */
  export function DropdownMenuSeparator(props: DropdownMenuSeparatorProps): JSX.Element
}

declare module "@/ui/dialog" {
  type NativeDialogProps = import("react").ComponentPropsWithoutRef<"div">
  export type DialogDismissReason = "backdrop" | "escape"
  export type DialogProps = NativeDialogProps & {
    /** Allows Escape and backdrop dismissal. @default true */
    dismissible?: boolean
    /** Called when the user dismisses the dialog. */
    onDismiss?: (reason: DialogDismissReason) => void
    /** Controls the dialog's layout scale and surface treatment. @default "compact" */
    variant?: "compact" | "workspace" | "fullscreen"
  }
  /** A focus-managed modal surface registered with Hulla's deterministic layer stack. */
