import CalendarCatalog from "../components/catalog/CalendarCatalog.astro"
import DatePickerCatalog from "../components/catalog/DatePickerCatalog.astro"
import TimePickerCatalog from "../components/catalog/TimePickerCatalog.astro"
import TextareaCatalog from "../components/catalog/TextareaCatalog.astro"
import CheckboxCatalog from "../components/catalog/CheckboxCatalog.astro"
