---
import AlertDescription from "@/ui/alert/alert-description.astro"
import AlertTitle from "@/ui/alert/alert-title.astro"
import Alert from "@/ui/alert/alert.astro"
import Skeleton from "@/ui/skeleton/skeleton.astro"
import InputAdornment from "@/ui/input/input-adornment.astro"
import InputGroup from "@/ui/input/input-group.astro"
import Input from "@/ui/input/input.astro"
import Badge from "@/ui/badge/badge.astro"
import SidebarMenuLink from "@/ui/sidebar/sidebar-menu-link.astro"
import SidebarMenuItem from "@/ui/sidebar/sidebar-menu-item.astro"
import SidebarMenu from "@/ui/sidebar/sidebar-menu.astro"
import SidebarGroupLabel from "@/ui/sidebar/sidebar-group-label.astro"
import SidebarGroup from "@/ui/sidebar/sidebar-group.astro"
import SidebarContent from "@/ui/sidebar/sidebar-content.astro"
import Sidebar from "@/ui/sidebar/sidebar.astro"
import AvatarFallback from "@/ui/avatar/avatar-fallback.astro"
import Avatar from "@/ui/avatar/avatar.astro"
import Button from "@/ui/button/button.astro"
import DialogDescription from "@/ui/dialog/dialog-description.astro"
import DialogFooter from "@/ui/dialog/dialog-footer.astro"
import DialogHeader from "@/ui/dialog/dialog-header.astro"
import DialogTitle from "@/ui/dialog/dialog-title.astro"
import Dialog from "@/ui/dialog/dialog.astro"
import Kbd from "@/ui/kbd/kbd.astro"
import NavigationMenuItem from "@/ui/navigation-menu/navigation-menu-item.astro"
import NavigationMenuLink from "@/ui/navigation-menu/navigation-menu-link.astro"
import NavigationMenuList from "@/ui/navigation-menu/navigation-menu-list.astro"
import NavigationMenu from "@/ui/navigation-menu/navigation-menu.astro"
import Switch from "@/ui/switch/switch.astro"
import "../styles/showcase.css"

const activity = [
  { label: "Scope approved", meta: "Launch / 09:42", tone: "success" },
  { label: "Briefing assembled", meta: "Atlas / 09:18", tone: "accent" },
  { label: "Two risks surfaced", meta: "Monitor / 08:51", tone: "warning" },
]

const integrations = ["Linear", "Notion", "Slack", "Figma", "Drive"]
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Orbit is a fictional operations workspace demonstrating the Hulla default theme."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Orbit — Hulla default theme showcase</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("hulla-showcase-theme")
        if (savedTheme === "light" || savedTheme === "dark") {
          document.documentElement.dataset.theme = savedTheme
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="ambient" aria-hidden="true">
      <span class="ambient-orb ambient-orb--one"></span>
      <span class="ambient-orb ambient-orb--two"></span>
      <span class="ambient-grid"></span>
    </div>

    <header class="site-nav glass-panel">
      <a class="wordmark" href="/showcase" aria-label="Orbit home">
        <span class="orbit-mark" aria-hidden="true"><span></span></span>
        <span>ORBIT</span>
      </a>

      <div class="site-links">
        <NavigationMenu data-showcase-component aria-label="Primary navigation">
          <NavigationMenuList data-showcase-component>
            <NavigationMenuItem data-showcase-component>
              <NavigationMenuLink data-showcase-component href="#system">System</NavigationMenuLink>
            </NavigationMenuItem>
            <NavigationMenuItem data-showcase-component>
              <NavigationMenuLink data-showcase-component href="#method">Method</NavigationMenuLink>
            </NavigationMenuItem>
            <NavigationMenuItem data-showcase-component>
              <NavigationMenuLink data-showcase-component href="#stories"
                >Stories</NavigationMenuLink
              >
            </NavigationMenuItem>
          </NavigationMenuList>
        </NavigationMenu>
      </div>

      <div class="nav-actions">
        <div class="system-state">
          <Badge data-showcase-component variant="success" size="sm">Systems nominal</Badge>
        </div>
        <label class="theme-switch" for="theme-toggle">
          <span class="sr-only">Use light theme</span>
          <Switch data-showcase-component id="theme-toggle" />
        </label>
        <a class="nav-cta" href="#start">Open workspace <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span></span>Operational intelligence, quietly applied</p>
          <h1>Keep the important work in orbit.</h1>
          <p class="hero-lede">
            Orbit turns the scattered signals across your company into one calm, legible operating
            picture—before another meeting has to.
          </p>

          <div class="hero-actions">
            <a class="action action--primary" href="#start">
              Start a workspace <span aria-hidden="true">↗</span>
            </a>
            <a class="action action--quiet" href="#system">
              See the system <span aria-hidden="true">↓</span>
            </a>
          </div>

          <div class="hero-proof" aria-label="Product facts">
            <div><strong>8.4h</strong><span>reclaimed weekly</span></div>
            <div><strong>94%</strong><span>signal accuracy</span></div>
            <div><strong>2 min</strong><span>to first briefing</span></div>
          </div>
        </div>

        <div class="hero-stage reveal reveal--late" aria-label="Orbit product preview">
          <div class="stage-halo" aria-hidden="true"></div>

          <article class="workspace-window">
            <header class="window-bar">
              <div class="window-title">
                <span class="window-orbit" aria-hidden="true"></span>
                <span>Morning orbit</span>
              </div>
              <div class="window-meta">
                <span>Friday · 09:42</span>
                <Avatar data-showcase-component size="sm" role="img" aria-label="Samuel Hulla">
                  <AvatarFallback data-showcase-component>SH</AvatarFallback>
                </Avatar>
              </div>
            </header>

            <div class="workspace-body">
              <div class="workspace-rail">
                <Sidebar data-showcase-component class="w-full">
                  <SidebarContent data-showcase-component aria-label="Preview navigation">
                    <SidebarGroup data-showcase-component
                      ><SidebarGroupLabel data-showcase-component>Space</SidebarGroupLabel
                      ><SidebarMenu data-showcase-component
                        ><SidebarMenuItem data-showcase-component
                          ><SidebarMenuLink
                            data-showcase-component
                            href="#system"
                            aria-current="page"
                            ><span>Briefing</span><Kbd data-showcase-component>1</Kbd
                            ></SidebarMenuLink
                          ></SidebarMenuItem
                        >
                        <SidebarMenuItem data-showcase-component
                          ><SidebarMenuLink data-showcase-component href="#system"
                            ><span>Signals</span><Kbd data-showcase-component>2</Kbd
                            ></SidebarMenuLink
                          ></SidebarMenuItem
                        >
                        <SidebarMenuItem data-showcase-component
                          ><SidebarMenuLink data-showcase-component href="#system"
                            ><span>Outcomes</span><Kbd data-showcase-component>3</Kbd
                            ></SidebarMenuLink
                          ></SidebarMenuItem
                        ></SidebarMenu
                      ></SidebarGroup
                    >
                    <SidebarGroup data-showcase-component
                      ><SidebarGroupLabel data-showcase-component>Watching</SidebarGroupLabel
                      ><SidebarMenu data-showcase-component>
                        <SidebarMenuItem data-showcase-component
                          ><SidebarMenuLink data-showcase-component href="#system"
                            ><span>Launch</span><Badge data-showcase-component size="sm">7</Badge
                            ></SidebarMenuLink
                          ></SidebarMenuItem
                        >
                        <SidebarMenuItem data-showcase-component
                          ><SidebarMenuLink data-showcase-component href="#system"
                            ><span>Atlas</span><Badge data-showcase-component size="sm">3</Badge
                            ></SidebarMenuLink
                          ></SidebarMenuItem
                        >
                      </SidebarMenu></SidebarGroup
                    >
                  </SidebarContent>
                </Sidebar>
              </div>

              <div class="briefing">
                <div class="briefing-head">
                  <div>
                    <p class="micro-label">Executive briefing / 014</p>
                    <h2>Good morning, Sam.</h2>
                  </div>
                  <Badge data-showcase-component variant="success" size="sm">Live</Badge>
                </div>

                <div class="signal-summary">
                  <div class="summary-ring" aria-hidden="true">
                    <span>87</span>
                    <small>clarity</small>
                  </div>
                  <div class="summary-copy">
                    <p>
                      The launch remains on track. One dependency needs a decision before 14:00.
                    </p>
                    <div class="summary-tags">
                      <Badge data-showcase-component size="sm">12 sources read</Badge><Badge
                        data-showcase-component
                        size="sm">3 changes</Badge
                      ><Badge data-showcase-component size="sm">1 decision</Badge>
                    </div>
                  </div>
                </div>

                <div class="priority-card">
                  <Alert data-showcase-component variant="warning">
                    <AlertTitle data-showcase-component>Confirm the migration window</AlertTitle>
                    <AlertDescription data-showcase-component
                      >Platform and Support are aligned. Customer Success needs final timing.</AlertDescription
                    >
                    <div class="mt-3">
                      <Button
                        data-showcase-component
                        variant="outline"
                        size="sm"
                        aria-label="Open decision"
                        data-open-decision>Open decision ↗</Button
                      >
                    </div>
                  </Alert>
                </div>

                <div class="activity-list">
                  <div class="activity-heading">
                    <span>Since yesterday</span><span>3 material changes</span>
                  </div>
                  {
                    activity.map((item) => (
                      <div class="activity-row">
                        <span class={`activity-state activity-state--${item.tone}`} />
                        <strong>{item.label}</strong>
                        <span>{item.meta}</span>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>

            <footer class="command-dock">
              <InputGroup data-showcase-component>
                <Input
                  data-showcase-component
                  aria-label="Ask Orbit"
                  placeholder="Ask Orbit about your workspace…"
                />
                <InputAdornment data-showcase-component
                  ><Kbd data-showcase-component>⌘ K</Kbd></InputAdornment
                >
                <Button data-showcase-component variant="outline" size="sm">Run ↗</Button>
              </InputGroup>
            </footer>
          </article>

          <aside class="floating-note glass-panel">
            <p class="micro-label">Signal detected</p>
            <strong>Launch confidence rose 8%</strong>
            <div><span></span><small>Updated 2m ago</small></div>
          </aside>

          <aside class="floating-command glass-panel">
            <span class="command-symbol" aria-hidden="true">⌘</span>
            <div>
              <small>Quick command</small>
              <strong>Prepare the Monday brief</strong>
            </div>
            <Kbd data-showcase-component>↵</Kbd>
          </aside>
        </div>
      </section>

      <section class="signal-strip" aria-label="Connected tools">
        <span>One operating picture from</span>
        {integrations.map((integration) => <strong>{integration}</strong>)}
        <span>and 40+ more</span>
      </section>

      <section class="system-section" id="system">
        <div class="section-intro">
          <p class="eyebrow"><span></span>The operating layer</p>
          <h2>Clarity without another dashboard.</h2>
          <p>
            Orbit reads the systems you already use, identifies what materially changed, and keeps
            the next decision within reach.
          </p>
        </div>

        <div class="system-grid">
          <article class="feature-card feature-card--signal">
            <div class="feature-copy">
              <span class="feature-index">01 / SIGNAL</span>
              <h3>See movement, not noise.</h3>
              <p>
                Hundreds of updates collapse into a short, prioritized view of what actually
                changed.
              </p>
            </div>
            <div class="signal-visual" aria-label="Signal volume chart">
              <div class="signal-axis"><span>08:00</span><span>Now</span></div>
              <div class="signal-bars" aria-hidden="true">
                <span style="--bar: 18%"></span><span style="--bar: 31%"></span>
                <span style="--bar: 24%"></span><span style="--bar: 42%"></span>
                <span style="--bar: 36%"></span><span style="--bar: 61%"></span>
                <span style="--bar: 48%"></span><span style="--bar: 72%"></span>
                <span style="--bar: 58%"></span><span style="--bar: 82%"></span>
                <span style="--bar: 69%"></span><span style="--bar: 92%"></span>
              </div>
              <div class="signal-callout glass-panel">
                <span></span>
                <div><small>Material change</small><strong>Migration risk resolved</strong></div>
                <em>+12</em>
              </div>
            </div>
          </article>

          <article class="feature-card feature-card--command glass-panel">
            <span class="feature-index">02 / COMMAND</span>
            <h3>Ask in plain language.</h3>
            <p>Every answer keeps a trace back to the people, projects, and source material.</p>
            <div class="mini-command">
              <span class="command-symbol" aria-hidden="true">⌘</span>
              <span>What is blocking launch?</span>
              <Kbd data-showcase-component>↵</Kbd>
            </div>
            <div class="answer-stack">
              <Skeleton data-showcase-component class="h-2 w-[92%]" /><Skeleton
                data-showcase-component
                class="h-2 w-[78%]"
              /><Skeleton data-showcase-component class="h-2 w-[56%]" />
            </div>
          </article>

          <article class="feature-card feature-card--focus">
            <span class="feature-index">03 / FOCUS</span>
            <div class="focus-orbit" aria-hidden="true">
              <span class="focus-core"></span>
              <i class="focus-node focus-node--one"></i>
              <i class="focus-node focus-node--two"></i>
              <i class="focus-node focus-node--three"></i>
            </div>
            <h3>Keep attention where it compounds.</h3>
            <p>Orbit learns which signals matter to each role and quiets everything else.</p>
          </article>

          <article class="feature-card feature-card--automation">
            <div class="feature-copy">
              <span class="feature-index">04 / AUTOMATION</span>
              <h3>Move from insight to action.</h3>
              <p>
                Turn a decision into an owned task, a written update, or a recurring operating
                rhythm.
              </p>
            </div>
            <div class="automation-flow">
              <div><span>01</span><strong>Signal arrives</strong><small>Linear + Slack</small></div>
              <i></i>
              <div><span>02</span><strong>Orbit assesses</strong><small>Confidence 94%</small></div>
              <i></i>
              <div class="automation-active">
                <span>03</span><strong>Owner notified</strong><small>Done in 4 sec</small>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="method-section" id="method">
        <div class="method-heading">
          <p class="eyebrow"><span></span>Designed for composure</p>
          <h2>Less ceremony.<br />Better decisions.</h2>
        </div>

        <ol class="method-list">
          <li>
            <span>01</span>
            <div>
              <strong>Connect</strong><p>Bring your existing tools. No migration project.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div><strong>Calibrate</strong><p>Tell Orbit what outcomes and risks matter.</p></div>
          </li>
          <li>
            <span>03</span>
            <div><strong>Operate</strong><p>Begin every day with an aligned picture.</p></div>
          </li>
        </ol>
      </section>

      <section class="story-section glass-panel" id="stories">
        <div class="story-mark" aria-hidden="true">“</div>
        <blockquote>
          Orbit replaced a ritual of status chasing with ten calm minutes each morning. We now spend
          that energy deciding, not reconstructing.
        </blockquote>
        <div class="story-person">
          <Avatar data-showcase-component size="lg" role="img" aria-label="Ana Rios">
            <AvatarFallback data-showcase-component>AR</AvatarFallback>
          </Avatar>
          <div><strong>Ana Rios</strong><small>VP Operations · Northline</small></div>
        </div>
        <div class="story-stat">
          <strong>31%</strong><span>fewer recurring status meetings</span>
        </div>
      </section>

      <section class="closing-section" id="start">
        <div class="closing-glow" aria-hidden="true"></div>
        <p class="eyebrow"><span></span>Your next briefing is ready</p>
        <h2>Put the work back in motion.</h2>
        <p>Connect a workspace and see your first operating brief in under two minutes.</p>
        <div class="hero-actions">
          <a class="action action--primary" href="/showcase">
            Start with Orbit <span aria-hidden="true">↗</span>
          </a>
          <a class="action action--quiet" href="mailto:hello@example.com">Talk to a human</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="wordmark" href="/showcase">
        <span class="orbit-mark" aria-hidden="true"><span></span></span>
        <span>ORBIT</span>
      </a>
      <p>A fictional product made to pressure-test the Hulla default theme.</p>
      <div><a href="/">Component catalog</a><a href="#main">Back to top ↑</a></div>
    </footer>

    <Dialog
      data-showcase-component
      id="decision-dialog"
      hidden
      aria-labelledby="decision-title"
      aria-describedby="decision-description"
    >
      <DialogHeader data-showcase-component>
        <p class="micro-label">Decision / Migration window</p>
        <DialogTitle data-showcase-component id="decision-title"
          >Confirm the migration window</DialogTitle
        >
        <DialogDescription data-showcase-component id="decision-description">
          Platform and Support are ready for the proposed window. Confirming now will notify
          Customer Success and schedule the operational checklist.
        </DialogDescription>
      </DialogHeader>

      <div class="grid gap-3 rounded-md bg-foreground/5 p-4 text-sm">
        <div class="flex items-center justify-between gap-4">
          <span class="text-muted-foreground">Window</span>
          <strong>Sunday · 02:00–04:00 UTC</strong>
        </div>
        <div class="flex items-center justify-between gap-4">
          <span class="text-muted-foreground">Expected impact</span>
          <strong>12 minutes read-only</strong>
        </div>
      </div>

      <DialogFooter data-showcase-component>
        <Button data-showcase-component variant="outline" data-close-decision>Not yet</Button>
        <Button data-showcase-component variant="secondary" data-open-impact>Review impact</Button>
        <Button data-showcase-component data-confirm-decision>Confirm window</Button>
      </DialogFooter>
    </Dialog>

    <Dialog
      data-showcase-component
      id="impact-dialog"
      contentClass="max-w-md"
      hidden
      aria-labelledby="impact-title"
      aria-describedby="impact-description"
    >
      <DialogHeader data-showcase-component>
        <p class="micro-label">Nested layer / Impact</p>
        <DialogTitle data-showcase-component id="impact-title"
          >Twelve minutes, read-only.</DialogTitle
        >
        <DialogDescription data-showcase-component id="impact-description">
          Active sessions remain connected. Writes queue automatically and resume when the migration
          completes.
        </DialogDescription>
      </DialogHeader>

      <DialogFooter data-showcase-component>
        <Button data-showcase-component autofocus data-close-impact>Back to decision</Button>
      </DialogFooter>
    </Dialog>

    <script>
      import { onDialogDismiss } from "@/ui/lib/dialog"

      const toggle = document.querySelector<HTMLInputElement>("#theme-toggle")
      const decisionDialog = document.querySelector<HTMLElement>("#decision-dialog")
      const impactDialog = document.querySelector<HTMLElement>("#impact-dialog")

      const hideDecision = () => {
        if (decisionDialog) decisionDialog.hidden = true
      }

      const hideImpact = () => {
        if (impactDialog) impactDialog.hidden = true
      }

      document.querySelector("[data-open-decision]")?.addEventListener("click", () => {
        if (decisionDialog) decisionDialog.hidden = false
      })
      document.querySelector("[data-close-decision]")?.addEventListener("click", hideDecision)
      document.querySelector("[data-confirm-decision]")?.addEventListener("click", hideDecision)
      document.querySelector("[data-open-impact]")?.addEventListener("click", () => {
        if (impactDialog) impactDialog.hidden = false
      })
      document.querySelector("[data-close-impact]")?.addEventListener("click", hideImpact)

      if (decisionDialog) onDialogDismiss(decisionDialog, hideDecision)
      if (impactDialog) onDialogDismiss(impactDialog, hideImpact)

      const syncToggle = () => {
        if (toggle) toggle.checked = document.documentElement.dataset.theme === "light"
      }

      syncToggle()

      toggle?.addEventListener("change", () => {
        const theme = toggle.checked ? "light" : "dark"
        document.documentElement.dataset.theme = theme
        try {
          localStorage.setItem("hulla-showcase-theme", theme)
        } catch {}
      })
    </script>
  </body>
</html>
