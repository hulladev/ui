{
  "name": "ui",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@hulla/catalog",
    "dev:catalog": "turbo run dev --filter=@hulla/catalog",
    "dev:catalog-only": "bun run --cwd apps/catalog dev",
    "dev:generator": "bun run --cwd packages/components dev",
    "generate": "bun run --cwd packages/components generate",
    "generate:check": "bun run --cwd packages/components generate:check",
    "check-generated": "bun run --cwd packages/components check-generated",
    "lint": "turbo run lint",
    "fmt": "prettier --write . --ignore-unknown",
    "fmt:check": "prettier --check . --ignore-unknown",
    "check-types": "turbo run check-types",
    "test": "turbo run test --log-order=stream",
    "test:consumers:prepare": "bun scripts/consumer-sandbox.ts",
    "test:consumers": "bun run test:consumers:prepare && bunx playwright test --config playwright.consumer.config.ts",
    "verify": "bun run fmt:check && bun run lint && bun run --cwd packages/ui check-types && bun run test && bun run generate:check && bun run check-generated",
    "changeset": "changeset",
    "version-packages": "bun run version:packages",
    "release": "node scripts/release.mjs publish",
    "prepare": "husky",
    "dev:native": "turbo run dev --filter=@hulla/native-catalog",
    "dev:native:ios": "turbo run dev --filter=@hulla/native-catalog -- --ios",
    "dev:native:android": "turbo run dev --filter=@hulla/native-catalog -- --android",
    "test:browser": "bun run --cwd apps/catalog test:browser",
    "test:browser:smoke": "bun run --cwd apps/catalog test:browser:smoke",
    "test:browser:compat": "bun run --cwd apps/catalog test:browser:compat",
    "verify:full": "bun run verify && bun run check-types && bun run build && bun run test:browser",
    "version:packages": "changeset version && node scripts/release.mjs prepare && bun install --lockfile-only --ignore-scripts && prettier --write .changeset/release-plan.json packages/ui/package.json",
    "test:release": "node --test scripts/release-checks.mjs",
    "release:check": "bun run verify && bun run --cwd packages/ui build && bun run test:release",
    "release:pack": "node scripts/release.mjs pack",
    "release:publish": "node scripts/release.mjs publish",
    "release:verify": "node scripts/release.mjs verify"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^19.8.1",
    "@floating-ui/dom": "catalog:",
    "@hulla/ui": "workspace:*",
    "@playwright/test": "^1.62.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tanstack/highlight": "^0.0.9",
    "@types/node": "^24.8.1",
    "commitizen": "^4.3.1",
    "cz-emoji": "1.3.2-canary.2",
    "hulla": "^0.0.0-alpha.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.4.0",
    "shiki": "^4.3.1",
    "turbo": "^2.5.6",
    "typescript": "5.9.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "@types/react": "^19.3.0"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-emoji"
    },
    "cz-emoji": {
      "skipScope": true,
      "types": [
        {
          "emoji": "✅",
          "code": ":white_check_mark: feat:",
          "description": "a new functionality",
          "name": "feat"
        },
        {
          "emoji": "🐞",
          "code": ":lady_beetle: fix:",
          "description": "a bug fix",
          "name": "fix"
        },
        {
          "emoji": "🔧",
          "code": ":wrench: update:",
          "description": "a code change that neither fixes a bug nor adds a feature",
          "name": "update"
        },
        {
          "emoji": "📚",
          "code": ":books: docs:",
          "description": "documentations",
          "name": "docs"
        },
        {
          "emoji": "🧪",
          "code": ":test_tube: tests:",
          "description": "tests",
          "name": "tests"
        },
        {
          "emoji": "🪛",
          "code": ":screwdriver: config:",
          "description": "configuration files",
          "name": "config"
        },
        {
          "emoji": "🤖",
          "code": ":robot: devops:",
          "description": "ci/cd or other form of automation",
          "name": "devops"
        },
        {
          "emoji": "♻️",
          "code": ":recycle: cleanup:",
          "description": "code cleanup",
          "name": "cleanup"
        },
        {
          "emoji": "📦",
          "code": ":package: release:",
          "description": "new release bundle",
          "name": "release"
        }
      ]
    }
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@floating-ui/dom": "^1.7.6",
      "@hulla/style": "1.0.1",
      "cn": "0.3.0"
    }
  }
}
