{
  "name": "@hulla/ui",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "build": "tsdown --config tsdown.config.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.8.1",
    "tsdown": "^0.15.10",
    "type-fest": "^5.2.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "uigen": "./dist/bin/uigen.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./bin/uigen": {
      "import": "./dist/bin/uigen.mjs",
      "require": "./dist/bin/uigen.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@hulla/args": "^0.0.2",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.2"
  }
}
