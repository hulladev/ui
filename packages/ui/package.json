{
  "name": "@hulla/ui",
  "version": "0.0.1",
  "description": "Deterministic multi-framework source component library generator",
  "keywords": [
    "component-registry",
    "source-components",
    "ui",
    "code-generator"
  ],
  "homepage": "https://hulla.dev/docs/ui",
  "bugs": "https://github.com/hulladev/ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/ui.git",
    "directory": "packages/ui"
  },
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "build": "tsdown --config tsdown.config.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "1.3.9",
    "@types/node": "^24.8.1",
    "eslint": "^9.39.3",
    "tsdown": "^0.15.10",
    "typescript": "5.9.2"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "uigen": "./dist/bin/uigen.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./bin/uigen": {
      "import": "./dist/bin/uigen.mjs",
      "require": "./dist/bin/uigen.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.4.0",
    "type-fest": "^5.2.0",
    "typescript": "^5.9.2"
  }
}
