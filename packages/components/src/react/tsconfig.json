{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": ["../../tsconfig.json", "@repo/typescript-config/react.json"],
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "incremental": true,
        "rootDir": "..",
        "baseUrl": "..",
        "paths": {
            "@/*": ["./*"],
            "@shared/*": ["shared/*"]
        }
    },
    "include": [
        "./**/*",
        "../styles/**/*",
        "../hulla/**/*",
        "../+css/**/*",
        "../style.ts"
    ]
}