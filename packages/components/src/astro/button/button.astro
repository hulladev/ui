---
import { buttonCss, className as base } from "@/+css/button.css"
import { cn } from "@/lib/style"
import type { HTMLAttributes } from "astro/types"
import { resolve } from "@hulla/ui"

const $variant = resolve(buttonCss)
const $base = resolve(base)

type Props = HTMLAttributes<'button'> & { variant: typeof $variant.infer }
const { class: className, variant, ...props } = Astro.props as Props
---

<button {...props} class={cn($base, $variant(variant), className)}><slot /></button>


