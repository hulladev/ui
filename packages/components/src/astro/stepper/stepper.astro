---
import { cn } from "@/lib/style"
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"ol"> & { orientation?: "horizontal" | "vertical" }
const { class: className, orientation = "horizontal", ...props } = Astro.props as Props
---

<ol
  {...props}
  data-orientation={orientation}
  role="list"
  data-slot="stepper"
  class={cn(
    "group/stepper m-0 flex w-full min-w-0 list-none gap-5 p-0 data-[orientation=vertical]:flex-col data-[orientation=vertical]:gap-4",
    className
  )}
>
  <slot />
</ol>
