---
import Backdrop from "../backdrop/backdrop.astro"
import { dialogOverlayVariants, dialogVariants } from "@/+css/dialog.css"
import { cn } from "@/lib/style"
import type { HTMLAttributes } from "astro/types"
import { resolve } from "@hulla/ui"

const $overlayVariant = resolve(dialogOverlayVariants)
const $variant = resolve(dialogVariants)

type Props = HTMLAttributes<"div"> & {
  contentClass?: string
  contentStyle?: HTMLAttributes<"div">["style"]
  dismissible?: boolean
  variant?: typeof $variant.infer
}

const {
  "aria-modal": ariaModal = true,
  class: className,
  contentClass,
  contentStyle,
  dismissible = true,
  hidden = false,
  role = "dialog",
  style,
  tabindex = -1,
  variant = "compact",
  ...props
} = Astro.props as Props
---

<hulla-dialog
  {...props}
  hidden={hidden}
  aria-modal={ariaModal}
  data-dismissible={dismissible}
  data-slot="dialog-overlay"
  data-state={hidden ? "closed" : "open"}
  data-variant={variant}
  role={role}
  tabindex={tabindex}
  class={cn(
    "fixed inset-0 z-[calc(var(--hulla-layer-base,1000)+var(--hulla-layer-order,0))] grid max-h-dvh place-items-center overflow-y-auto overscroll-contain focus:outline-none transition-[display] duration-160 [transition-behavior:allow-discrete] motion-reduce:transition-none [&[hidden]]:hidden [&[hidden]]:pointer-events-none [&[hidden]>[data-slot=backdrop]]:opacity-0 [&[hidden]>[data-slot=dialog]]:opacity-0",
    $overlayVariant(variant),
    className
  )}
  style={style}
>
  <Backdrop />
  <div
    data-slot="dialog"
    data-variant={variant}
    tabindex="-1"
    class={cn(
      "group/dialog relative my-auto w-full overflow-hidden bg-surface-raised text-foreground focus:outline-none transition-[opacity,transform] duration-160 ease-out starting:opacity-0 motion-reduce:transition-none",
      $variant(variant),
      contentClass
    )}
    style={contentStyle}
  >
    <slot />
  </div>
</hulla-dialog>

<script>
  import { connectDialog, type DialogController } from "@/lib/dialog"

  const elementName = "hulla-dialog"

  if (!customElements.get(elementName)) {
    class HullaDialogElement extends HTMLElement {
      controller: DialogController | undefined

      connectedCallback() {
        this.controller ??= connectDialog(this)
      }

      disconnectedCallback() {
        this.controller?.destroy()
        this.controller = undefined
      }
    }

    customElements.define(elementName, HullaDialogElement)
  }
</script>
