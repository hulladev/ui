---
import { dialogOverlayVariants, dialogVariants } from "@/+css/dialog.css"
import { cn } from "@/lib/style"
import type { HTMLAttributes } from "astro/types"
import { resolve } from "@hulla/ui"

const $overlayVariant = resolve(dialogOverlayVariants)
const $variant = resolve(dialogVariants)

type Props = HTMLAttributes<"div"> & {
  dismissible?: boolean
  variant?: typeof $variant.infer
}

const {
  "aria-modal": ariaModal = true,
  class: className,
  dismissible = true,
  hidden = false,
  role = "dialog",
  style,
  tabindex = -1,
  variant = "compact",
  ...props
} = Astro.props as Props
---

<hulla-dialog
  {...props}
  hidden={hidden}
  aria-modal={ariaModal}
  data-dismissible={dismissible}
  data-slot="dialog-overlay"
  data-state={hidden ? "closed" : "open"}
  data-variant={variant}
  role={role}
  tabindex={tabindex}
  class={cn(
    "fixed inset-0 z-[calc(var(--hulla-layer-base,1000)+var(--hulla-layer-order,0))] grid max-h-dvh place-items-center overflow-y-auto overscroll-contain bg-foreground/40 backdrop-blur-[3px] focus:outline-none motion-reduce:backdrop-blur-none dark:bg-background/72 dark:backdrop-blur-[8px] [&[hidden]]:hidden",
    $overlayVariant(variant)
  )}
>
  <div
    data-slot="dialog"
    data-variant={variant}
    tabindex="-1"
    class={cn(
      "group/dialog relative my-auto w-full overflow-hidden bg-surface-raised text-foreground focus:outline-none",
      $variant(variant),
      className
    )}
    style={style}
  >
    <slot />
  </div>
</hulla-dialog>

<script>
  import { connectDialog, type DialogController } from "@/lib/dialog"

  const elementName = "hulla-dialog"

  if (!customElements.get(elementName)) {
    class HullaDialogElement extends HTMLElement {
      controller: DialogController | undefined

      connectedCallback() {
        this.controller ??= connectDialog(this)
      }

      disconnectedCallback() {
        this.controller?.destroy()
        this.controller = undefined
      }
    }

    customElements.define(elementName, HullaDialogElement)
  }
</script>
