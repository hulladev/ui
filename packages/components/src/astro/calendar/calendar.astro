---
import { calendarDay } from "@/+css/calendar.css"
import {
  createCalendarView,
  serializeCalendarValue,
  type CalendarDateRange,
  type CalendarDisabledDate,
  type CalendarValue,
} from "@/lib/calendar"
import { cn } from "@/lib/style"
import { resolve } from "@hulla/ui"
import type { HTMLAttributes } from "astro/types"

const $calendarDay = resolve(calendarDay)

type CalendarBaseProps = Omit<HTMLAttributes<"div">, "defaultValue"> & {
  defaultMonth?: string
  disabledDates?: readonly CalendarDisabledDate[]
  locale?: string
  max?: string
  min?: string
  month?: string
  today?: string
  weekStartsOn?: 0 | 1 | 2 | 3 | 4 | 5 | 6
}

type SingleCalendarProps = {
  defaultValue?: string | null
  selectionMode?: "single"
  value?: string | null
}

type RangeCalendarProps = {
  defaultValue?: CalendarDateRange | null
  selectionMode: "range"
  value?: CalendarDateRange | null
}

type Props = CalendarBaseProps & (SingleCalendarProps | RangeCalendarProps)

const {
  "aria-label": ariaLabel = "Calendar",
  class: className,
  defaultMonth,
  defaultValue,
  disabledDates,
  locale,
  max,
  min,
  month,
  selectionMode = "single",
  today,
  value,
  weekStartsOn,
  ...props
} = Astro.props as Props

const initialValue = (value ?? defaultValue ?? null) as CalendarValue
const view = createCalendarView({
  disabledDates,
  locale,
  max,
  min,
  month: month ?? defaultMonth,
  selectionMode,
  today,
  value: initialValue,
  weekStartsOn,
})
const selectedDate =
  typeof initialValue === "string" ? initialValue : (initialValue?.start ?? undefined)
const initialFocus =
  selectedDate ??
  (today?.slice(0, 7) === view.month ? today : undefined) ??
  view.days.find((day) => !day.disabled && !day.outside)?.date ??
  view.days.find((day) => !day.disabled)?.date
---

<hulla-calendar
  {...props}
  aria-label={ariaLabel}
  data-disabled-dates={disabledDates ? JSON.stringify(disabledDates) : undefined}
  data-initial-value={serializeCalendarValue(initialValue)}
  data-locale={locale}
  data-max={max}
  data-min={min}
  data-month={view.month}
  data-selection-mode={selectionMode}
  data-slot="calendar"
  data-today={today}
  data-week-starts-on={weekStartsOn}
  class={cn(
    "group/calendar block w-[18.5rem] min-w-[18.5rem] select-none rounded-lg bg-surface-raised p-3 text-sm text-foreground antialiased",
    className
  )}
>
  <div data-slot="calendar-header" class="mb-2 flex h-9 items-center justify-between gap-2">
    <button
      type="button"
      aria-label="Previous month"
      data-slot="calendar-previous"
      class="grid size-8 place-items-center rounded-md border border-transparent bg-transparent text-muted-foreground transition-[background-color,color,transform] duration-100 enabled:hover:bg-hover-surface enabled:hover:text-foreground enabled:active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-focus-ring disabled:cursor-not-allowed disabled:text-disabled-foreground motion-reduce:transition-none"
    >
      <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" class="size-4">
        <path
          d="m10 3-5 5 5 5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div
      data-slot="calendar-heading"
      aria-live="polite"
      class="min-w-0 flex-1 text-center text-[0.8125rem] font-semibold tracking-[-0.01em]"
    >
      {view.heading}
    </div>

    <button
      type="button"
      aria-label="Next month"
      data-slot="calendar-next"
      class="grid size-8 place-items-center rounded-md border border-transparent bg-transparent text-muted-foreground transition-[background-color,color,transform] duration-100 enabled:hover:bg-hover-surface enabled:hover:text-foreground enabled:active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-focus-ring disabled:cursor-not-allowed disabled:text-disabled-foreground motion-reduce:transition-none"
    >
      <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" class="size-4">
        <path
          d="m6 3 5 5-5 5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  <table
    role="grid"
    data-slot="calendar-grid"
    class="w-full table-fixed border-separate border-spacing-0"
  >
    <thead>
      <tr>
        {
          view.weekdays.map((weekday) => (
            <th
              scope="col"
              aria-label={weekday.longLabel}
              title={weekday.longLabel}
              data-slot="calendar-weekday"
              class="h-7 p-0 text-center text-xs font-medium tracking-[0.02em] text-muted-foreground uppercase"
            >
              {weekday.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        Array.from({ length: 6 }, (_, weekIndex) => (
          <tr>
            {view.days.slice(weekIndex * 7, weekIndex * 7 + 7).map((day) => (
              <td role="gridcell" class="p-0 text-center">
                <button
                  type="button"
                  aria-current={day.today ? "date" : undefined}
                  aria-label={day.date}
                  aria-selected={day.selected}
                  disabled={day.disabled}
                  tabindex={day.date === initialFocus && !day.disabled ? 0 : -1}
                  data-date={day.date}
                  data-in-range={day.inRange ? "true" : undefined}
                  data-outside={day.outside ? "true" : undefined}
                  data-range-end={day.rangeEnd ? "true" : undefined}
                  data-range-start={day.rangeStart ? "true" : undefined}
                  data-selected={day.selected ? "true" : undefined}
                  data-slot="calendar-day"
                  data-today={day.today ? "true" : undefined}
                  class={$calendarDay("default")}
                >
                  {day.day}
                </button>
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</hulla-calendar>

<script>
  import { connectCalendar, type CalendarController, type CalendarValue } from "@/lib/calendar"

  const elementName = "hulla-calendar"

  if (!customElements.get(elementName)) {
    class HullaCalendarElement extends HTMLElement {
      controller: CalendarController | undefined

      connectedCallback() {
        this.controller ??= connectCalendar(this)
      }

      disconnectedCallback() {
        this.controller?.destroy()
        this.controller = undefined
      }

      get value(): CalendarValue {
        return this.controller?.getValue() ?? null
      }

      set value(value: CalendarValue) {
        this.controller?.setValue(value)
      }

      get month(): string {
        return this.controller?.getMonth() ?? this.dataset.month ?? ""
      }

      set month(value: string) {
        this.controller?.setMonth(value)
      }

      refresh() {
        this.controller?.refresh()
      }
    }

    customElements.define(elementName, HullaCalendarElement)
  }
</script>
