---
import { cn } from "@/lib/style"
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"div">

const { class: className, hidden = true, role = "status", ...props } = Astro.props as Props
---

<div
  {...props}
  hidden={hidden}
  role={role}
  data-slot="command-empty"
  class={cn("px-4 py-10 text-center text-sm text-muted-foreground", className)}
>
  <slot />
</div>
