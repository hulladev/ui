{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["CI"],
  "globalPassThroughEnv": ["HULLA_CATALOG_VITE_CACHE_DIR"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@hulla/catalog#dev": {
      "cache": false,
      "persistent": true,
      "with": ["components#dev"]
    }
  }
}
