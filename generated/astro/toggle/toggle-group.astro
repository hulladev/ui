---
import { cn } from "@/lib/style"
import type { ToggleGroupType, ToggleGroupValue } from "@/lib/toggle"
import type { HTMLAttributes } from "astro/types"

type Props = Omit<HTMLAttributes<"div">, "defaultValue"> & {
  defaultValue?: ToggleGroupValue
  orientation?: "horizontal" | "vertical"
  required?: boolean
  type?: ToggleGroupType
  value?: ToggleGroupValue
}

const {
  class: className,
  defaultValue,
  orientation = "horizontal",
  required = false,
  role = "group",
  type = "single",
  value,
  ...props
} = Astro.props as Props
---

<div
  {...props}
  role={role}
  data-initial-value={JSON.stringify(value ?? defaultValue ?? (type === "multiple" ? [] : ""))}
  data-orientation={orientation}
  data-required={required}
  data-slot="toggle-group"
  data-type={type}
  class={cn(
    "isolate inline-flex w-fit items-stretch gap-1 data-[orientation=horizontal]:flex-row data-[orientation=vertical]:flex-col",
    className
  )}
>
  <slot />
</div>

<script>
  import { connectToggleGroup, type ToggleGroupController } from "@/lib/toggle"

  const controllers = new WeakMap<HTMLElement, ToggleGroupController>()

  const connectToggleGroups = () => {
    document.querySelectorAll<HTMLElement>("[data-slot='toggle-group']").forEach((root) => {
      if (!controllers.has(root)) controllers.set(root, connectToggleGroup(root))
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", connectToggleGroups, { once: true })
  } else {
    connectToggleGroups()
  }

  document.addEventListener("astro:page-load", connectToggleGroups)
</script>
