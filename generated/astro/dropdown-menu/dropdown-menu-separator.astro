---
import { cn } from "@/lib/style"
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"hr">

const { class: className, role = "separator", ...props } = Astro.props as Props
---

<hr
  {...props}
  role={role}
  data-slot="dropdown-menu-separator"
  class={cn("m-0 border-0 border-t border-border", className)}
/>
