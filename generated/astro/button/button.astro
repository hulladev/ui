---
import { cn } from "@/lib/style"
import { vn } from "@/lib/style"
import type { HTMLAttributes } from "astro/types"
import { resolve } from "@hulla/ui"

const $variant = vn({
  primary: "bg-blue-500",
  outlined: "bg-transparent border border-gray-300",
})

type Props = HTMLAttributes<'button'> & { variant: typeof $variant.infer }
const { class: className, variant, ...props } = Astro.props as Props
---

<button {...props} class={cn("p-4 rounded", $variant(variant), className)}></button>


