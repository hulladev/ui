---
import { cn } from "@/lib/style"
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"strong">
const { class: className, ...props } = Astro.props as Props
---

<strong
  {...props}
  data-slot="hover-card-title"
  class={cn("block text-base font-semibold", className)}
>
  <slot />
</strong>
