---
import { vn, cn } from "@/lib/style"
import type { HTMLAttributes } from "astro/types"

const $size = vn({
  sm: "size-6 text-[0.6875rem]",
  md: "size-8 text-sm",
  lg: "size-10 text-lg",
})

type Props = HTMLAttributes<"span"> & {
  size?: typeof $size.infer
}

const { class: className, size = "md", ...props } = Astro.props as Props
---

<span
  {...props}
  data-slot="avatar"
  data-size={size}
  class={cn(
    "relative inline-flex shrink-0 overflow-hidden rounded-full bg-foreground/5 text-muted-foreground ring-1 ring-border ring-inset",
    $size(size),
    className
  )}
>
  <slot />
</span>
